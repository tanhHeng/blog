  }

  // Footnotes close the body as endnotes: a hairline, a small-caps label, then the notes in a smaller
  // size. The label is the generated `h2`, kept out of the section numbering and the contents.
  :global(.footnotes) {
    margin-top: 3rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba($primary-blue, 0.28);
    color: $primary-blue;
    font-size: 0.86rem;
    line-height: 1.85;

    :global(h2) {
      display: block;
      margin: 0 0 0.5rem;
      padding: 0;
      border: 0;
      color: $light-blue;
      font-family: $font-family-heading;
      font-size: 0.78rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      counter-increment: none;

      &::before,
      &::after {
        content: none;
      }
    }

    :global(ol) {
      margin: 0;
      padding-left: 1.3rem;
    }

    :global(li::marker) {
      color: $light-blue;
      font-family: $font-family-heading;
    }

    :global(p) {
      margin: 0 0 0.3rem;
    }

    // The note a reader jumps to glows briefly, so it is easy to find among the others.
    :global(li:target) {
      animation: note-found 1.6s ease-out;
    }

    :global(.data-footnote-backref) {
