  // narrow screens a table wider than the column scrolls instead (see the 720px block).
  :global(table) {
    width: 100%;
    margin: 1.6rem 0 1.9rem;
    border-collapse: collapse;
    border-top: 1.5px solid $primary-blue;
    border-bottom: 1.5px solid $primary-blue;
    font-size: 0.92em;
    line-height: 1.6;
  }

  :global(th),
  :global(td) {
