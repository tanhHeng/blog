---
import Navbar from '../components/Navbar.astro';
import DynamicCircles from '../components/DynamicCircles.astro';
import MouseCircle from '../components/MouseCircle.astro';
import '../styles/global.scss';
import 'animate.css';

interface Props {
  activePage?: string;
  title?: string;
  description?: string;
  lang?: string;
  showFootnote?: boolean;
}

const {
  activePage,
  title,
  description,
  lang = 'en',
  showFootnote = true,
} = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {title && <title>{title}</title>}
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <DynamicCircles />
    <MouseCircle />
    <Navbar activePage={activePage} />
    <div class="page-content">
      <slot />
    </div>
    {showFootnote && <footer class="site-footnote" aria-label="Site footnote">
      <div class="footnote-rule" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <p class="footnote-kicker">TANH.MOE <span>/</span> PERSONAL BLOG</p>
      <p class="footnote-signature"><span>Life is Piano.</span><span>You are Pianist.</span></p>
      <nav class="footnote-links" aria-label="Footer links">
        <a class="link-underline" href="mailto:contact@tanh.moe">Contact</a>
        <a class="link-underline" href="https://github.com/tanhHeng/blog" target="_blank" rel="noreferrer">GitHub</a>
        <a class="link-underline" href="https://blog.arcadia.moe" target="_blank" rel="noreferrer">4rcadia</a>
      </nav>
      <p class="footnote-copyright">Articles: <a class="link-underline" href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="noreferrer">CC BY-NC-SA 4.0</a> <span>/</span> Code: <a class="link-underline" href="https://gnu.net.cn/licenses/gpl-3.0.html" target="_blank" rel="noreferrer">GPL-3.0</a></p>
    </footer>}
  </body>
</html>

<script is:inline>
  (() => {
    const footnote = document.querySelector('.site-footnote');
    if (!footnote) return;

    const updateFootnoteVisibility = () => {
      const revealOffset = 160;
      const atPageBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - revealOffset;
      footnote.classList.toggle('is-visible', atPageBottom);
    };

    window.addEventListener('scroll', updateFootnoteVisibility, { passive: true });
    window.addEventListener('resize', updateFootnoteVisibility);
    updateFootnoteVisibility();
  })();
</script>

<style lang="scss">
  @use '../styles/global.scss' as *;

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page-content {
    position: relative;
    z-index: 1;
    flex: 1 0 auto;
  }

  .site-footnote {
    position: sticky;
    bottom: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 15rem;
    padding: 3rem 1.5rem 2.5rem;
    border-top: 1px solid rgba($primary-blue, 0.45);
    background: rgba(#fff, 0.68);
    backdrop-filter: blur(16px);
    color: $light-blue;
    mask-image: linear-gradient(to bottom, transparent, #000 1.75rem, #000);
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms ease-out;

    &.is-visible {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .footnote-rule {
    display: flex;
    gap: 0.65rem;
    margin-bottom: 1.25rem;

    span {
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 50%;
      background: $ex-light-blue;

      &:nth-child(2) {
        background: $light-blue;
      }

      &:nth-child(3) {
        background: $primary-blue;
      }
    }
  }

  .footnote-kicker,
  .footnote-copyright {
    margin: 0;
    font-family: $font-family-heading;
    letter-spacing: 0.12em;
  }

  .footnote-kicker {
    color: $primary-blue;
    font-size: 0.82rem;

    span {
      color: $ex-light-blue;
      padding: 0 0.5rem;
    }
  }

  .footnote-signature {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 0 0.65rem;
    max-width: 100%;
    margin: 0.85rem 0 0.5rem;
    color: $primary-blue;
    font-family: $font-family-special;
    font-size: clamp(1.25rem, 4vw, 3.25rem);
    line-height: 1;
    white-space: nowrap;
  }

  .footnote-signature span {
    white-space: nowrap;
  }

  .footnote-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1rem;
    margin-bottom: 0.7rem;

    a {
      color: $primary-blue;
      font-family: $font-family-heading;
      font-size: 0.82rem;
      letter-spacing: 0.06em;
      transition: color 180ms ease-out;
    }
  }

  .footnote-copyright {
    font-size: 0.82rem;
    letter-spacing: 0.04em;

    span {
      color: $ex-light-blue;
      padding: 0 0.45rem;
    }

    a {
      color: inherit;
    }
  }

  @media (max-width: 900px) {
    .site-footnote {
      min-height: 12rem;
      padding: 2.5rem 1rem 2rem;
    }

    .footnote-signature {
      width: 100%;
      font-size: clamp(1.6rem, 11vw, 2.75rem);
      gap: 0 0.35rem;
    }

    .footnote-kicker,
    .footnote-copyright {
      font-size: 0.7rem;
    }
  }
</style>
