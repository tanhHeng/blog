---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import DynamicCircles from '../components/DynamicCircles.astro';
import GridMarks from '../components/GridMarks.astro';
import MouseCircle from '../components/MouseCircle.astro';
import PageTransitionVeil from '../components/PageTransitionVeil.astro';
import '../styles/global.scss';
import 'animate.css';
import { routeTransitions } from '../lib/pageTransitions';
import { friendLinks } from '../lib/friends';

interface Props {
  activePage?: string;
  title?: string;
  description?: string;
  lang?: string;
  showFootnote?: boolean;
}

const {
  activePage,
  title,
  description,
  lang = 'en',
  showFootnote = true,
} = Astro.props;
// Dynamic like in `ArticleLayout`: article modules import this layout, and `lib/articles` imports them.
const { articles } = await import('../lib/articles');
// `<` is escaped so a title can never close the JSON script early.
const transitionRoutes = JSON.stringify(routeTransitions(articles)).replaceAll('<', '\\u003c');
---

<html lang={lang} transition:name="root" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {title && <title>{title}</title>}
    {description && <meta name="description" content={description} />}
    <ClientRouter />
  </head>
  <body>
    <DynamicCircles />
    <GridMarks />
    <MouseCircle />
    <Navbar activePage={activePage} />
    <PageTransitionVeil />
    <script type="application/json" is:inline data-transition-routes set:html={transitionRoutes}></script>
    <div class="page-content">
      <slot />
    </div>
    {showFootnote && <div class="footnote-spacer" aria-hidden="true"></div>}
    {showFootnote && <footer class="site-footnote" aria-label="Site footnote">
      <div class="footnote-rule" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <p class="footnote-kicker">TANH.MOE <span>/</span> PERSONAL BLOG</p>
      <p class="footnote-signature"><span>Life is Piano.</span><span>You are Pianist.</span></p>
      <nav class="footnote-links" aria-label="Footer links">
        <a class="link-underline" href="mailto:contact@tanh.moe">Contact</a>
        <a class="link-underline" href="https://github.com/tanhHeng/blog" target="_blank" rel="noreferrer">GitHub</a>
        <a class="link-underline footnote-friend" href={friendLinks[0].url} target="_blank" rel="noreferrer" data-friend-rotator data-friends={JSON.stringify(friendLinks)}><span class="footnote-friend-name">{friendLinks[0].name}</span></a>
      </nav>
      <p class="footnote-copyright">Articles: <a class="link-underline" href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="noreferrer">CC BY-NC-SA 4.0</a> <span>/</span> Code: <a class="link-underline" href="https://gnu.net.cn/licenses/gpl-3.0.html" target="_blank" rel="noreferrer">GPL-3.0</a></p>
    </footer>}
  </body>
</html>

<script>
  import '../lib/transitionCoordinator';
  import '../scripts/friendRotator';
  import { onPageLoad } from '../lib/pageLifecycle';
  // The footnote is fixed to the viewport bottom; an in-flow spacer of the same height lets the reader scroll
  // past the content end. `--reveal` (0–1) drives the footnote's opacity over the last `fadeDistance` of scroll,
  // reaching 1 exactly at the page bottom. It is also capped by how far the reader has scrolled, so a page that
  // barely scrolls never shows the footnote over its content before any scrolling happens.
  onPageLoad((scope) => {
    const footnote = document.querySelector<HTMLElement>('.site-footnote');
    const spacer = document.querySelector<HTMLElement>('.footnote-spacer');
    if (!footnote || !spacer) return;
    let frame = 0;
    const update = () => {
      frame = 0;
      const height = footnote.offsetHeight;
      spacer.style.height = `${height}px`;
      const fadeDistance = height * 0.4;
      const remaining = document.documentElement.scrollHeight - (window.scrollY + window.innerHeight);
      const toBottom = 1 - remaining / fadeDistance;
      const scrolled = window.scrollY / fadeDistance;
      const reveal = Math.min(1, Math.max(0, Math.min(toBottom, scrolled)));
      footnote.style.setProperty('--reveal', reveal.toFixed(3));
      footnote.classList.toggle('is-visible', reveal > 0.6);
    };
    const request = () => {
      if (!frame) frame = scope.frame(update);
    };
    const resize = new ResizeObserver(request);
    resize.observe(footnote);
    resize.observe(document.body);
    scope.observe(resize);
    scope.listen(window, 'scroll', request, { passive: true });
    scope.listen(window, 'resize', request);
    update();
  });
</script>
<style lang="scss">
  @use '../styles/global.scss' as *;

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page-content {
    position: relative;
    z-index: 1;
    flex: 1 0 auto;
  }

  .footnote-spacer {
    flex: none;
    height: 15rem;
  }

  .site-footnote {
    --reveal: 0;
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    // Height follows the content; the spacer mirrors it, so this top padding is the gap below the page content.
    padding: 1.6rem 1.5rem 2.5rem;
    color: $light-blue;
    text-align: center;
    opacity: var(--reveal);
    pointer-events: none;

    &.is-visible {
      pointer-events: auto;
    }
  }

  .footnote-rule {
    display: flex;
    gap: 0.65rem;
    margin-bottom: 1.25rem;

    span {
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 50%;
      background: $ex-light-blue;

      &:nth-child(2) {
        background: $light-blue;
      }

      &:nth-child(3) {
        background: $primary-blue;
      }
    }
  }

  .footnote-kicker,
  .footnote-copyright {
    margin: 0;
    font-family: $font-family-heading;
    letter-spacing: 0.12em;
  }

  .footnote-kicker {
    color: $primary-blue;
    font-size: 0.82rem;

    span {
      color: $ex-light-blue;
      padding: 0 0.5rem;
    }
  }

  .footnote-signature {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 0 0.65rem;
    max-width: 100%;
    margin: 0.85rem 0 0.5rem;
    color: $primary-blue;
    font-family: $font-family-special;
    font-size: clamp(1.25rem, 4vw, 3.25rem);
    line-height: 1;
    white-space: nowrap;
  }

  .footnote-signature span {
    white-space: nowrap;
  }

  .footnote-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1rem;
    margin-bottom: 0.7rem;

    a {
      color: $primary-blue;
      font-family: $font-family-heading;
      font-size: 0.82rem;
      letter-spacing: 0.06em;
      transition: color 180ms ease-out;
    }

    // The rotator script pins `width` to the measured name width, so neighbours slide instead of jumping.
    .footnote-friend {
      display: inline-block;
      white-space: nowrap;
      transition: color 180ms ease-out, width 420ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .footnote-friend-name {
      display: inline-block;
    }
  }

  .footnote-copyright {
    font-size: 0.82rem;
    letter-spacing: 0.04em;

    span {
      color: $ex-light-blue;
      padding: 0 0.45rem;
    }

    a {
      color: inherit;
    }
  }

  @media (max-width: 900px) {
    .site-footnote {
      padding: 1.1rem 1rem 2rem;
    }

    .footnote-signature {
      width: 100%;
      font-size: clamp(1.6rem, 11vw, 2.75rem);
      gap: 0 0.35rem;
    }

    .footnote-kicker,
    .footnote-copyright {
      font-size: 0.7rem;
    }
  }
</style>
