---
import BaseLayout from '../layouts/BaseLayout.astro';
import { chapters, codex, prologue, tagline, title, world } from '../lib/novel';

type PanelId = 'prologue' | 'chapters' | 'codex' | 'world';

// Focus and hotspot coordinates are percentages of the video frame (`public/novel/meadow-poster.webp`).
// `zoom` is the desktop camera scale for the scene; narrow viewports soften it in the client script.
// Verse lines are excerpts of the novel in `src/novel/`. `hotspot.label` names the thing in the image and
// `hotspot.hover` replaces it on hover/focus; `reveal` replaces the scene `title` while its hotspot is hovered.
interface Scene {
  id: string;
  numeral: string;
  title: string;
  reveal?: string;
  lines: string[];
  source: string;
  focus: { x: number; y: number; zoom: number };
  hotspot: { label: string; hover: string };
  panel: PanelId;
}

const scenes: Scene[] = [
  {
    id: 'her',
    numeral: '01',
    title: '“她”',
    reveal: '菈芙洛特',
    lines: ['她在世界留下她的痕迹，', '给予世界她的爱。', '她在世界寻找她的痕迹，', '锚定她的命运。', '她在世界镌刻她的痕迹，', '以求解脱莫比乌斯之环。'],
    source: '序章',
    focus: { x: 41, y: 20, zoom: 1.35 },
    hotspot: { label: '“她”', hover: '菈芙洛特' },
    panel: 'prologue',
  },
  {
    id: 'chronicle',
    numeral: '02',
    title: chapters[0].volume,
    lines: ['诞生与消散的三十年，循环往复。', '当最后一颗星星闭上了眼，', '谁又还能窥见她命运的轨迹？', '是她自己。'],
    source: '序章',
    focus: { x: 15, y: 21, zoom: 1.3 },
    hotspot: { label: '跟随蝴蝶', hover: '翻开篇章' },
    panel: 'chapters',
  },
  {
    id: 'codex',
    numeral: '03',
    title: '图鉴',
    lines: ['菈芙洛特。', '音节在空气中漾开，', '如同星辰的低语。'],
    source: codex.title,
    focus: { x: 16, y: 64, zoom: 1.3 },
    hotspot: { label: '谐相之灯', hover: codex.title },
    panel: 'codex',
  },
  {
    id: 'world',
    numeral: '04',
    title: world.label,
    lines: ['“月明星稀”，', '满月时，星星总是最少、最暗的。', '月相达到高峰时，', '星相就达到低谷。'],
    source: world.title,
    focus: { x: 86, y: 66, zoom: 1.25 },
    hotspot: { label: '仰望夜相', hover: world.label },
    panel: 'world',
  },
];

// The outro gathers every hotspot in place, then closes the loop back to the opening mist from the pale
// butterfly drifting off the lower left, the one figure in the frame no scene has claimed.
const restartCue = { label: '回到最初', hover: '又一个30年', x: 29, y: 79, panel: undefined };

// World diagram: the draft's 60-year night-phase cycle, moon peaking at years 0/60 and stars at year 30.
const cycle = { left: 56, right: 524, middle: 96, amplitude: 52 };
const [moonPath, starPath] = [1, -1].map((sign) => Array.from({ length: 61 }, (_, year) => {
  const x = cycle.left + (year / 60) * (cycle.right - cycle.left);
  const y = cycle.middle - sign * cycle.amplitude * Math.cos((year / 60) * 2 * Math.PI);
  return `${year === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
}).join(' '));
---

<BaseLayout activePage="Novel" lang="zh-CN" title={`${title} | TANH.MOE`} description={tagline} showFootnote={false}>
  <div class="novel" data-novel>
    <div class="stage" aria-hidden="true">
      <div class="stage-camera" data-stage-camera>
        <div class="stage-drift" data-stage-drift>
          <video class="stage-video" data-stage-video poster="/novel/meadow-poster.webp" autoplay muted loop playsinline preload="auto">
            <source src="/novel/meadow.webm" type="video/webm" />
            <source src="/novel/meadow.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
      <div class="stage-shade"></div>
      <div class="stage-mist"></div>
    </div>

    <div class="hotspot-layer" data-hotspot-layer>
      <div class="stage-drift" data-stage-drift>
        {scenes.map((scene, index) => (
          <div class:list={['hotspot', { 'is-flipped': scene.focus.x > 70 }]} data-hotspot={index} data-x={scene.focus.x} data-y={scene.focus.y}>
            <button class="hotspot-trigger" type="button" data-open-panel={scene.panel} data-reveal-scene={scene.reveal ? index : undefined} aria-haspopup="dialog" aria-controls={`panel-${scene.panel}`} aria-label={`${scene.hotspot.label} · ${scene.hotspot.hover}`}>
              <span class="hotspot-ring" aria-hidden="true"></span>
              <span class="hotspot-label swap" aria-hidden="true">
                <span class="swap-default">{scene.hotspot.label}</span>
                <span class="swap-reveal">{scene.hotspot.hover}</span>
              </span>
            </button>
          </div>
        ))}
        <div class="hotspot" data-hotspot="outro" data-x={restartCue.x} data-y={restartCue.y}>
          <button class="hotspot-trigger" type="button" data-glide-to="0" aria-label={`${restartCue.label} · ${restartCue.hover}`}>
            <span class="hotspot-ring" aria-hidden="true"></span>
            <span class="hotspot-label swap" aria-hidden="true">
              <span class="swap-default">{restartCue.label}</span>
              <span class="swap-reveal">{restartCue.hover}</span>
            </span>
          </button>
        </div>
      </div>
    </div>

    <main class="novel-flow">
      <section class="scene scene-intro" data-scene="intro" aria-labelledby="novel-title">
        <div class="scene-frame">
          <div class="intro-copy">
            <p class="intro-kicker">Novel <span>/</span> {chapters[0].volume}</p>
            <h1 id="novel-title">{title}</h1>
            <p class="intro-tagline">{tagline}</p>
            <div class="intro-rule" aria-hidden="true"><span></span><span></span><span></span></div>
          </div>
          <div class="intro-cues">
            <a class="scroll-cue" href={`#scene-${scenes[0].id}`} data-glide-to="1">
              <span>Scroll to enter</span>
            </a>
            <span class="intro-cues-divider" aria-hidden="true">/</span>
            <button class="view-all" type="button" data-open-panel="index" data-view-all aria-haspopup="dialog" aria-controls="panel-index">View all</button>
          </div>
        </div>
      </section>

      {scenes.map((scene, index) => (
        <section class="scene scene-chapter" id={`scene-${scene.id}`} data-scene={index} data-focus-x={scene.focus.x} data-focus-y={scene.focus.y} data-focus-zoom={scene.focus.zoom} aria-labelledby={`scene-title-${scene.id}`}>
          <div class="scene-frame">
            <div class="verse">
              <h2 class="verse-heading" id={`scene-title-${scene.id}`}>
                <span class="verse-numeral">{scene.numeral}</span>
                <span class="verse-title swap">
                  <span class="swap-default">{scene.title}</span>
                  {scene.reveal && <span class="swap-reveal" aria-hidden="true">{scene.reveal}</span>}
                </span>
              </h2>
              <p class="verse-lines">
                {scene.lines.map((line, lineIndex) => (
                  <span class="verse-line" style={`--line: ${lineIndex}`}>{line}</span>
                ))}
              </p>
              <p class="verse-source" style={`--line: ${scene.lines.length}`}>({scene.source})</p>
            </div>
          </div>
        </section>
      ))}

      <section class="scene scene-outro" data-scene="outro" aria-labelledby="outro-title">
        <div class="scene-frame">
          <div class="outro-copy">
            <p class="outro-kicker">To be continued</p>
            <h2 id="outro-title">未完待续</h2>
            <p class="outro-signature">Life is Piano.</p>
            <div class="outro-cues">
              {[...scenes.map((scene) => ({ ...scene.hotspot, panel: scene.panel })), restartCue].map((cue) => (
                <button class="hotspot-trigger" type="button" data-open-panel={cue.panel} data-glide-to={cue.panel ? undefined : 0} aria-haspopup={cue.panel ? 'dialog' : undefined} aria-controls={cue.panel ? `panel-${cue.panel}` : undefined} aria-label={`${cue.label} · ${cue.hover}`}>
                  <span class="hotspot-ring" aria-hidden="true"></span>
                  <span class="hotspot-label swap" aria-hidden="true">
                    <span class="swap-default">{cue.label}</span>
                    <span class="swap-reveal">{cue.hover}</span>
                  </span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>

    <nav class="chapter-rail" aria-label="章节">
      <ol>
        {scenes.map((scene, index) => (
          <li>
            <a href={`#scene-${scene.id}`} data-rail-link={index} data-glide-to={index + 1}>
              <span class="rail-numeral">{scene.numeral}</span>
              <span class="rail-title">{scene.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false">
      <span class="motion-icon" aria-hidden="true"></span>
      <span class="motion-label">Pause</span>
    </button>

    <!-- View all: a blank sheet that only points to the contents, which open beside it (wide) or above it,
    already unfolded (narrow). -->
    <dialog class="novel-panel" id="panel-index" aria-labelledby="panel-index-title">
      <header class="panel-header">
        <p class="panel-kicker">00 <span>/</span> Contents</p>
        <h2 class="panel-title" id="panel-index-title">{title}</h2>
        <button class="panel-close" type="button" data-panel-close aria-label="关闭"></button>
      </header>
      <div class="panel-body index-body" data-panel-body>
        <div class="index-prompt">
          <p class="index-prompt-kicker">Select to begin</p>
          <p class="index-prompt-text" data-layout="wide">从左侧目录选择篇章，开始阅读。</p>
          <p class="index-prompt-text" data-layout="narrow">从上方目录选择篇章，开始阅读。</p>
        </div>
      </div>
    </dialog>

    <dialog class="novel-panel" id="panel-prologue" aria-labelledby="panel-prologue-title">
      <header class="panel-header">
        <p class="panel-kicker">01 <span>/</span> Prologue</p>
        <h2 class="panel-title" id="panel-prologue-title">{prologue.title}</h2>
        <button class="panel-close" type="button" data-panel-close aria-label="关闭"></button>
      </header>
      <div class="panel-body" data-panel-body>
        <p class="panel-epigraph">{tagline}</p>
        <div class="prose prologue-prose" set:html={prologue.html} />
        <button class="panel-next" type="button" data-open-panel="chapters">继续阅读 · {chapters[0].volume}</button>
      </div>
    </dialog>

    <dialog class="novel-panel" id="panel-chapters" aria-labelledby="panel-chapters-title">
      <header class="panel-header">
        <p class="panel-kicker">02 <span>/</span> Chapters</p>
        <h2 class="panel-title" id="panel-chapters-title">{chapters[0].volume}</h2>
        <button class="panel-close" type="button" data-panel-close aria-label="关闭"></button>
      </header>
      <div class="panel-body" data-panel-body>
        {chapters.map((chapter, index) => (
          <article class="chapter-reader" data-chapter={chapter.id} aria-labelledby={`${chapter.id}-title`} hidden={index > 0}>
            <header class="reader-header">
              <p class="reader-number">{chapter.volume} · {chapter.number}</p>
              <h3 class="reader-title" id={`${chapter.id}-title`} tabindex="-1">{chapter.name}</h3>
            </header>
            <div class="prose" set:html={chapter.html} />
            {chapter.sections.map((section) => (
              <section class="reader-section">
                <h4 class="reader-section-title">{section.title}</h4>
                <div class="prose" set:html={section.html} />
              </section>
            ))}
            <nav class="reader-pager" aria-label="章节翻页">
              {index > 0 ? (
                <button type="button" data-chapter-open={chapters[index - 1].id}>
                  <span>Previous</span>{chapters[index - 1].name}
                </button>
              ) : (
                <button type="button" data-open-panel="prologue">
                  <span>Previous</span>{prologue.title}
                </button>
              )}
              {index < chapters.length - 1 ? (
                <button type="button" data-chapter-open={chapters[index + 1].id}>
                  <span>Next</span>{chapters[index + 1].name}
                </button>
              ) : (
                <button type="button" data-panel-close>
                  <span>Fin.</span>未完待续 · 合上书页
                </button>
              )}
            </nav>
          </article>
        ))}
      </div>
      <!-- The book's contents, shared by every panel: the script moves this one node into whichever panel
      opens. Top level mirrors the panels; the volume's chapters sit beneath it. The 目录 toggle and its fold
      only act on narrow screens. -->
      <nav class="chapter-aside" data-contents aria-label="目录">
        <button class="contents-toggle" type="button" data-contents-toggle aria-expanded="false" aria-controls="novel-contents">目录</button>
        <div class="contents-fold" id="novel-contents">
          <ol>
            {[
              { panel: 'prologue', label: prologue.title },
              { panel: 'chapters', label: chapters[0].volume },
              { panel: 'codex', label: codex.title },
              { panel: 'world', label: world.label },
            ].map((entry) => (
              <li>
                <button type="button" data-open-panel={entry.panel} data-contents-panel={entry.panel}>
                  <span class="rail-title">{entry.label}</span>
                </button>
                {entry.panel === 'chapters' && (
                  <div class="chapter-aside-fold">
                    <ol class="chapter-aside-chapters">
                      {chapters.map((chapter, chapterIndex) => (
                        <li>
                          <button type="button" data-chapter-open={chapter.id} aria-current={chapterIndex === 0 ? 'true' : undefined}>
                            <span class="rail-numeral">{String(chapterIndex + 1).padStart(2, '0')}</span>
                            <span class="rail-title">{chapter.name}</span>
                          </button>
                        </li>
                      ))}
                    </ol>
                  </div>
                )}
              </li>
            ))}
          </ol>
        </div>
      </nav>
    </dialog>

    <dialog class="novel-panel" id="panel-codex" aria-labelledby="panel-codex-title">
      <header class="panel-header">
        <p class="panel-kicker">03 <span>/</span> Codex</p>
        <h2 class="panel-title" id="panel-codex-title">{codex.title}</h2>
        <button class="panel-close" type="button" data-panel-close aria-label="关闭"></button>
      </header>
      <div class="panel-body" data-panel-body>
        <div class="codex-note" set:html={codex.note} />
        <div class="codex-tabs" role="tablist" aria-label="人物">
          {codex.characters.map((character, index) => (
            <button class="codex-tab" type="button" role="tab" id={`${character.id}-tab`} aria-controls={character.id} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-codex-tab>
              <span class="codex-tab-latin">{character.latinName}</span>
              <span class="codex-tab-name">{character.name}</span>
            </button>
          ))}
        </div>
        {codex.characters.map((character, index) => (
          <section class="character-card" id={character.id} role="tabpanel" aria-labelledby={`${character.id}-tab`} hidden={index !== 0}>
            <header class="character-header">
              <p class="character-affinity">{character.affinity}</p>
              <h3 class="character-name">{character.name}</h3>
              {character.latinName && <p class="character-latin">{character.latinName}</p>}
              {character.epithet && <p class="character-epithet" set:html={character.epithet} />}
            </header>
            <dl class="character-fields">
              {character.fields.map((field) => (
                <div class:list={['character-field', { 'is-long': !field.short }]}>
                  <dt>{field.label}</dt>
                  <dd set:html={field.html} />
                </div>
              ))}
            </dl>
            {character.remarks.map((remark) => <blockquote class="character-remark" set:html={remark} />)}
          </section>
        ))}
      </div>
    </dialog>

    <dialog class="novel-panel" id="panel-world" aria-labelledby="panel-world-title">
      <header class="panel-header">
        <p class="panel-kicker">04 <span>/</span> {world.label}</p>
        <h2 class="panel-title" id="panel-world-title">{world.title}</h2>
        <button class="panel-close" type="button" data-panel-close aria-label="关闭"></button>
      </header>
      <div class="panel-body" data-panel-body>
        <figure class="cycle-figure">
          <svg class="cycle-chart" viewBox="0 0 580 200" role="img" aria-labelledby="cycle-caption">
            <line class="cycle-axis" x1={cycle.left} x2={cycle.right} y1={cycle.middle} y2={cycle.middle} />
            {[0, 30, 60].map((year) => {
              const x = cycle.left + (year / 60) * (cycle.right - cycle.left);
              return (
                <g class="cycle-tick">
                  <line x1={x} x2={x} y1={cycle.middle - cycle.amplitude - 10} y2={cycle.middle + cycle.amplitude + 10} />
                  <text x={x} y={cycle.middle + cycle.amplitude + 30}>{year} 年</text>
                </g>
              );
            })}
            <path class="cycle-moon" d={moonPath} />
            <path class="cycle-star" d={starPath} />
            <g class="cycle-label">
              <text x={cycle.left + 8} y={cycle.middle - cycle.amplitude - 16}>满月 · 星稀</text>
              <text x={(cycle.left + cycle.right) / 2} y={cycle.middle - cycle.amplitude - 16} text-anchor="middle">朔月 · 星盛</text>
            </g>
            <g class="cycle-legend">
              <line class="cycle-moon" x1={cycle.right - 112} x2={cycle.right - 88} y1="18" y2="18" />
              <text x={cycle.right - 82} y="22">月相</text>
              <line class="cycle-star" x1={cycle.right - 50} x2={cycle.right - 26} y1="18" y2="18" />
              <text x={cycle.right - 20} y="22">星相</text>
            </g>
          </svg>
          <figcaption id="cycle-caption">夜相周期：月相与星相各以 60 年为一周期，此消彼长。</figcaption>
        </figure>
        <div class="prose" set:html={world.html} />
      </div>
    </dialog>
  </div>
</BaseLayout>

<script>
  import { onPageLoad } from '../lib/pageLifecycle';

  onPageLoad((scope) => {
    const root = document.querySelector<HTMLElement>('[data-novel]');
    if (root) initializeNovel(root, scope);
  });

  function initializeNovel(root: HTMLElement, scope: import('../lib/pageLifecycle').PageScope) {
    const camera = root.querySelector<HTMLElement>('[data-stage-camera]')!;
    const drifts = Array.from(root.querySelectorAll<HTMLElement>('[data-stage-drift]'));
    const video = root.querySelector<HTMLVideoElement>('[data-stage-video]')!;
    const hotspotLayer = root.querySelector<HTMLElement>('[data-hotspot-layer]')!;
    const stage = camera.parentElement!;
    const hotspots = Array.from(root.querySelectorAll<HTMLElement>('[data-hotspot]'));
    const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-scene]'));
    const railLinks = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-rail-link]'));
    const motionToggle = root.querySelector<HTMLButtonElement>('[data-motion-toggle]')!;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = window.matchMedia('(max-width: 850px)');
    // Matches the encoded video frame; the camera is sized to cover the viewport at this ratio.
    const frameRatio = 2560 / 1450;

    let activeScene: HTMLElement | undefined;
    let frame = 0;

    // Places the frame so `focus` lands on the composition target, clamped so the frame always covers the viewport.
    const placeCamera = () => {
      // Measured from the fixed stage itself: it excludes the reserved scrollbar gutter and, unlike the root's
      // client height (the small viewport on mobile), grows when the browser toolbars collapse.
      const vw = stage.clientWidth;
      const vh = stage.clientHeight;
      const width = Math.max(vw, vh * frameRatio);
      const height = width / frameRatio;
      const chapter = activeScene?.dataset.focusX !== undefined ? activeScene : undefined;
      const fx = chapter ? Number(chapter.dataset.focusX) / 100 : 0.5;
      const fy = chapter ? Number(chapter.dataset.focusY) / 100 : 0.5;
      const zoom = chapter ? Number(chapter.dataset.focusZoom) : 1;
      const scale = narrow.matches ? 1 + (zoom - 1) * 0.5 : zoom;
      const targetX = chapter ? vw * (narrow.matches ? 0.5 : 0.64) : vw / 2;
      const targetY = chapter ? vh * (narrow.matches ? 0.36 : 0.5) : vh / 2;
      const x = Math.min(Math.max(targetX - fx * width * scale, vw - width * scale), 0);
      const y = Math.min(Math.max(targetY - fy * height * scale, vh - height * scale), 0);

      for (const layer of [camera, hotspotLayer]) {
        layer.style.width = `${width}px`;
        layer.style.height = `${height}px`;
        layer.style.setProperty('--camera-scale', String(scale));
        layer.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${scale})`;
      }

      // At the outro every hotspot returns to its place on the image. When the crop would cut one off
      // (portrait screens), the outro lists them under the closing text instead.
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
      const fits = hotspots.every((hotspot) => {
        const left = x + (Number(hotspot.dataset.x) / 100) * width * scale;
        const top = y + (Number(hotspot.dataset.y) / 100) * height * scale;
        // Labels run ~11rem from the ring; the ring itself needs ~2rem on its other side.
        const [before, after] = hotspot.classList.contains('is-flipped') ? [11 * rem, 2 * rem] : [2 * rem, 11 * rem];
        return left - before >= 0 && left + after <= vw && top >= 7 * rem && top <= vh - 4 * rem;
      });
      const index = activeScene?.dataset.scene ?? '';
      root.dataset.outroLayout = fits ? 'image' : 'list';
      hotspots.forEach((hotspot) => hotspot.classList.toggle('is-visible', index === 'outro' ? fits : hotspot.dataset.hotspot === index));
    };

    const setActiveScene = (scene: HTMLElement) => {
      if (scene === activeScene) return;
      activeScene?.classList.remove('is-active');
      activeScene = scene;
      scene.classList.add('is-active');
      const index = scene.dataset.scene ?? '';
      root.dataset.activeScene = index;
      // Hotspot visibility follows the camera, so `placeCamera` below owns it.
      railLinks.forEach((link) => {
        const current = link.dataset.railLink === index;
        link.classList.toggle('is-current', current);
        if (current) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      });
      placeCamera();
    };

    // The scene crossing the viewport's middle line owns the camera.
    const sceneObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) setActiveScene(entry.target as HTMLElement);
      }
    }, { rootMargin: '-50% 0px -50% 0px' });
    scenes.forEach((scene) => sceneObserver.observe(scene));
    scope.observe(sceneObserver);

    // `--intro` runs 0 → 1 across the first viewport of scroll and dissolves the white mist.
    const updateScroll = () => {
      frame = 0;
      const intro = Math.min(Math.max(window.scrollY / (window.innerHeight * 0.85), 0), 1);
      root.style.setProperty('--intro', intro.toFixed(3));
    };
    scope.listen(window, 'scroll', () => {
      if (!frame) frame = scope.frame(updateScroll);
    }, { passive: true });
    scope.listen(narrow, 'change', placeCamera);
    // Leaving the page hands the navbar back its default colours while the transition veil covers the scene,
    // so the bar already matches the next page.
    scope.listen(document, 'astro:before-preparation', () => root.classList.add('is-leaving'));

    // Scene navigation --------------------------------------------------------
    // Native snapping runs at a browser-fixed speed, so whole-scene moves are glided here instead:
    // one gesture moves exactly one scene, and input arriving mid-glide is absorbed.
    const stops = Array.from(root.querySelectorAll<HTMLElement>('.scene'));
    const glideDuration = 1600;
    let glideFrame = 0;
    let currentStop = 0;
    let lockedUntil = 0;
    let settleTimer = 0;

    const measureStops = () => {
      const max = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      return stops.map((stop) => Math.min(Math.round(stop.getBoundingClientRect().top + window.scrollY), max));
    };

    const nearestStop = () => {
      const tops = measureStops();
      return tops.reduce((best, top, index) => (Math.abs(top - window.scrollY) < Math.abs(tops[best] - window.scrollY) ? index : best), 0);
    };

    const goTo = (index: number) => {
      currentStop = Math.min(Math.max(index, 0), stops.length - 1);
      const from = window.scrollY;
      const to = measureStops()[currentStop];
      scope.cancelFrame(glideFrame);
      glideFrame = 0;
      if (reducedMotion.matches || Math.abs(to - from) < 1) {
        window.scrollTo({ top: to, behavior: 'instant' });
        return;
      }
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / glideDuration, 1);
        // easeInOutCubic: a slow lift-off and a long, soft landing.
        const eased = t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2;
        window.scrollTo({ top: from + (to - from) * eased, behavior: 'instant' });
        if (t < 1) {
          glideFrame = scope.frame(step);
        } else {
          glideFrame = 0;
          lockedUntil = Math.max(lockedUntil, now + 300);
        }
      };
      glideFrame = scope.frame(step);
    };

    const panelOpen = () => root.querySelector('.novel-panel[open]') !== null;

    // Trackpad inertia keeps firing after a glide; each absorbed event extends the lock until input goes quiet.
    scope.listen(window, 'wheel', (event) => {
      if (panelOpen() || event.ctrlKey) return;
      event.preventDefault();
      const now = performance.now();
      if (glideFrame || now < lockedUntil) {
        lockedUntil = Math.max(lockedUntil, now + 300);
        return;
      }
      if (Math.abs(event.deltaY) < 4) return;
      goTo(currentStop + Math.sign(event.deltaY));
    }, { passive: false });

    const keySteps: Record<string, number> = { ArrowDown: 1, PageDown: 1, ArrowUp: -1, PageUp: -1 };
    scope.listen(window, 'keydown', (event) => {
      if (panelOpen() || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) return;
      const onPage = event.target === document.body || event.target === document.documentElement;
      let next: number | undefined;
      if (event.key in keySteps) next = currentStop + keySteps[event.key];
      else if (event.key === ' ' && onPage) next = currentStop + (event.shiftKey ? -1 : 1);
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = stops.length - 1;
      if (next === undefined) return;
      event.preventDefault();
      if (!glideFrame) goTo(next);
    });

    let touchStartY: number | undefined;
    scope.listen(window, 'touchstart', (event) => {
      touchStartY = event.touches.length === 1 ? event.touches[0].clientY : undefined;
    }, { passive: true });
    scope.listen(window, 'touchmove', (event) => {
      if (!panelOpen() && event.touches.length === 1) event.preventDefault();
    }, { passive: false });
    scope.listen(window, 'touchend', (event) => {
      if (touchStartY === undefined || panelOpen() || glideFrame) return;
      const distance = touchStartY - event.changedTouches[0].clientY;
      touchStartY = undefined;
      if (Math.abs(distance) > 40) goTo(currentStop + Math.sign(distance));
    });

    // Invariant: outside a glide (and an open panel) the page rests exactly on a scene. Anything that leaves it
    // between scenes (scrollbar drags, find-in-page, focus moves, momentum or layout shifts carried over from the
    // previous page on mobile) is settled onto the nearest scene; resting on one just syncs `currentStop`.
    const settle = () => {
      if (glideFrame || panelOpen()) return;
      const tops = measureStops();
      const resting = tops.findIndex((top) => Math.abs(top - window.scrollY) < 1);
      if (resting >= 0) currentStop = resting;
      else goTo(nearestStop());
    };
    const requestSettle = (delay: number) => {
      scope.clearTimeout(settleTimer);
      settleTimer = scope.timeout(settle, delay);
    };

    scope.listen(window, 'scroll', () => {
      if (!glideFrame) requestSettle(180);
    }, { passive: true });

    // A viewport resize keeps the reader on the same scene rather than the nearest one, since every stop moves.
    scope.listen(window, 'resize', () => {
      placeCamera();
      if (!glideFrame) window.scrollTo({ top: measureStops()[currentStop], behavior: 'instant' });
    });

    // Layout changes that fire no scroll or resize (fonts, mobile toolbar unit changes) can also move the stops.
    const flowObserver = new ResizeObserver(() => requestSettle(180));
    flowObserver.observe(root);
    scope.observe(flowObserver);
    // Toolbar collapse resizes the fixed stage without always firing `resize`; keep the frame covering it.
    const stageObserver = new ResizeObserver(() => placeCamera());
    stageObserver.observe(stage);
    scope.observe(stageObserver);
    currentStop = nearestStop();
    requestSettle(0);

    // Pointer parallax moves inner layers so it never fights the camera transition; hotspots share it to stay pinned.
    let driftFrame = 0;
    scope.listen(window, 'pointermove', (event) => {
      if (event.pointerType !== 'mouse' || reducedMotion.matches || driftFrame) return;
      driftFrame = scope.frame(() => {
        driftFrame = 0;
        const dx = (event.clientX / window.innerWidth - 0.5) * -18;
        const dy = (event.clientY / window.innerHeight - 0.5) * -12;
        drifts.forEach((layer) => {
          layer.style.transform = `translate3d(${dx}px, ${dy}px, 0) scale(1.03)`;
        });
      });
    }, { passive: true });

    for (const hotspot of hotspots) {
      hotspot.style.left = `${hotspot.dataset.x}%`;
      hotspot.style.top = `${hotspot.dataset.y}%`;
    }

    // Hovering or focusing her hotspot also names her in the scene heading; hotspot labels swap via CSS.
    for (const trigger of root.querySelectorAll<HTMLElement>('[data-reveal-scene]')) {
      const scene = root.querySelector(`[data-scene="${trigger.dataset.revealScene}"]`);
      for (const [type, revealed] of [['pointerenter', true], ['pointerleave', false], ['focus', true], ['blur', false]] as const) {
        scope.listen(trigger, type, () => scene?.classList.toggle('is-revealed', revealed));
      }
    }

    // Panels ----------------------------------------------------------------

    const panels = Array.from(root.querySelectorAll<HTMLDialogElement>('.novel-panel'));

    // Plays the exit animation before `close()`, which would otherwise drop the sheet instantly.
    const closePanel = (panel: HTMLDialogElement) => {
      if (!panel.open || panel.classList.contains('is-closing')) return;
      if (reducedMotion.matches) {
        panel.close();
        return;
      }
      panel.classList.add('is-closing');
      scope.listen(panel, 'animationend', function finish(event) {
        if (event.target !== panel) return;
        panel.removeEventListener('animationend', finish);
        panel.close();
      });
    };

    const contents = root.querySelector<HTMLElement>('[data-contents]');
    const contentsToggle = contents?.querySelector<HTMLElement>('[data-contents-toggle]');
    // Narrow screens only (the toggle is hidden wider): the contents fold under a 目录 button and close again
    // once an entry is picked or the panel closes. There, an entry with nested entries (the volume) only
    // unfolds them (`aria-expanded`); only a leaf opens anything. Each time the contents open, the volume
    // starts unfolded exactly when its panel is the one showing, as on wide screens.
    const narrowContents = window.matchMedia('(max-width: 1099px)');
    const branches = Array.from(contents?.querySelectorAll<HTMLElement>('[data-contents-panel]') ?? []).filter((entry) =>
      entry.nextElementSibling?.classList.contains('chapter-aside-fold'),
    );
    const setContentsOpen = (open: boolean) => {
      if (open) branches.forEach((entry) => entry.setAttribute('aria-expanded', String(entry.hasAttribute('aria-current'))));
      contentsToggle?.setAttribute('aria-expanded', String(open));
    };

    const crossFade = { duration: 480, easing: 'linear' };
    const fadeOut: Keyframe[] = [{ opacity: 1, filter: 'blur(0)' }, { opacity: 0, filter: 'blur(6px)' }];
    const fadeIn: Keyframe[] = [{ opacity: 0, filter: 'blur(6px)' }, { opacity: 1, filter: 'blur(0)' }];

    // Copies of a panel's header and body pinned where they stand, so they can fade out over the next panel
    // after their own dialog closes (only one modal can be shown). Ids are stripped to keep them unique.
    const ghostsOf = (panel: HTMLDialogElement) => {
      const panelRect = panel.getBoundingClientRect();
      return Array.from(panel.querySelectorAll<HTMLElement>(':scope > .panel-header, :scope > [data-panel-body]')).map((part) => {
        const rect = part.getBoundingClientRect();
        const ghost = part.cloneNode(true) as HTMLElement;
        ghost.removeAttribute('data-panel-body');
        ghost.querySelectorAll('[id]').forEach((element) => element.removeAttribute('id'));
        ghost.querySelector('.panel-close')?.remove();
        Object.assign(ghost.style, {
          position: 'absolute',
          top: `${rect.top - panelRect.top}px`,
          left: `${rect.left - panelRect.left}px`,
          // The measured rect is the border box, scrollbar included, and the copy keeps the body's own
          // `overflow-y: auto` (its content is just as tall) so the scrollbar keeps its room. Otherwise the text
          // reflows wider and centred lines (the reader title) slide sideways.
          boxSizing: 'border-box',
          width: `${rect.width}px`,
          height: `${rect.height}px`,
          margin: '0',
          pointerEvents: 'none',
        });
        ghost.inert = true;
        ghost.setAttribute('aria-hidden', 'true');
        return { ghost, scrollTop: part.scrollTop };
      });
    };

    // Switching panels closes the current one and opens the next in place, without the slide, so only the
    // first sheet ever slides; the old header and body cross-fade into the new ones like a chapter turn (the
    // close button stays put). The contents list moves into whichever panel is open (modal dialogs make the
    // rest of the page inert, so it must live inside the open one).
    const openPanel = async (id: string) => {
      const panel = document.getElementById(`panel-${id}`);
      if (!(panel instanceof HTMLDialogElement)) return;
      const previous = panels.find((other) => other !== panel && other.open);
      // Measured before the contents list leaves it, which reflows a narrow sheet.
      const ghosts = previous && !reducedMotion.matches ? ghostsOf(previous) : [];
      if (contents) panel.append(contents);
      for (const other of panels) {
        if (other !== panel && other.open) other.close();
      }
      if (!panel.open) {
        panel.classList.toggle('is-switching', previous !== undefined);
        panel.showModal();
      }
      // Marked only after the list is laid out in the open panel, so the chapters' collapse transitions from
      // the previous state rather than starting at the new one.
      if (contents) {
        void contents.offsetHeight;
        contents.querySelectorAll<HTMLElement>('[data-contents-panel]').forEach((entry) => {
          if (entry.dataset.contentsPanel === id) entry.setAttribute('aria-current', 'true');
          else entry.removeAttribute('aria-current');
        });
      }
      if (ghosts.length === 0) return;
      // The arriving parts are picked before the ghosts go in: a ghost header is also a `.panel-header`, and
      // its children would otherwise fade in from nothing while the ghost fades out.
      const arriving = Array.from(panel.querySelectorAll<HTMLElement>(':scope > .panel-header > :not(.panel-close), :scope > [data-panel-body]'));
      const fades: Promise<unknown>[] = [];
      for (const { ghost, scrollTop } of ghosts) {
        panel.append(ghost);
        ghost.scrollTop = scrollTop;
        fades.push(ghost.animate(fadeOut, { ...crossFade, fill: 'forwards' }).finished);
      }
      for (const part of arriving) fades.push(part.animate(fadeIn, crossFade).finished);
      try {
        await Promise.all(fades);
      } catch {
        // Cancelled (the page is leaving); the ghosts are removed below either way.
      } finally {
        ghosts.forEach(({ ghost }) => ghost.remove());
      }
    };

    const swapChapter = (panel: HTMLDialogElement, id: string) => {
      const body = panel.querySelector<HTMLElement>('[data-panel-body]');
      if (!body) return;
      panel.querySelectorAll<HTMLElement>('[data-chapter]').forEach((reader) => {
        reader.hidden = reader.dataset.chapter !== id;
      });
      contents?.querySelectorAll<HTMLElement>('[data-chapter-open]').forEach((entry) => {
        if (entry.dataset.chapterOpen === id) entry.setAttribute('aria-current', 'true');
        else entry.removeAttribute('aria-current');
      });
      body.scrollTop = 0;
      panel.querySelector<HTMLElement>(`[data-chapter="${id}"] .reader-title`)?.focus();
    };

    // Chapter changes cross-fade the reading content only (linear blur and opacity, no movement); the sheet
    // header and the chapter list never animate. The leaving reader is lifted out of flow at the spot it was
    // showing, so it fades out over the arriving content while that fades in. Clicks while it runs are dropped.
    let chapterTurning = false;
    const showChapter = async (panel: HTMLDialogElement, id: string) => {
      const body = panel.querySelector<HTMLElement>('[data-panel-body]');
      const leaving = panel.querySelector<HTMLElement>('[data-chapter]:not([hidden])');
      if (chapterTurning || leaving?.dataset.chapter === id) return;
      if (reducedMotion.matches || !body || !leaving) {
        swapChapter(panel, id);
        return;
      }
      chapterTurning = true;
      const bodyRect = body.getBoundingClientRect();
      const leavingRect = leaving.getBoundingClientRect();
      // Lifted out of flow, the reader starts its own formatting context, so its first child's top margin no
      // longer collapses through it and the content would drop by that margin; the anchor's measured shift
      // corrects for it (and for anything else that moved).
      const anchor = leaving.firstElementChild ?? leaving;
      const anchorTop = anchor.getBoundingClientRect().top;
      swapChapter(panel, id);
      const top = leavingRect.top - bodyRect.top - body.clientTop;
      Object.assign(leaving.style, {
        position: 'absolute',
        top: `${top}px`,
        left: `${leavingRect.left - bodyRect.left - body.clientLeft}px`,
        width: `${leavingRect.width}px`,
        pointerEvents: 'none',
      });
      leaving.inert = true;
      leaving.hidden = false;
      leaving.style.top = `${top - (anchor.getBoundingClientRect().top - anchorTop)}px`;
      const fades = [leaving.animate(fadeOut, { ...crossFade, fill: 'forwards' }).finished];
      const arriving = panel.querySelector<HTMLElement>(`[data-chapter="${id}"]`);
      if (arriving) fades.push(arriving.animate(fadeIn, crossFade).finished);
      try {
        await Promise.all(fades);
      } catch {
        // Cancelled (the page is leaving); the cleanup below still restores the reader.
      } finally {
        leaving.getAnimations().forEach((animation) => animation.cancel());
        leaving.removeAttribute('style');
        leaving.inert = false;
        leaving.hidden = true;
        chapterTurning = false;
      }
    };

    const selectTab = (tab: HTMLElement) => {
      for (const candidate of tab.parentElement?.querySelectorAll<HTMLElement>('[data-codex-tab]') ?? []) {
        const selected = candidate === tab;
        candidate.setAttribute('aria-selected', String(selected));
        candidate.tabIndex = selected ? 0 : -1;
        const tabPanel = document.getElementById(candidate.getAttribute('aria-controls') ?? '');
        if (tabPanel) tabPanel.hidden = !selected;
      }
      tab.focus();
    };

    scope.listen(root, 'click', (event) => {
      if (!(event.target instanceof Element)) return;
      const target = event.target;
      const glideLink = target.closest<HTMLElement>('[data-glide-to]');
      if (glideLink) {
        event.preventDefault();
        goTo(Number(glideLink.dataset.glideTo));
        return;
      }
      if (target.closest('[data-contents-toggle]')) {
        setContentsOpen(contentsToggle?.getAttribute('aria-expanded') !== 'true');
        return;
      }
      const branch = narrowContents.matches ? target.closest<HTMLElement>('[data-contents-panel]') : null;
      if (branch && branches.includes(branch)) {
        branch.setAttribute('aria-expanded', String(branch.getAttribute('aria-expanded') !== 'true'));
        return;
      }
      // Any click outside the open contents (narrow screens) folds them away; inside, picking an entry does.
      // The fold comes after the click's action: opening another panel moves the list into it, and a node
      // re-inserted elsewhere starts from its current style without a transition, so folding first would
      // snap it shut. `openPanel` lays the list out in its new panel (still open) before its first `await`.
      const fold = !target.closest('[data-contents]') || target.closest('[data-contents] button') !== null;
      // View all leaves only the stage behind its sheet (`is-browsing`, until the last panel closes) and, on
      // narrow screens, opens with the contents already unfolded.
      const viewAll = target.closest('[data-view-all]') !== null;
      if (viewAll) root.classList.add('is-browsing');
      handlePanelClick(target);
      if (viewAll) setContentsOpen(true);
      else if (fold) setContentsOpen(false);
    });

    const handlePanelClick = (target: Element) => {
      const opener = target.closest<HTMLElement>('[data-open-panel]');
      if (opener?.dataset.openPanel) {
        openPanel(opener.dataset.openPanel);
        return;
      }
      const panel = target.closest<HTMLDialogElement>('.novel-panel');
      if (!panel) return;
      // Backdrop clicks target the dialog itself; its content always sits in child elements.
      if (target === panel || target.closest('[data-panel-close]')) {
        closePanel(panel);
        return;
      }
      const chapterId = target.closest<HTMLElement>('[data-chapter-open]')?.dataset.chapterOpen;
      if (chapterId && panel.id === 'panel-chapters') showChapter(panel, chapterId);
      else if (chapterId) {
        openPanel('chapters');
        const chaptersPanel = document.getElementById('panel-chapters');
        if (chaptersPanel instanceof HTMLDialogElement) swapChapter(chaptersPanel, chapterId);
      }
      const tab = target.closest<HTMLElement>('[data-codex-tab]');
      if (tab) selectTab(tab);
    };

    scope.listen(root, 'keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      const tab = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-codex-tab]') : null;
      const tabs = Array.from(tab?.parentElement?.querySelectorAll<HTMLElement>('[data-codex-tab]') ?? []);
      if (!tab || tabs.length === 0) return;
      event.preventDefault();
      const step = event.key === 'ArrowRight' ? 1 : -1;
      selectTab(tabs[(tabs.indexOf(tab) + step + tabs.length) % tabs.length]);
    });

    for (const panel of panels) {
      scope.listen(panel, 'cancel', (event) => {
        event.preventDefault();
        closePanel(panel);
      });
      scope.listen(panel, 'close', () => {
        panel.classList.remove('is-closing', 'is-switching');
        if (panels.some((other) => other.open)) return;
        setContentsOpen(false);
        root.classList.remove('is-browsing');
      });
    }

    const setPlaying = (playing: boolean) => {
      if (playing) void video.play().catch(() => setPlaying(false));
      else video.pause();
      motionToggle.setAttribute('aria-pressed', String(!playing));
      motionToggle.querySelector('.motion-label')!.textContent = playing ? 'Pause' : 'Play';
      root.classList.toggle('is-paused', !playing);
    };
    scope.listen(motionToggle, 'click', () => setPlaying(video.paused));
    if (reducedMotion.matches) setPlaying(false);

    scope.cleanup(() => {
      scope.cancelFrame(frame);
      scope.cancelFrame(glideFrame);
      scope.cancelFrame(driftFrame);
      scope.clearTimeout(settleTimer);
      video.pause();
      for (const panel of panels) if (panel.open) panel.close();
    });
    updateScroll();
    setActiveScene(stops[currentStop] ?? scenes[0]);
    // Enables transitions only after the first placement, so the page does not animate in from the origin.
    scope.frame(() => root.classList.add('is-ready'));
  }
</script>

<style lang="scss">
  @use '../styles/global.scss' as *;
  @use '../styles/Navbar.scss' as navbar;

  $night: #0c1131;
  $moon: #eef1ff;
  $glow: #9fe9f2;
  $ease-camera: cubic-bezier(0.65, 0, 0.35, 1);
  $ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  // The reading sheet's paper, opaque; layers on the sheet that must hide what scrolls beneath paint it too.
  $sheet-surface: #fAfAf5;

  // Page-level overrides are gated on `.novel`, so other routes keep the white canvas.
  :global(html:has(.novel)) {
    // Panels lock scrolling with `overflow: hidden`; the stable gutter keeps the layout from shifting right.
    // Scene-to-scene movement is glided by the page script, so no CSS snapping or smooth scrolling here.
    scrollbar-gutter: stable;
    overscroll-behavior-y: none;
  }

  :global(body:has(.novel)) {
    background: $night;
  }

  // The fixed stage covers the site-wide circle textures and grid marks; they would only add noise behind the video.
  :global(body:has(.novel) :is(.dynamic-circles-container, .grid-marks)) {
    display: none;
  }

  // Navbar over the night: the site's ink tones fade into the dark scenes, so once a chapter takes the stage
  // (or View all clears the opening mist) the bar turns to moonlight, and the hover stripe to a translucent
  // blue the moonlit text stays legible on. The brand circles keep their palette. Without a script-set
  // scene (before the first page load), the bar stays dark on the opening mist; once a navigation away
  // starts (`is-leaving`), it returns to its default colours for the next page.
  $night-navbar: "html:has(.novel[data-active-scene]:not([data-active-scene='intro'], .is-leaving), .novel.is-browsing:not(.is-leaving) .novel-panel[open]:not(.is-closing)) .navbar";

  :global(html:has(.novel) .navbar :is(.title, .divider)) {
    transition: color 240ms ease-out;
  }

  :global(#{$night-navbar} .title) {
    color: rgba($moon, 0.92);
  }

  :global(#{$night-navbar} .divider) {
    color: rgba($moon, 0.3);
  }

  :global(#{$night-navbar} .nav-link) {
    color: rgba($moon, 0.6);
  }

  :global(#{$night-navbar} .nav-link:is(:hover, .active)) {
    color: $moon;
  }

  :global(#{$night-navbar} .nav-link::before) {
    background: rgba($light-blue, 0.4);
  }

  .novel {
    --intro: 0;
    color: $moon;
    font-family: $font-family-default;
  }

  // Stage -----------------------------------------------------------------

  .stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: $night;
    pointer-events: none;
  }

  .stage-camera,
  .hotspot-layer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    transform-origin: 0 0;
    will-change: transform;
  }

  .is-ready .stage-camera,
  .is-ready .hotspot-layer {
    transition: transform 2.2s $ease-camera;
  }

  .stage-drift {
    width: 100%;
    height: 100%;
    transform: scale(1.03);
    transition: transform 1.4s $ease-out;
  }

  .stage-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    // The mist lifts while the scene sharpens.
    filter: saturate(calc(0.75 + var(--intro) * 0.25)) blur(calc((1 - var(--intro)) * 6px));
  }

  .stage-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba($night, 0.72) 0%, rgba($night, 0.38) 34%, rgba($night, 0) 58%),
      linear-gradient(180deg, rgba($night, 0.45) 0%, rgba($night, 0) 22%, rgba($night, 0) 70%, rgba($night, 0.55) 100%);
    opacity: var(--intro);
  }

  // Opening mist: the site's white editorial canvas, dissolving into the night meadow.
  .stage-mist {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 55% at 62% 48%, rgba($mist, 0.55) 0%, rgba($mist, 0.92) 62%, $mist 100%);
    opacity: calc(1 - var(--intro));
  }

  // Hotspots --------------------------------------------------------------

  .hotspot-layer {
    z-index: 2;
    pointer-events: none;
  }

  .hotspot {
    position: absolute;
    // Counter-scales so markers keep their size while the camera zooms.
    transform: scale(calc(1 / var(--camera-scale, 1)));
    transform-origin: 0 0;
    opacity: 0;
    visibility: hidden;

    &.is-visible {
      opacity: 1;
      visibility: visible;
    }
  }

  // Markers fade out at once, then reappear after the camera has mostly settled on the next scene.
  .is-ready .hotspot {
    transition-property: opacity, visibility, transform;
    transition-duration: 700ms, 0s, 2.2s;
    transition-timing-function: ease, linear, $ease-camera;
    transition-delay: 0s, 700ms, 0s;

    &.is-visible {
      transition-duration: 900ms, 0s, 2.2s;
      transition-delay: 1.6s, 0s, 0s;
    }
  }

  // Interaction text: a ring plus a label that swaps on hover. Used on the image and in the outro.
  .hotspot-trigger {
    --ring-size: 2.8rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0;
    border: 0;
    background: none;
    color: $moon;
    font: inherit;
    cursor: var(--cursor-pointer);
    pointer-events: auto;

    &:focus-visible {
      outline: none;

      .hotspot-ring {
        box-shadow: 0 0 0 3px rgba($moon, 0.35);
      }
    }
  }

  // Centres the ring on the hotspot point; flipped hotspots near the right edge put the label on the left.
  .hotspot > .hotspot-trigger {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(calc(var(--ring-size) / -2), -50%);
  }

  .hotspot.is-flipped > .hotspot-trigger {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + var(--ring-size) / 2), -50%);

    .hotspot-label {
      padding: 0 0.85rem 0 0;

      &::before {
        right: 0;
        left: auto;
      }
    }

    .swap {
      justify-items: end;
    }
  }

  .hotspot-ring {
    position: relative;
    flex: 0 0 auto;
    width: var(--ring-size);
    height: var(--ring-size);
    border: 1px solid rgba($moon, 0.85);
    border-radius: 50%;
    transition: transform 400ms $ease-out, background-color 300ms ease;

    &::before {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 50%;
      background: $moon;
      box-shadow: 0 0 0.75rem $glow;
      content: '';
      transform: translate(-50%, -50%);
    }

    &::after {
      position: absolute;
      inset: -1px;
      border: 1px solid rgba($moon, 0.6);
      border-radius: 50%;
      content: '';
      animation: hotspot-pulse 2.8s ease-out infinite;
    }
  }

  .hotspot-trigger:hover .hotspot-ring,
  .hotspot-trigger:focus-visible .hotspot-ring {
    background: rgba($moon, 0.12);
    transform: scale(1.12);
  }

  .hotspot-label {
    position: relative;
    padding-left: 0.85rem;
    font-size: 0.95rem;
    letter-spacing: 0.18em;
    white-space: nowrap;
    text-shadow: 0 0 1rem rgba($night, 0.8);

    &::before {
      position: absolute;
      top: 50%;
      left: 0;
      width: 0.3rem;
      height: 0.3rem;
      border-radius: 50%;
      background: rgba($moon, 0.75);
      content: '';
      transform: translateY(-50%);
    }
  }

  // Stacks the default and revealed names in one cell, so the swap never shifts the surrounding layout.
  .swap {
    display: inline-grid;
    justify-items: start;

    > span {
      grid-area: 1 / 1;
      transition: opacity 600ms ease, filter 600ms ease;
    }
  }

  .swap-reveal,
  .is-revealed .swap-default,
  .hotspot-trigger:is(:hover, :focus-visible) .swap-default {
    opacity: 0;
    filter: blur(6px);
  }

  .is-revealed .swap-reveal,
  .hotspot-trigger:is(:hover, :focus-visible) .swap-reveal {
    opacity: 1;
    filter: blur(0);
  }

  @keyframes hotspot-pulse {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    80%,
    100% {
      opacity: 0;
      transform: scale(1.9);
    }
  }

  // Scroll flow -------------------------------------------------------------

  // The navbar keeps an in-flow box above the page content (`Navbar.scss`); pulling the flow up by it
  // makes the opening scene start at scroll 0 and fill exactly one viewport.
  .novel-flow {
    position: relative;
    z-index: 1;
    margin-top: calc(-1 * #{navbar.$navbar-actual-height});
    pointer-events: none;
  }

  // Scroll distance per scene uses `svh` (toolbars shown) so stops never move when mobile toolbars collapse;
  // the sticky frame tracks the visible viewport (`dvh`), so its content stays clear of the bottom bar and
  // follows the screen bottom down when the bar hides.
  .scene {
    position: relative;
    height: 100svh;
  }

  .scene-frame {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    height: 100dvh;
    padding: navbar.$navbar-actual-height 10vw calc(4rem + env(safe-area-inset-bottom));
  }

  // Intro ----------------------------------------------------------------

  .intro-copy {
    align-self: flex-start;
    color: $primary-blue;
    opacity: calc(1 - var(--intro) * 1.6);
    filter: blur(calc(var(--intro) * 8px));
    transform: translateY(calc(var(--intro) * -3rem));
  }

  .intro-kicker {
    margin: 0;
    color: $light-blue;
    font-family: $font-family-heading;
    font-size: 1rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;

    span {
      color: $ex-light-blue;
      padding: 0 0.4rem;
    }
  }

  .intro-copy h1 {
    margin: 1.4rem 0 0;
    color: $content-color;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
    letter-spacing: 0.22em;
    line-height: 1.1;
  }

  .intro-tagline {
    max-width: 32rem;
    margin: 1.25rem 0 0;
    color: $primary-blue;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    letter-spacing: 0.16em;
    line-height: 1.9;
  }

  .intro-rule {
    display: flex;
    gap: 0.7rem;
    margin-top: 2rem;

    span {
      width: 0.75rem;
      height: 0.75rem;
      border-radius: 50%;
      background: $ex-light-blue;

      &:nth-child(2) {
        background: $light-blue;
      }

      &:nth-child(3) {
        background: $primary-blue;
      }
    }
  }

  // The pause button (fixed) centres on the opening cues' text, so both stand on one line at the foot of the
  // opening. The cues' text has a fixed line box (`$cue-line`) sitting the scroll cue's column gap and 1px
  // line above the cues' `bottom`; `cue-aligned-bottom` turns a cues `bottom` into the button's. Keep these
  // in step.
  $cue-bottom: 3.5rem;
  $cue-bottom-narrow: 2rem;
  $cue-gap: 0.4rem;
  $cue-line: 1.5rem;
  $motion-toggle-height: 2.5rem;

  @function cue-aligned-bottom($bottom) {
    @return calc(#{$bottom} + 1px + #{$cue-gap} + #{$cue-line} * 0.5 - #{$motion-toggle-height} * 0.5);
  }

  // "Scroll to enter / View all", top-aligned on one line; only the scroll cue draws its line below.
  .intro-cues {
    position: absolute;
    bottom: $cue-bottom;
    left: 10vw;
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    color: $content-color;
    font-family: $font-family-heading;
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    line-height: $cue-line;
    text-transform: uppercase;
    opacity: calc(1 - var(--intro) * 3);
    pointer-events: auto;
  }

  .intro-cues-divider {
    color: $light-blue;
  }

  .view-all {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: var(--cursor-pointer);
    transition: color 180ms ease-out;

    &:hover,
    &:focus-visible {
      color: $primary-blue;
    }

    &:focus-visible {
      outline: 1px solid currentColor;
      outline-offset: 0.3rem;
    }
  }

  .scroll-cue {
    display: inline-flex;
    flex-direction: column;
    gap: $cue-gap;
    color: inherit;
    text-decoration: none;

    &::after {
      align-self: flex-end;
      width: 75%;
      height: 1px;
      background: currentColor;
      content: '';
      transform-origin: right;
      animation: cue-line 2.4s $ease-out infinite;
    }
  }

  @keyframes cue-line {
    0% {
      transform: scaleX(0);
      transform-origin: left;
    }
    45% {
      transform: scaleX(1);
      transform-origin: left;
    }
    55% {
      transform: scaleX(1);
      transform-origin: right;
    }
    100% {
      transform: scaleX(0);
      transform-origin: right;
    }
  }

  // Verses ----------------------------------------------------------------

  .verse {
    max-width: min(26rem, 80vw);
  }

  .verse-heading {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin: 0 0 1.75rem;
    font-weight: 400;
  }

  .verse-numeral {
    color: rgba($moon, 0.6);
    font-family: $font-family-heading;
    font-size: 0.95rem;
    letter-spacing: 0.24em;
  }

  .verse-title {
    position: relative;
    padding-left: 1rem;
    font-size: 1.1rem;
    letter-spacing: 0.4em;

    &::before {
      position: absolute;
      top: 50%;
      left: 0;
      width: 0.4rem;
      height: 0.4rem;
      border: 1px solid rgba($moon, 0.8);
      content: '';
      transform: translateY(-50%) rotate(45deg);
    }
  }

  .verse-lines {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-size: clamp(1.35rem, 2.1vw, 1.85rem);
    letter-spacing: 0.08em;
    line-height: 1.85;
    text-shadow: 0 0 1.5rem rgba($night, 0.65);
  }

  // Lines surface one by one out of a blur, and sink back when the scene leaves.
  .verse-line,
  .verse-source,
  .verse-heading {
    opacity: 0;
    filter: blur(8px);
    transform: translateY(0.6rem);
    transition:
      opacity 700ms ease,
      filter 700ms ease,
      transform 900ms $ease-out;
  }

  .verse-heading {
    --line: -1;
  }

  .scene.is-active {
    .verse-line,
    .verse-source,
    .verse-heading {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
      transition-duration: 1.2s, 1.2s, 1.4s;
      transition-delay: calc(0.9s + var(--line) * 0.32s);
    }

    .verse-source {
      opacity: 0.6;
    }
  }

  .verse-source {
    margin: 1.5rem 0 0;
    font-size: 0.95rem;
    letter-spacing: 0.16em;
  }

  // Outro ----------------------------------------------------------------

  .scene-outro .scene-frame {
    align-items: center;
    text-align: center;
  }

  .outro-copy {
    opacity: 0;
    filter: blur(8px);
    transition: opacity 1.2s ease 0.6s, filter 1.2s ease 0.6s;
    pointer-events: auto;
  }

  .scene-outro.is-active .outro-copy {
    opacity: 1;
    filter: blur(0);
  }

  .outro-kicker {
    margin: 0;
    color: rgba($moon, 0.65);
    font-family: $font-family-heading;
    font-size: 0.9rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .outro-copy h2 {
    margin: 1rem 0 0;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-shadow: 0 0 2rem rgba($night, 0.8);
  }

  .outro-signature {
    margin: 0.75rem 0 0;
    color: $ex-light-blue;
    font-family: $font-family-special;
    font-size: 2.5rem;
  }

  // Fallback for crops that cannot show every hotspot on the image; see `placeCamera`.
  .outro-cues {
    display: none;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem 2.75rem;
    max-width: 46rem;
    margin: 2.75rem auto 0;
  }

  .novel[data-outro-layout='list'] .outro-cues {
    display: flex;
  }

  // Chapter rail ----------------------------------------------------------

  .chapter-rail {
    position: fixed;
    top: 50%;
    right: 2.5rem;
    z-index: 3;
    opacity: var(--intro);
    transform: translateY(-50%);
    transition: opacity 400ms ease;

    ol {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
      margin: 0;
      padding: 0 0 0 1.1rem;
      list-style: none;

      &::before {
        position: absolute;
        top: 0.3rem;
        bottom: 0.3rem;
        left: 0.25rem;
        width: 1px;
        background: rgba($moon, 0.3);
        content: '';
      }
    }

    a {
      position: relative;
      display: flex;
      align-items: baseline;
      gap: 0.65rem;
      color: rgba($moon, 0.55);
      text-decoration: none;
      transition: color 300ms ease;

      &::before {
        position: absolute;
        top: 50%;
        left: calc(-0.85rem - 0.5px);
        width: 0.42rem;
        height: 0.42rem;
        box-sizing: border-box;
        border: 1px solid rgba($moon, 0.55);
        background: $night;
        content: '';
        transform: translate(-50%, -50%) rotate(45deg);
        transition: background-color 300ms ease, border-color 300ms ease;
      }

      &:hover,
      &:focus-visible,
      &.is-current {
        color: $moon;
        outline: none;
      }

      &.is-current::before {
        border-color: $moon;
        background: $moon;
        box-shadow: 0 0 0.6rem $glow;
      }
    }
  }

  .rail-numeral {
    font-family: $font-family-heading;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
  }

  .rail-title {
    font-size: 0.95rem;
    letter-spacing: 0.2em;
  }

  // Chapter aside ---------------------------------------------------------
  // The book's contents (`data-contents`), shared by every panel. From 1100px it stands at the left edge of
  // the page, vertically centred over the dimmed backdrop, in the page rail's look. Narrower, the sheet covers
  // the page, so the list folds under a 目录 button below the sheet header.

  .chapter-aside button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: var(--cursor-pointer);
  }

  // Outranks the wide-screen `.chapter-aside button` rule; the narrow-screen rule, later and as specific,
  // shows it again.
  .chapter-aside .contents-toggle {
    display: none;
  }

  .contents-fold {
    display: contents;
  }

  @media (min-width: 1100px) {
    .chapter-aside {
      position: fixed;
      top: 50%;
      left: 2.5rem;
      display: none;
      max-width: calc(100vw - 44rem - 5rem);
      transform: translateY(-50%);

      ol {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
        margin: 0;
        padding: 0 0 0 1.1rem;
        list-style: none;

        &::before {
          position: absolute;
          top: 0.3rem;
          bottom: 0.3rem;
          left: 0.25rem;
          width: 1px;
          background: rgba($moon, 0.3);
          content: '';
        }
      }

      button {
        position: relative;
        display: flex;
        align-items: baseline;
        gap: 0.65rem;
        color: rgba($moon, 0.55);
        transition: color 300ms ease;

        &::before {
          position: absolute;
          top: 50%;
          left: calc(-0.85rem - 0.5px);
          width: 0.42rem;
          height: 0.42rem;
          box-sizing: border-box;
          border: 1px solid rgba($moon, 0.55);
          background: $night;
          content: '';
          transform: translate(-50%, -50%) rotate(45deg);
          transition: background-color 300ms ease, border-color 300ms ease;
        }

        &:hover,
        &:focus-visible,
        &[aria-current] {
          color: $moon;
          outline: none;
        }

        &[aria-current]::before {
          border-color: $moon;
          background: $moon;
          box-shadow: 0 0 0.6rem $glow;
        }
      }
    }

    // Chapters hang off the main rail line by a short tick instead of their own line and diamonds.
    .chapter-aside .chapter-aside-chapters {
      gap: 0.9rem;
      // Spacing above is the first chapter's margin, inside the clip, so it folds away with the chapters;
      // padding on the list would stay as its minimum height when folded.
      > li:first-child {
        margin-top: 1rem;
      }

      // Widened by the overhang of the ticks so the collapse clip (`overflow: hidden`) keeps them.
      margin-left: -0.85rem;
      padding-left: 1.95rem;

      &::before {
        content: none;
      }

      button {
        font-size: 0.9em;

        &::before {
          // From the main line (`0.85rem` before the parent titles, plus this list's `1.1rem` indent).
          left: calc(-1.95rem + 0.5px);
          width: 1.1rem;
          height: 1px;
          border: 0;
          background: rgba($moon, 0.3);
          transform: translateY(-50%);
        }

        &[aria-current]::before {
          background: $moon;
          box-shadow: none;
        }
      }
    }

    .novel-panel[open] .chapter-aside {
      display: block;
    }
  }

  @media (max-width: 1099px) {
    // The header's bottom rule is redrawn here in two segments around the 目录 toggle, so the toggle needs no
    // background of its own. The header keeps its 1px border, transparent, so nothing moves.
    .novel-panel:has(> .chapter-aside) > .panel-header {
      border-bottom-color: transparent;
    }

    .chapter-aside {
      --sheet-gutter: 3rem;

      position: relative;
      // Above the body, which is positioned and comes later, so the open contents can cover it.
      z-index: 2;
      order: 1;
      flex: 0 0 auto;
      padding: 0 var(--sheet-gutter);

      // Left segment: from the sheet's edge to the toggle's padding.
      &::before {
        position: absolute;
        top: -1px;
        left: 0;
        width: calc(var(--sheet-gutter) - 0.5rem);
        height: 1px;
        background: rgba($primary-blue, 0.3);
        content: '';
      }

      // Fade under the rule, like the one under the navbar on article pages: the body scrolls up into it
      // rather than being cut at the line. Painted in the sheet's surface colour (see `.contents-fold`), and
      // beneath the open contents.
      &::after {
        position: absolute;
        top: 0.63rem;
        right: 0;
        left: 0;
        z-index: -1;
        height: 1.5rem;
        background: linear-gradient(to bottom, rgba($sheet-surface, 0.9) 0%, rgba($sheet-surface, 0.81) 56%, rgba($sheet-surface, 0) 100%);
        content: '';
        pointer-events: none;
      }

      // Set into the rule like a legend: centred on it (half its own `1.4em` line box up, plus half the
      // line). Its `::before` is the right segment, run past the sheet's edge, which clips it.
      .contents-toggle {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        width: fit-content;
        margin: calc(-0.7em - 0.5px) 0 0 -0.5rem;
        padding: 0 0.5rem;
        color: $primary-blue;
        font-size: 0.9rem;
        letter-spacing: 0.2em;
        line-height: 1.4;

        &::before {
          position: absolute;
          top: calc(50% - 0.5px);
          left: 100%;
          width: 100vw;
          height: 1px;
          background: rgba($primary-blue, 0.3);
          content: '';
        }

        // A chevron pointing down; it turns up while the contents are open.
        &::after {
          width: 0.4rem;
          height: 0.4rem;
          border-right: 1px solid currentColor;
          border-bottom: 1px solid currentColor;
          content: '';
          transform: translateY(-25%) rotate(45deg);
          transition: transform 300ms ease;
        }

        &[aria-expanded='true']::after {
          transform: translateY(25%) rotate(-135deg);
        }

        &:focus-visible {
          outline: 1px solid rgba($primary-blue, 0.55);
          outline-offset: 0.3rem;
        }
      }

      ol {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      button:not(.contents-toggle) {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        color: $light-blue;
        transition: color 180ms ease-out;

        &:hover,
        &:focus-visible,
        &[aria-current] {
          color: $primary-blue;
          outline: none;
        }
      }
    }

    // The open contents cover the top of the body rather than pushing it down: a sheet hung from the
    // toggle's lower edge (`0.63rem`, half its line box below the rule), painted in the sheet's paper so it
    // hides the text beneath. Same fold as the volume's chapters: the grid row opens from `0fr`, and the
    // spacing around the entries is their margin, inside the clip, so nothing remains when shut.
    .contents-fold {
      position: absolute;
      top: 0.63rem;
      right: 0;
      left: 0;
      display: grid;
      grid-template-rows: 0fr;
      padding: 0 var(--sheet-gutter);
      border-bottom: 1px solid rgba($primary-blue, 0.3);
      background: $sheet-surface;
      box-shadow: 0 1.5rem 2rem -1.5rem rgba($night, 0.25);
      visibility: hidden;
      transition: grid-template-rows 420ms ease, visibility 0s 420ms;

      > ol {
        min-height: 0;
        overflow: hidden;

        > li:first-child {
          margin-top: 0.9rem;
        }

        > li:last-child {
          margin-bottom: 1.25rem;
        }
      }
    }

    .contents-toggle[aria-expanded='true'] + .contents-fold {
      grid-template-rows: 1fr;
      visibility: visible;
      transition: grid-template-rows 420ms ease, visibility 0s;
    }

    .chapter-aside .chapter-aside-chapters {
      gap: 0.6rem;
      padding-left: 1.1rem;

      > li:first-child {
        margin-top: 0.6rem;
      }
    }

    .novel-panel .panel-body {
      order: 2;
    }
  }

  // Motion toggle ---------------------------------------------------------

  .motion-toggle {
    position: fixed;
    right: 2.5rem;
    bottom: cue-aligned-bottom($cue-bottom);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    height: $motion-toggle-height;
    padding: 0;
    border: 0;
    background: none;
    color: $content-color;
    font-family: $font-family-heading;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: var(--cursor-pointer);

    &:focus-visible {
      outline: 1px solid currentColor;
      outline-offset: 0.3rem;
    }
  }

  // Dark ink on the opening mist, moonlight once a chapter takes the stage.
  .novel:not([data-active-scene='intro']) .motion-toggle {
    color: rgba($moon, 0.8);
  }

  // View all (`is-browsing`) leaves only the meadow behind the sheet: the opening's copy and cues, the pause
  // button, and the opening mist fade out while a panel is up and return as the last one starts closing. The
  // chapter rail and hotspots need nothing here: View all sits on the opening, where both are already hidden.
  // The mist fades through `filter: opacity()`, as its `opacity` follows the scroll and must not lag.
  .novel-flow,
  .motion-toggle {
    transition: opacity 420ms ease;
  }

  .stage-mist {
    transition: filter 420ms ease;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .novel.is-browsing:has(.novel-panel[open]:not(.is-closing)) {
    .novel-flow,
    .motion-toggle {
      opacity: 0;
      transition-duration: 600ms;
    }

    .stage-mist {
      filter: opacity(0);
      transition-duration: 600ms;
    }
  }

  .motion-icon {
    position: relative;
    width: 0.7rem;
    height: 0.8rem;

    &::before,
    &::after {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 2px;
      background: currentColor;
      content: '';
    }

    &::before {
      left: 0.1rem;
    }

    &::after {
      right: 0.1rem;
    }
  }

  .is-paused .motion-icon {
    &::before {
      left: 0.1rem;
      width: 0;
      height: 0;
      border-top: 0.4rem solid transparent;
      border-bottom: 0.4rem solid transparent;
      border-left: 0.6rem solid currentColor;
      background: none;
    }

    &::after {
      display: none;
    }
  }

  // Panels ---------------------------------------------------------------------

  // Long-form reading returns to the site's white editorial paper, laid over the night meadow.
  :global(html:has(.novel-panel[open])) {
    overflow: hidden;
  }

  .novel-panel {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(44rem, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    border: 0;
    background: none;
    color: $content-color;
    font-family: $font-family-default;
    overflow: hidden;

    // The sheet's paper and edge sit on a pseudo-element, which the wide-screen slide animates: a `transform`
    // on the dialog itself would make it the containing block of `position: fixed` children, trapping the
    // contents aside inside the sheet.
    &::before {
      position: absolute;
      inset: 0;
      z-index: -1;
      box-sizing: border-box;
      border-left: 1px solid rgba($primary-blue, 0.78);
      background: $sheet-surface;
      content: '';
    }

    &[open] {
      display: flex;
      flex-direction: column;
      animation: panel-in 700ms $ease-out;
    }

    &.is-closing {
      animation: panel-out 420ms ease-in forwards;
    }

    &::backdrop {
      background: rgba($night, 0.42);
      backdrop-filter: blur(3px);
      animation: fade-in 600ms ease;
    }

    &.is-closing::backdrop {
      animation: fade-out 420ms ease forwards;
    }
  }

  // Wide screens slide the sheet's parts rather than the dialog: a `transform` on the dialog would trap the
  // fixed contents aside, which instead fades in and out with the backdrop. `closePanel` still sees the
  // slide end, as `::before`'s `animationend` fires on the dialog.
  @media (min-width: 1100px) {
    .novel-panel {
      &[open],
      &.is-closing {
        animation: none;
      }

      &[open]::before,
      &[open] > :not(.chapter-aside) {
        animation: panel-in 700ms $ease-out;
      }

      &.is-closing::before,
      &.is-closing > :not(.chapter-aside) {
        animation: panel-out 420ms ease-in forwards;
      }

      &[open] > .chapter-aside {
        animation: fade-in 600ms ease;
      }

      &.is-closing > .chapter-aside {
        animation: fade-out 420ms ease forwards;
      }
    }
  }

  // Switching from one panel to another swaps the sheet in place, the contents list included. `[open]` and
  // the second class outrank the wide-screen slide and fade rules above. Closing still slides out:
  // `closePanel` waits for that animation's end, so suppressing it would leave the panel stuck open.
  .novel-panel[open].is-switching:not(.is-closing) {
    &,
    &::before,
    &::backdrop,
    & > *,
    & > .chapter-aside {
      animation: none;
    }
  }

  // The volume's chapters show only while its panel is the open one. The fold's grid row animates from the
  // content's real height (`1fr`) to `0fr`, so it moves at one speed. In sequence: opening, the space opens
  // first and then the chapters come into focus; closing, they blur away first and then the space closes.
  .chapter-aside-fold {
    display: grid;
    grid-template-rows: 1fr;
    filter: blur(0);
    transition: grid-template-rows 420ms ease, opacity 320ms ease 420ms, filter 320ms ease 420ms, visibility 0s;

    > .chapter-aside-chapters {
      min-height: 0;
      overflow: hidden;
    }
  }

  .chapter-aside [data-contents-panel]:not([aria-current]) + .chapter-aside-fold {
    grid-template-rows: 0fr;
    opacity: 0;
    filter: blur(6px);
    visibility: hidden;
    transition: opacity 320ms ease, filter 320ms ease, grid-template-rows 420ms ease 320ms, visibility 0s 740ms;
  }

  // Narrow screens: the volume's chapters follow its own unfolding (set by the script) rather than which
  // panel is open.
  @media (max-width: 1099px) {
    .chapter-aside [data-contents-panel][aria-expanded='true'] + .chapter-aside-fold {
      grid-template-rows: 1fr;
      opacity: 1;
      filter: blur(0);
      visibility: visible;
      transition: grid-template-rows 420ms ease, opacity 320ms ease 420ms, filter 320ms ease 420ms, visibility 0s;
    }

    .chapter-aside [data-contents-panel][aria-expanded='false'] + .chapter-aside-fold {
      grid-template-rows: 0fr;
      opacity: 0;
      filter: blur(6px);
      visibility: hidden;
      transition: opacity 320ms ease, filter 320ms ease, grid-template-rows 420ms ease 320ms, visibility 0s 740ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter-aside-fold,
    .chapter-aside [data-contents-panel]:not([aria-current]) + .chapter-aside-fold,
    .chapter-aside [data-contents-panel][aria-expanded] + .chapter-aside-fold,
    .chapter-aside .contents-fold,
    .chapter-aside .contents-toggle::after,
    .chapter-aside .contents-toggle[aria-expanded='true'] + .contents-fold {
      transition: none;
    }
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateX(3rem);
    }
  }

  @keyframes panel-out {
    to {
      opacity: 0;
      transform: translateX(3rem);
    }
  }

  @keyframes panel-up {
    from {
      opacity: 0;
      transform: translateY(3rem);
    }
  }

  @keyframes panel-down {
    to {
      opacity: 0;
      transform: translateY(3rem);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  .panel-header {
    position: relative;
    flex: 0 0 auto;
    padding: 2.25rem 3rem 1.25rem;
    border-bottom: 1px solid rgba($primary-blue, 0.3);
  }

  .panel-kicker {
    margin: 0;
    color: $light-blue;
    font-family: $font-family-heading;
    font-size: 0.8rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;

    span {
      padding: 0 0.35rem;
      color: $ex-light-blue;
    }
  }

  .panel-title {
    position: relative;
    margin: 0.6rem 4rem 0 0;
    padding-left: 1.1rem;
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1.4;

    &::before {
      position: absolute;
      top: 0.15em;
      left: 0;
      width: 0.45rem;
      height: 1.1em;
      background: $ex-light-blue;
      content: '';
    }
  }

  .panel-close {
    position: absolute;
    top: 2rem;
    right: 2.5rem;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: var(--cursor-pointer);

    &::before,
    &::after {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0.95rem;
      height: 1px;
      background: $primary-blue;
      content: '';
      opacity: 0.7;
      transform: translate(-50%, -50%) rotate(45deg);
      transition: opacity 180ms ease-out;
    }

    &::after {
      transform: translate(-50%, -50%) rotate(-45deg);
    }

    &:hover::before,
    &:hover::after,
    &:focus-visible::before,
    &:focus-visible::after {
      opacity: 1;
    }

    &:focus-visible {
      outline: 1px solid rgba($primary-blue, 0.55);
      outline-offset: -0.35rem;
    }
  }

  .panel-body {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    padding: 2rem 3rem 4rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-color: rgba($primary-blue, 0.4) transparent;
    scrollbar-width: thin;
  }

  .prose {
    font-size: 1rem;
    letter-spacing: 0.02em;
    line-height: 2.1;

    :global(p) {
      margin: 0 0 1.2em;
    }

    :global(strong) {
      background: linear-gradient(transparent 62%, rgba($ex-light-blue, 0.9) 62%);
      font-weight: 500;
    }

    :global(em) {
      color: $primary-blue;
      font-style: normal;
    }
  }

  .panel-epigraph {
    margin: 0 0 2rem;
    padding: 0.85rem 1.2rem;
    border-left: 0.35rem solid $ex-light-blue;
    color: $primary-blue;
    letter-spacing: 0.08em;
    line-height: 1.9;
  }

  // View all's blank sheet: one quiet prompt, centred (wide), or low in the sheet below the unfolded
  // contents (narrow). Each layout names where its contents stand.
  .index-body {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .index-prompt {
    max-width: 18rem;
    text-align: center;

    &::before {
      display: block;
      width: 0.5rem;
      height: 0.5rem;
      margin: 0 auto 1.4rem;
      border: 1px solid $light-blue;
      content: '';
      transform: rotate(45deg);
    }
  }

  .index-prompt-kicker {
    margin: 0;
    color: $light-blue;
    font-family: $font-family-heading;
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .index-prompt-text {
    margin: 0.8rem 0 0;
    color: $content-color;
    letter-spacing: 0.12em;
    line-height: 1.9;
  }

  .index-prompt-text[data-layout='narrow'] {
    display: none;
  }

  @media (max-width: 1099px) {
    .panel-body.index-body {
      align-items: flex-end;
      padding-bottom: 5rem;
    }

    .index-prompt-text[data-layout='wide'] {
      display: none;
    }

    .index-prompt-text[data-layout='narrow'] {
      display: block;
    }
  }

  // Shared bordered link style for in-panel navigation, mirroring the article pager.
  .panel-next,
  .reader-pager button {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
    padding: 0.95rem 1.15rem;
    border: 1px solid rgba($primary-blue, 0.5);
    background: rgba(#fff, 0.6);
    color: $content-color;
    font: inherit;
    letter-spacing: 0.08em;
    text-align: left;
    cursor: var(--cursor-pointer);
    transition: background-color 180ms ease-out, border-color 180ms ease-out;

    &:hover,
    &:focus-visible {
      border-color: $primary-blue;
      background: rgba($ex-light-blue, 0.35);
      outline: none;
    }
  }

  .panel-next {
    align-items: flex-end;
    margin-top: 2.5rem;
    text-align: right;

    &::after {
      color: $light-blue;
      font-family: $font-family-heading;
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      content: 'NEXT →';
    }
  }

  .reader-number {
    margin: 0;
    color: $light-blue;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
  }


  .reader-header {
    margin: 1.5rem 0 2rem;
    text-align: center;
  }

  .reader-title {
    margin: 0.6rem 0 0;
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    outline: none;
  }

  .reader-section + .reader-section {
    margin-top: 2.5rem;
  }

  .reader-section-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.5rem;
    color: $primary-blue;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.3em;

    &::before,
    &::after {
      flex: 1 1 auto;
      height: 1px;
      background: rgba($primary-blue, 0.35);
      content: '';
    }
  }

  .reader-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3rem;

    span {
      color: $light-blue;
      font-family: $font-family-heading;
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    button:last-child {
      align-items: flex-end;
      text-align: right;
    }
  }

  .codex-note {
    color: $light-blue;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-align: center;

    :global(p) {
      margin: 0;
    }

    :global(strong) {
      font-weight: 400;
    }
  }

  .codex-tabs {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    margin-top: 1.5rem;
    border-bottom: 1px solid rgba($primary-blue, 0.35);
  }

  .codex-tab {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.5rem 0.5rem 0.85rem;
    border: 0;
    background: none;
    color: $light-blue;
    font: inherit;
    cursor: var(--cursor-pointer);
    transition: color 220ms ease;

    &::after {
      position: absolute;
      right: 25%;
      bottom: -1px;
      left: 25%;
      height: 2px;
      background: $primary-blue;
      content: '';
      transform: scaleX(0);
      transition: transform 320ms $ease-out;
    }

    &[aria-selected='true'] {
      color: $content-color;

      &::after {
        transform: scaleX(1);
      }
    }

    &:hover,
    &:focus-visible {
      color: $content-color;
      outline: none;
    }
  }

  .codex-tab-latin,
  .character-latin {
    color: $primary-blue;
    font-family: $font-family-special;
    font-size: 2rem;
    line-height: 1;
  }

  .codex-tab-name {
    font-size: 0.95rem;
    letter-spacing: 0.2em;
  }

  .character-card {
    margin-top: 2rem;
    animation: fade-in 500ms ease;
  }

  .character-header {
    position: relative;
    padding: 1.5rem 7rem 1.35rem 1.5rem;
    border: 1px solid rgba($primary-blue, 0.45);
    background: linear-gradient(120deg, rgba($ex-light-blue, 0.6), rgba(#fff, 0) 70%);
    overflow: hidden;

    // A star-shaped crest echoing the diamond markers used across the page.
    &::before,
    &::after {
      position: absolute;
      top: 50%;
      right: 2.25rem;
      width: 3.5rem;
      height: 3.5rem;
      border: 1px solid rgba($primary-blue, 0.4);
      content: '';
      transform: translateY(-50%) rotate(45deg);
    }

    &::after {
      transform: translateY(-50%);
    }
  }

  .character-affinity {
    margin: 0;
    color: $light-blue;
    font-size: 0.78rem;
    letter-spacing: 0.28em;
  }

  .character-name {
    margin: 0.45rem 0 0;
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    line-height: 1.3;
  }

  .character-latin {
    margin: 0.1rem 0 0;
  }

  .character-epithet {
    margin: 0.6rem 0 0;
    color: $primary-blue;
    font-size: 0.9rem;
    letter-spacing: 0.06em;

    :global(em) {
      font-style: normal;
    }
  }

  .character-fields {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    column-gap: 1rem;
    margin: 1.25rem 0 0;
  }

  .character-field {
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid rgba($primary-blue, 0.25);

    &.is-long {
      grid-column: 1 / -1;
    }

    dt {
      color: $light-blue;
      font-size: 0.75rem;
      letter-spacing: 0.2em;
    }

    dd {
      margin: 0.3rem 0 0;
      line-height: 1.9;
    }
  }

  .character-remark {
    margin: 1.5rem 0 0;
    padding: 0.75rem 1.1rem;
    border-left: 0.35rem solid $ex-light-blue;
    color: $primary-blue;
    line-height: 1.9;
  }

  .cycle-figure {
    margin: 0 0 2rem;
    padding: 1.25rem 1rem 0.85rem;
    border: 1px solid rgba($primary-blue, 0.4);
    background: rgba(#fff, 0.6);

    figcaption {
      margin-top: 0.5rem;
      color: $light-blue;
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      text-align: center;
    }
  }

  .cycle-chart {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;

    text {
      font-size: 12px;
      letter-spacing: 0.08em;
    }
  }

  .cycle-axis {
    stroke: rgba($primary-blue, 0.35);
  }

  .cycle-tick {
    line {
      stroke: rgba($primary-blue, 0.25);
      stroke-dasharray: 2 4;
    }

    text {
      fill: $light-blue;
      text-anchor: middle;
    }
  }

  .cycle-moon,
  .cycle-star {
    fill: none;
    stroke-width: 2;
  }

  .cycle-moon {
    stroke: $primary-blue;
  }

  .cycle-star {
    stroke: $light-blue;
    stroke-dasharray: 6 5;
  }

  // The moon curve draws itself each time the panel opens.
  .novel-panel[open] path.cycle-moon {
    stroke-dasharray: 1200;
    animation: draw-curve 2.4s $ease-out both;
  }

  @keyframes draw-curve {
    from {
      stroke-dashoffset: 1200;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .cycle-label text {
    fill: $content-color;
    font-size: 13px;
  }

  .cycle-legend text {
    fill: $light-blue;
  }

  // Responsive -------------------------------------------------------------

  @media (max-width: 850px) {
    .scene-frame {
      justify-content: flex-end;
      padding: 8rem 1.5rem 5.5rem;
    }

    // Anchored to the bottom rather than centred, so the title keeps a fixed distance above the scroll cue.
    .scene-intro .scene-frame {
      justify-content: flex-end;
      padding-bottom: calc(11rem + env(safe-area-inset-bottom));
    }

    .stage-shade {
      background:
        linear-gradient(180deg, rgba($night, 0.5) 0%, rgba($night, 0) 24%, rgba($night, 0) 42%, rgba($night, 0.82) 78%, rgba($night, 0.92) 100%);
    }

    .stage-mist {
      background: radial-gradient(ellipse 80% 45% at 50% 40%, rgba($mist, 0.6) 0%, rgba($mist, 0.92) 65%, $mist 100%);
    }

    // The title is one long Latin word that cannot wrap: below about 370px its 3rem would run past the
    // screen's edge, widening the page so the browser zooms out and the bottom-anchored opening slides up
    // off the fixed pause button. It shrinks with the width instead.
    .intro-copy h1 {
      font-size: min(3rem, 13vw);
      letter-spacing: 0.16em;
    }

    // Letter spacing and gap tighten below 350px so "Scroll to enter / View all" stays on one line, clear
    // of the pause button (0.18em at 350px down to 0.04em at 300px).
    .intro-cues {
      bottom: $cue-bottom-narrow;
      left: 1.5rem;
      gap: clamp(0.4rem, (100vw - 270px) * 0.12, 0.6rem);
      font-size: 0.78rem;
      letter-spacing: clamp(0.04em, (100vw - 286px) * 0.035, 0.18em);
      white-space: nowrap;
    }

    .verse {
      max-width: none;
    }

    .verse-heading {
      margin-bottom: 1rem;
    }

    .verse-lines {
      font-size: 1.2rem;
      line-height: 1.8;
    }

    .verse-source {
      margin-top: 1rem;
      font-size: 0.82rem;
    }

    .hotspot-trigger {
      --ring-size: 2.3rem;
    }

    .hotspot-label {
      font-size: 0.85rem;
    }

    // The outro list packs five cues into a narrow row: smaller rings, and the ring alone marks each cue.
    .outro-cues {
      gap: 1rem 1.5rem;

      .hotspot-trigger {
        --ring-size: 1.5rem;
        gap: 0.55rem;
      }

      .hotspot-ring::before {
        width: 0.3rem;
        height: 0.3rem;
      }

      .hotspot-label {
        padding-left: 0;

        &::before {
          display: none;
        }
      }
    }

    .novel-panel {
      inset: auto 0 0;
      width: 100vw;
      height: 90dvh;
      border-top: 1px solid rgba($primary-blue, 0.78);
      border-left: 0;

      &[open] {
        animation-name: panel-up;
      }

      &.is-closing {
        animation-name: panel-down;
      }
    }

    .panel-header {
      padding: 1.5rem 1.25rem 1rem;
    }

    .chapter-aside {
      --sheet-gutter: 1.25rem;
    }

    .panel-title {
      margin-right: 3rem;
    }

    .panel-close {
      top: 1.25rem;
      right: 1.25rem;
    }

    .panel-body {
      padding: 1.5rem 1.25rem 3rem;
    }

    .prose {
      font-size: 0.95rem;
      line-height: 1.95;
    }

    .reader-pager {
      grid-template-columns: 1fr;
    }

    .character-header {
      padding-right: 5rem;

      &::before,
      &::after {
        right: 1.5rem;
        width: 2.5rem;
        height: 2.5rem;
      }
    }

    .character-name {
      font-size: 1.6rem;
    }

    .chapter-rail {
      right: 0.85rem;
      top: 38%;

      .rail-numeral,
      .rail-title {
        display: none;
      }

      a {
        width: 0.5rem;
        height: 0.8rem;
      }
    }

    .motion-toggle {
      right: 1.5rem;
      bottom: cue-aligned-bottom($cue-bottom-narrow);

      .motion-label {
        display: none;
      }
    }
  }

  // Mirrors the narrow navbar box in `Navbar.scss` (1.25rem top margin, fixed content, no height).
