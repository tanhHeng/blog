---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import '../styles/global.scss';
---

<DefaultLayout>
	<div class="left-content">
			<div class="scroll-snap-section"></div>
			<div class="scroll-snap-section"></div>
			<div class="scroll-snap-section"></div>
			<div class="scroll-snap-section"></div>
		<div class="left-container">
			<section class="main-content is-active">
				<div class="subtitle">
					<p>Welcom to</p>
					<img src="/svg/X.svg" alt="X"/>
					<img src="/svg/X.svg" alt="X"/>
					<img src="/svg/X.svg" alt="X"/>
				</div>
				<h1 class="title">tanh_Heng's Blog</h1>
				<div class="signature">
					<p>Life is Piano.</p>
					<div class="circles-grid">
						{Array.from({ length: 40 }).map(() => (
							<span class="circle"></span>
						))}
					</div>
				</div>
			</section>
			<section class="aboutme-content" hidden>
				<p class="title">About Me</p>
				<p class="text">这里是 tanh丶桁~一名深度学习爱好者，同时也是业余平面设计师，在代码、算法与视觉之间反复横跳的交叉领域探索者。<br>我热衷于用技术解决实际问题，也用设计表达技术背后的温度。GitHub 是我沉淀技术思考、与社区协作共创的地方——你看到的每个仓库都是我某一领域的实践痕迹。</p>
				<div class="tags">
					<p class="tag-title">language</p>
					{Array.from(["python", "java"]).map((lang) => (
						<p class="tag">{lang}</p>
					))}
				</div>
				<div class="tags">
					<p class="tag-title">interest</p>
					{Array.from(["sleep", "eat", "graphic design", "deep learning"]).map((lang) => (
						<p class="tag">{lang}</p>
					))}
				</div>
			</section>
			<section class="recent-content" hidden>
				<p class="title">Recent</p>
				<div class="recent-container">
					<p class="recent-index">01</p>
					<div class="recent-info">
						<p class="recent-title">此功能仍在开发中</p>
						<div class="recent-detail">
							<p>2026-07-17</p>
							<p>Developing</p>
						</div>
					</div>
				</div>
			</section>
			<section class="footpage-content" hidden>
				<p class="signature"><span>Life is Piano.</span><span>You are Pianist.</span></p>
				<p class="footnote">tanh.moe | Personal Blog | All Rights Reserved</p>
			</section>
		</div>
	</div>
</DefaultLayout>

<script is:inline>
  (function() {
    const snapSections = Array.from(document.querySelectorAll('.scroll-snap-section'));
    const contentSections = Array.from(document.querySelectorAll('.left-container section'));
    const circlesGrid = document.querySelector('.main-content .circles-grid');
    const signatureCircles = Array.from(circlesGrid?.querySelectorAll('.circle') ?? []);
    const mainTitle = document.querySelector('.main-content > .title');
    const signature = document.querySelector('.main-content > .signature');
    let currentIndex = 0;
    let transitionController;
    const animationClasses = [
      'animate__animated',
      'animate__fadeInUp',
      'animate__fadeInDown',
      'animate__fadeOutUp',
      'animate__fadeOutDown',
    ];

    function syncSignaturePosition() {
      if (!mainTitle || !signature) return;

      const titleStyle = getComputedStyle(mainTitle);
      const lineHeight = Number.parseFloat(titleStyle.lineHeight);
      const wrapOffset = matchMedia('(max-width: 900px)').matches
        ? Math.max(0, mainTitle.getBoundingClientRect().height - lineHeight)
        : 0;
      signature.style.setProperty('--title-wrap-offset', `${wrapOffset}px`);
    }

    new ResizeObserver(syncSignaturePosition).observe(mainTitle);
    syncSignaturePosition();

    function syncSignatureCircles() {
      if (!circlesGrid || signatureCircles.length === 0) return;

      const isMobile = matchMedia('(max-width: 900px)').matches;
      const columns = isMobile ? 8 : 10;
      const rows = isMobile ? 3 : 4;
      circlesGrid.style.setProperty('--signature-columns', String(columns));
      circlesGrid.style.setProperty('--signature-rows', String(rows));
      signatureCircles.forEach((circle, index) => {
        circle.hidden = index >= columns * rows;
      });
    }

    new ResizeObserver(syncSignatureCircles).observe(circlesGrid);
    syncSignatureCircles();

    function transitionTo(nextIndex, direction) {
      if (nextIndex === currentIndex) return;

      transitionController?.abort();
      const controller = new AbortController();
      transitionController = controller;

      const currentSection = contentSections[currentIndex];
      const nextSection = contentSections[nextIndex];
      const entranceAnimation = direction === 'down' ? 'animate__fadeInUp' : 'animate__fadeInDown';
      const exitAnimation = direction === 'down' ? 'animate__fadeOutUp' : 'animate__fadeOutDown';

      contentSections.forEach((section, index) => {
        section.hidden = index !== currentIndex;
        section.classList.remove(...animationClasses, 'is-active', 'is-leaving');
      });

      nextSection.hidden = false;
      currentSection.classList.add('is-leaving', 'animate__animated', exitAnimation);
      nextSection.classList.add('is-active', 'animate__animated', entranceAnimation);
      currentIndex = nextIndex;

      nextSection.addEventListener('animationend', function() {
        currentSection.hidden = true;
        currentSection.classList.remove(...animationClasses, 'is-leaving');
        nextSection.classList.remove(...animationClasses);
        controller.abort();
        if (transitionController === controller) transitionController = undefined;
      }, { signal: controller.signal });
    }

    const observer = new IntersectionObserver((entries) => {
      const visibleEntries = entries.filter((entry) => entry.isIntersecting && entry.intersectionRatio >= 0.5);
      if (visibleEntries.length === 0) return;

      const nextIndex = snapSections.indexOf(visibleEntries.reduce((mostVisible, entry) => (
        entry.intersectionRatio > mostVisible.intersectionRatio ? entry : mostVisible
      )).target);
      const direction = nextIndex > currentIndex ? 'down' : 'up';
      transitionTo(nextIndex, direction);
    }, { threshold: [0.5] });

    snapSections.forEach((section) => observer.observe(section));
  })();
</script>

<style scoped lang="scss">
@use '../styles/global.scss' as *;
@use '../styles/Navbar.scss' as navbar;

html {
	overflow-x: hidden;
	overflow-y: scroll;
	scroll-snap-type: y mandatory;
}

body {
	overflow: visible;
}

p {
	margin: 0;
}

.left-container section[hidden] {
	display: none;
}

.animate__animated.animate__fadeInUp,
.animate__animated.animate__fadeInDown,
.animate__animated.animate__fadeOutUp,
.animate__animated.animate__fadeOutDown {
  --animate-duration: 600ms;
}

.left-content {
	position: relative;
	width: calc(100vw - 70.5vh + var(--hero-right-overflow, 0px));
	margin-top: calc(-1 * navbar.$navbar-actual-height);
}


.scroll-snap-section {
	height: 100vh;
	scroll-snap-align: start;
	scroll-snap-stop: always;
}

.left-container {
	position: fixed;
	top: calc(navbar.$navbar-margin-vertical / 1.5);
	left: max(navbar.$navbar-margin-left, calc((100vw - 70.5vh + var(--hero-right-overflow, 0px) - 40rem) / 2));
	width: 40rem;
	height: 100vh;
	display: grid;
	align-items: center;
	justify-items: start;
	section {
		grid-area: 1 / 1;
		width: 40rem;
		min-width: 0;
	}
	z-index: 2;
	pointer-events: none;
}

.title {
	font-family: $font-family-default;
	font-size: $font-size-title;
	color: $home-title-color;
	margin: 0;
	font-weight: 500;
}


.main-content {
	display: flex;
	flex-direction: column;
	.subtitle {
		display: flex;
		gap: 1rem;
		p {
			font-family: $font-family-default;
			font-size: $font-size-larger-2;
			color: $primary-blue;
			margin: 0;
			line-height: 1;
		}
		img {
			width: $font-size-larger-2;
			height: $font-size-larger-2;
		}
	}
	.signature {
		display: flex;
		margin-top: 2rem;

		.circles-grid {
			display: grid;
			order: -1;
			grid-template-columns: repeat(10, 0.5rem);
			grid-template-rows: repeat(4, 0.5rem);
			gap: 2rem;
			
			.circle {
				width: 0.5rem;
				height: 0.5rem;
				border-radius: 50%;
				background-color: $ex-light-blue;
			}
		}

		p {
			font-family: $font-family-special;
			font-size: $font-size-title;
			color: $light-blue;
			white-space: nowrap;
			margin-left: 2rem;
			margin-top: -0.5rem;
		}
	}
}


.aboutme-content {

	display: flex;
	flex-direction: column;
	gap: 1rem;

	.text {
		font-family: $font-family-chinese;
		font-size: $font-size-content;
		color: $content-color;
		line-height: 2;
		margin: 0;
	}

	.tags {
		display: flex;
		align-items: left;
		gap: 1rem;
		margin: 0;
		color: $primary-blue;
		font-family: $font-family-heading;
		line-height: 1;

		.tag-title {
			font-weight: bold;
			margin: 0;
		}

		.tag {
			font-weight: normal;
			margin: 0;
		}
	}
}

.recent-content {
	display: flex;
	flex-direction: column;
	gap: 1rem;
	min-height: 15rem;

	.recent-container {
		display: flex;
		flex-direction: row;
		gap: 1rem;
		font-size: $font-size-larger-1;

		.recent-index {
			font-family: $font-family-default;
			width: 2rem;
			height: 2rem;
			text-align: center;
			color: #FFFFFF;
			background-color: $primary-blue;
		}

		.recent-title {
			font-family: $font-family-chinese;
			color: $content-color;
			line-height: 1;
		}

		.recent-detail {
			display: flex;
			flex-direction: row;
			gap: 1rem;
			font-size: $font-size-content;
			color: $light-blue;
			line-height: 2;
		}

	}
}

.footpage-content {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 0;
	padding-bottom: 3rem;

	.signature {
		display: flex;
		gap: 0;
		font-size: 4rem;
		font-family: $font-family-special;
		color: $primary-blue;
		letter-spacing: 2px;
		flex-direction: column;
		line-height: 1;

		span {
			white-space: wrap;
		}
	}
	.footnote {
		margin-top: 0.75rem;
		font-size: $font-size-larger-1;
		font-weight: 500;
		color: $light-blue;
	}
}


@media (min-width: 901px) and (max-width: 1200px) {
	.left-content {
		width: calc(100vw - 70.5vh + var(--hero-right-overflow, 0px));
	}

	.left-container {
		left: max(1rem, navbar.$navbar-margin-left);
		width: min(40rem, calc(100vw - 70.5vh + var(--hero-right-overflow, 0px) - 2rem));
		min-width: 0;

		section {
			width: 100%;
			min-width: 0;
			max-width: 100%;
		}
	}
}
@media (max-width: 900px) {

	.left-content {
		width: 100%;
		margin-top: 0;
	}

	.left-container {
		top: 0;
		left: 0;
		box-sizing: border-box;
		width: 100%;
		height: 100dvh;
		padding: (6.5rem - navbar.$navbar-margin-vertical) 1.25rem 2rem;
		align-items: center;

		section {
			width: 100%;
			max-height: calc(100dvh - #{8.5rem - navbar.$navbar-margin-vertical});
			overflow-y: auto;
		}
	}

	.title {
		font-size: clamp(2.25rem, 12vw, 3.25rem);
		line-height: 1.1;
	}

	.main-content {
		.subtitle {
			gap: 0.6rem;

			p {
				font-size: 1.1rem;
			}

			img {
				width: 1.1rem;
				height: 1.1rem;
			}
		}

		.signature {
			align-self: flex-end;
			align-items: flex-end;
			position: relative;
			top: calc(-1 * var(--title-wrap-offset, 0px));
			margin-top: 0.25rem;
			flex-direction: column;

			.circles-grid {
				order: 0;
				grid-template-columns: repeat(var(--signature-columns, 10), 0.35rem);
				grid-template-rows: repeat(var(--signature-rows, 4), 0.35rem);
				gap: clamp(0.85rem, 5vw, 1.25rem);

				.circle {
					width: 0.35rem;
					height: 0.35rem;
				}
			}

			p {
				align-self: flex-end;
				font-size: 2.75rem;
				margin: 0 0 0.75rem;
				text-align: right;
			}
		}
	}

	.aboutme-content {
		gap: 0.75rem;

		.text {
			font-size: 0.95rem;
			line-height: 1.7;
		}

		.tags {
			flex-wrap: wrap;
			gap: 0.5rem 0.75rem;
			line-height: 1.35;
		}
	}

	.recent-content {
		// min-height: 0;
	}

	.footpage-content {
		padding-bottom: 0;
		text-align: center;

		.signature {
			margin-top: 0;
			font-size: clamp(2.5rem, 14vw, 4rem);
			line-height: 1;
		}

		.footnote {
			font-size: 0.9rem;
			line-height: 1.5;
		}
	}
}
</style>
