---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import TextDecorations from '../components/TextDecorations.astro';
import { articles } from '../lib/articles';
import { recentGithubActivity } from '../lib/github';
import { friendLinks } from '../lib/friends';
import '../styles/global.scss';

const chapters = ['Prologue', 'About', 'Recent', 'Coda'];
// The About copy follows the GitHub profile README (github.com/tanhHeng/tanhHeng), as `about.astro` does.
// Its identity word cycles through these (`src/scripts/aboutIdentity.ts`). Keep them the same length: the
// word sits inline in the paragraph, so a longer one would reflow the lines around it.
const identities = ['深度学习爱好者', '开源工具开发者', '业余平面设计师'];
// Recent mixes articles with GitHub pushes and releases (one per repository), newest first.
const recentCount = 4;
// GitHub reports UTC times; show them on the author's calendar, like the article dates.
const githubDate = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Shanghai' });
// Commit messages and release names longer than this many characters end in an ellipsis; the full
// text stays in the link's tooltip.
const noteLimit = 40;
const shorten = (text: string) => {
	const characters = [...text];
	return characters.length > noteLimit ? `${characters.slice(0, noteLimit - 1).join('').trimEnd()}…` : text;
};
const recentEntries = [
	...articles.slice(0, recentCount).map((article) => ({
		title: article.title,
		url: article.url,
		date: article.date,
		timestamp: article.timestamp,
		kind: 'New Article',
		note: undefined,
		fullNote: undefined,
		external: false,
	})),
	...(await recentGithubActivity(recentCount)).map((activity) => ({
		title: `${activity.name} ${activity.kind === 'push' ? '开发' : '发布'}`,
		url: activity.url,
		date: githubDate.format(activity.timestamp),
		timestamp: activity.timestamp,
		kind: 'GitHub',
		note: shorten(activity.note),
		fullNote: activity.note,
		external: true,
	})),
]
	.sort((a, b) => b.date.localeCompare(a.date) || b.timestamp - a.timestamp)
	.slice(0, recentCount);
const formatIndex = (index: number) => String(index).padStart(2, '0');
// Two piano octaves; `true` marks a black key. Shared by the section sweep and the coda ornament.
const octave = [false, true, false, true, false, false, true, false, true, false, true, false];
const pianoKeys = [...octave, ...octave];
// Coda ornament: white keys stand apart; each black key straddles the gap after `whiteBefore` white keys.
let whiteCount = 0;
const codaKeys = pianoKeys.map((black, index) => {
	if (!black) whiteCount += 1;
	return { black, index, whiteBefore: whiteCount, friend: friendLinks[index % friendLinks.length] };
});
---

<BaseLayout title="TANH.MOE | Personal Blog" showFootnote={false}>
	<TextDecorations showLeft={false} />
	<nav class="chapter-rail" aria-label="Homepage chapters">
		<p class="chapter-cue"><span aria-hidden="true"></span>Scroll to explore</p>
		<ol>
			{chapters.map((chapter, index) => (
				<li>
					<a href={`#chapter-${index + 1}`} data-chapter-link={index} aria-current={index === 0 ? 'step' : undefined}>
						<span class="chapter-number">{formatIndex(index + 1)}</span>
						<span class="chapter-label">{chapter}</span>
					</a>
				</li>
			))}
		</ol>
	</nav>
	<div class="section-keys" aria-hidden="true">
		{pianoKeys.map((black) => <span class:list={['section-key', { 'is-black': black }]}></span>)}
	</div>
	<p class="chapter-numeral" aria-hidden="true" data-chapter-numeral>01</p>
	<div class="left-content">
		{chapters.map((chapter, index) => (
			<div class="scroll-snap-section" id={`chapter-${index + 1}`} aria-label={chapter}></div>
		))}
		<div class="left-container">
			<section class="main-content is-active">
				<div class="subtitle" data-reveal>
					<p>Welcome to</p>
					<img src="/svg/X.svg" alt="" />
					<img src="/svg/X.svg" alt="" />
					<img src="/svg/X.svg" alt="" />
				</div>
				<h1 class="title" data-reveal>tanh_Heng's Blog</h1>
				<div class="signature" data-reveal>
					<p>Life is Piano.</p>
					<div class="circles-grid">
						{Array.from({ length: 40 }).map(() => (
							<span class="circle"></span>
						))}
					</div>
				</div>
			</section>
			<section class="aboutme-content" hidden>
				<h2 class="title" data-reveal>About Me</h2>
				<p class="text" data-reveal>这里是 tanh丶桁～一名<span class="about-identity about-mark" aria-hidden="true" data-mark data-identities={JSON.stringify(identities)}><span class="about-identity-word">{identities[0]}</span></span><span class="about-identity-all">{identities.join('、')}</span>，在深度学习、软件开发、Minecraft 工具与平面设计之间探索，想把想象做成实用的系统、清晰的解释，以及<span class="about-mark" data-mark>认真打磨的界面</span>。<br>现在正在构建这座博客，主催社区协作的技术 Minecraft 教材 <a class="link-underline" href="https://techmc.wiki" target="_blank" rel="noreferrer" title="Graduate Texts in Minecraft">GTMC</a>，也在 <a class="link-underline" href="https://github.com/LazyAlienServer" target="_blank" rel="noreferrer">LazyAlienServer</a> 参与 Minecraft 服务端工具的建设。</p>
				<div class="tags" data-reveal>
					<p class="tag-title">language</p>
					{["python", "java", "typescript"].map((lang) => (
						<p class="tag" data-pop>{lang}</p>
					))}
				</div>
				<div class="tags" data-reveal>
					<p class="tag-title">interest</p>
					{["deep learning", "minecraft", "graphic design", "sleep", "eat"].map((interest) => (
						<p class="tag" data-pop>{interest}</p>
					))}
				</div>
				<span class="about-signature" role="img" aria-label="tanh_Heng" data-reveal></span>
			</section>
			<section class="recent-content" hidden>
				<div class="recent-heading" data-reveal>
					<h2 class="title">Recent</h2>
					<a class="recent-all link-underline" href="/articles">All articles</a>
				</div>
				{recentEntries.length > 0 ? (
					<ol class="recent-list">
						{recentEntries.map((entry, index) => (
							<li data-reveal>
								<a class="recent-container" href={entry.url} target={entry.external ? '_blank' : undefined} rel={entry.external ? 'noreferrer' : undefined} title={entry.note !== entry.fullNote ? entry.fullNote : undefined}>
									<span class="recent-index" aria-hidden="true"><span class="recent-index-text">{formatIndex(index + 1)}</span></span>
									<span class="recent-info">
										<span class="recent-title"><span class="recent-title-text">{entry.title}</span><span class="recent-arrow" aria-hidden="true">{entry.external ? '↗' : '→'}</span></span>
										<span class="recent-detail">
											<time datetime={entry.date}>{entry.date}</time>
											<span>{entry.kind}</span>
											{entry.note && <span class="recent-note">// {entry.note}</span>}
										</span>
									</span>
								</a>
							</li>
						))}
					</ol>
				) : (
					<p class="recent-empty" data-reveal>这里还没有动态。</p>
				)}
			</section>
			<section class="footpage-content" hidden>
				<nav class="coda-keys" aria-label="Friend links" data-reveal>
					{codaKeys.filter((key) => !key.black).map((key) => <a class="coda-white" href={key.friend.url} target="_blank" rel="noreferrer" style={`--key-index: ${key.index}; --white-index: ${key.whiteBefore - 1}`}><span class="key-friend">{key.friend.name}</span></a>)}
					{codaKeys.filter((key) => key.black).map((key) => <a class="coda-black" href={key.friend.url} target="_blank" rel="noreferrer" style={`--key-index: ${key.index}; --seam: ${key.whiteBefore}`}><span class="key-friend">{key.friend.name}</span></a>)}
				</nav>
				<p class="signature" data-reveal><span>Life is Piano.</span><span>You are Pianist.</span></p>
				<nav class="footnote-links" aria-label="Footer links" data-reveal>
					<a class="link-underline" href="mailto:contact@tanh.moe">Contact</a>
					<a class="link-underline" href="https://github.com/tanhHeng/blog" target="_blank" rel="noreferrer">GitHub</a>
					<a class="link-underline footnote-friend" href={friendLinks[0].url} target="_blank" rel="noreferrer" data-friend-rotator data-friends={JSON.stringify(friendLinks)}><span class="footnote-friend-name">{friendLinks[0].name}</span></a>
				</nav>
				<p class="footnote-copyright" data-reveal>Articles: <a class="link-underline" href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="noreferrer">CC BY-NC-SA 4.0</a> <span>/</span> Code: <a class="link-underline" href="https://gnu.net.cn/licenses/gpl-3.0.html" target="_blank" rel="noreferrer">GPL-3.0</a></p>
				<a class="coda-top link-underline" href="#chapter-1" data-chapter-link="0" data-reveal>Back to prologue ↑</a>
			</section>
		</div>
	</div>
	<svg class="circle-attraction-layer" aria-hidden="true" focusable="false">
		{Array.from({ length: 7 }).map(() => (
			<line class="circle-attraction-line" x1="0" y1="0" x2="0" y2="0"></line>
		))}
	</svg>
	<HeroSection />
</BaseLayout>

<script src="../scripts/home.js"></script>
<script src="../scripts/aboutIdentity.ts"></script>

<style scoped lang="scss">
@use '../styles/global.scss' as *;
@use '../styles/Navbar.scss' as navbar;

$signature-grid-width: calc(10 * 0.5rem + 10 * 2rem);
$signature-text-character-count: 14;
$signature-text-width: calc($signature-text-character-count * 0.265 * $font-size-title);
$signature-width: calc($signature-grid-width + 2rem + $signature-text-width);
$title-character-count: 16;
$aboutme-longest-line-character-count: 77;
$aboutme-line-width: calc($aboutme-longest-line-character-count * 0.6 * $font-size-content); // should be *0.8, do not change this line
$aboutme-content-max-width: calc(0.8 * $aboutme-line-width);
$home-mobile-boundary: calc(70.5vh + navbar.$navbar-margin-left + $signature-width - 100px);
$left-area-width: calc(100vw - 70.5vh + var(--hero-right-overflow, 0px));

html {
	overflow-x: hidden;
	overflow-y: scroll;
	scroll-snap-type: y mandatory;
}

body {
	overflow: visible;
}

p {
	margin: 0;
}

.left-container section[hidden] {
	display: none;
}

.left-content {
	position: relative;
	width: $left-area-width;
	margin-top: calc(-1 * navbar.$navbar-actual-height);
}

.scroll-snap-section {
	height: 100vh;
	scroll-snap-align: start;
	scroll-snap-stop: always;
}

.left-container {
	position: fixed;
	top: calc(navbar.$navbar-margin-vertical / 1.5);
	left: max(navbar.$navbar-margin-left, calc((100vw - 70.5vh + var(--hero-right-overflow, 0px) - 40rem) / 2));
	width: 40rem;
	height: 100vh;
	display: grid;
	align-items: center;
	justify-items: center;
	section {
		grid-area: 1 / 1;
		min-width: 0;
	}
	z-index: 2;
	pointer-events: none;

	// Only what reacts to the pointer takes it: links, the About tags (hover diamond), and the identity
	// word (held while hovered); the rest lets it through to the scroll sections beneath.
	section.is-active :is(a, .tag, .about-identity) {
		pointer-events: auto;
	}
}

.title {
	font-family: $font-family-default;
	font-size: $font-size-title;
	color: $home-title-color;
	margin: 0;
	font-weight: 500;
}

// Chapter rail: replaces the static "scroll to explore" ornament and doubles as section navigation.
.chapter-rail {
	position: fixed;
	top: navbar.$navbar-actual-height;
	left: navbar.$navbar-margin-left;
	z-index: 3;
	display: flex;
	flex-direction: column;
	gap: 0.85rem;
	color: $light-blue;
	font-family: $font-family-heading;
	letter-spacing: 0.12em;

	ol {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		display: flex;
		align-items: center;
		color: inherit;
		font-size: 0.82rem;
		text-decoration: none;
		transition: color 300ms ease-out;

		&:hover,
		&:focus-visible {
			color: $primary-blue;
		}

		&:focus-visible {
			outline: 1px solid currentColor;
			outline-offset: 0.3rem;
		}
	}

	.chapter-label {
		display: inline-flex;
		align-items: center;
		max-width: 0;
		overflow: hidden;
		opacity: 0;
		white-space: nowrap;
		transition:
			max-width 600ms cubic-bezier(0.16, 1, 0.3, 1),
			opacity 400ms ease-out;

		&::before {
			content: "";
			flex: none;
			width: 1.75rem;
			height: 1px;
			margin: 0 0.6rem;
			background: currentColor;
		}
	}

	a[aria-current="step"] {
		color: $primary-blue;

		.chapter-label {
			max-width: 9rem;
			opacity: 1;
		}
	}
}

.chapter-cue {
	display: flex;
	align-items: center;
	gap: 0.75rem;
	font-size: 0.72rem;
	text-transform: lowercase;

	span {
		position: relative;
		width: 2.5rem;
		height: 1px;
		overflow: hidden;
		background: $ex-light-blue;

		&::after {
			content: "";
			position: absolute;
			inset: 0;
			background: $primary-blue;
			transform: translateX(-100%);
			animation: chapter-cue 2.6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
		}
	}
}

@keyframes chapter-cue {
	60%,
	100% {
		transform: translateX(100%);
	}
}

// A Recent index square's ring: sounds at the square's edge and swells out as it fades.
@keyframes recent-index-ring {
	from {
		opacity: 0.9;
		transform: scale(1);
	}

	to {
		opacity: 0;
		transform: scale(1.9);
	}
}

// Outlined ghost numeral echoing the current chapter; sits behind the copy.
// The outline grows with the screen width (1px at 1200px wide, capped at 1.5px from 1800px); a fixed 1px reads
// as a broken hairline on large screens.
.chapter-numeral {
	position: fixed;
	top: 15vh;
	right: calc(70.5vh + navbar.$navbar-margin-left - var(--hero-right-overflow, 0px));
	z-index: 1;
	color: transparent;
	font-family: $font-family-default;
	font-size: clamp(9rem, 24vh, 16rem);
	line-height: 0.8;
	letter-spacing: -0.02em;
	-webkit-text-stroke: clamp(1px, 100vw / 1200, 1.5px) rgba($light-blue, 0.55);
	pointer-events: none;
	user-select: none;
}

.section-keys {
	position: fixed;
	inset: 0 auto 0 0;
	z-index: 1;
	display: flex;
	gap: 1px;
	width: $left-area-width;
	pointer-events: none;
}

.section-key {
	flex: 3;
	opacity: 0;
	background: linear-gradient(
		to bottom,
		rgba($ex-light-blue, 0),
		rgba($ex-light-blue, 0.7) 35%,
		rgba($ex-light-blue, 0.7) 65%,
		rgba($ex-light-blue, 0)
	);
	clip-path: inset(100% 0 0 0);
	will-change: clip-path, opacity;

	&.is-black {
		flex: 2;
		align-self: flex-start;
		height: 62%;
		background: linear-gradient(to bottom, rgba($light-blue, 0), rgba($light-blue, 0.38));
	}

	// Keys stretch across the full width on narrow layouts, so fewer keys keep them from becoming
	// slivers: 17 (through the next E, ending on a white key) up to 900px, one octave up to 720px.
	// Breakpoints reuse the site's narrow-layout (900px) and article card (720px) widths.
	// Hidden keys still receive the sweep classes harmlessly.
	@media (max-width: 900px) {
		&:nth-child(n + 18) {
			display: none;
		}
	}

	@media (max-width: 720px) {
		&:nth-child(n + 13) {
			display: none;
		}
	}
}

.main-content {
	display: flex;
	flex-direction: column;
	max-width: var(--main-content-max-width);
	scrollbar-width: none;

	&::-webkit-scrollbar {
		display: none;
	}
	.title {
		width: fit-content;
	}
	.subtitle {
		display: flex;
		gap: 1rem;
		p {
			font-family: $font-family-default;
			font-size: $font-size-larger-2;
			color: $primary-blue;
			margin: 0;
			line-height: 1;
		}
		img {
			width: $font-size-larger-2;
			height: $font-size-larger-2;
		}
	}
	.signature {
		display: flex;
		margin-top: 2rem;

		.circles-grid {
			display: grid;
			order: -1;
			grid-template-columns: repeat(10, 0.5rem);
			grid-template-rows: repeat(4, 0.5rem);
			gap: 2rem;

			// `--glow` (0–1) swells a dot near the pointer (up to 1.2×) and deepens it towards $light-blue;
			// `--wave` adds the ripples' and idle wave's colour on top, and `--wave-scale` the idle wave's swell
			// at half its value (ripples do not swell the dots). All are set by `src/scripts/home.js`.
			.circle {
				--glow: 0;
				--wave-scale: 0;
				--wave: 0;
				width: 0.5rem;
				height: 0.5rem;
				border-radius: 50%;
				background-color: color-mix(in srgb, $light-blue calc(min(1, var(--glow) + var(--wave)) * 100%), $ex-light-blue);
				scale: calc(1 + var(--glow) * 0.2 + var(--wave-scale) * 0.5);
			}
		}

		p {
			font-family: $font-family-special;
			font-size: $font-size-title;
			color: $light-blue;
			white-space: nowrap;
			margin-left: 2rem;
			margin-top: -0.5rem;
		}
	}
}

.circle-attraction-layer {
	position: fixed;
	inset: 0;
	z-index: 1;
	width: 100vw;
	height: 100vh;
	overflow: visible;
	pointer-events: none;
}

.circle-attraction-line {
	stroke: rgba(137, 146, 189, 0.8);
	stroke-width: 1;
	stroke-linecap: round;
	vector-effect: non-scaling-stroke;
	opacity: 0;
}

.aboutme-content {
	display: flex;
	flex-direction: column;
	max-width: $aboutme-content-max-width;
	width: 100%;
	gap: 1rem;

	.text {
		font-family: $font-family-default;
		font-weight: 500;
		font-size: $font-size-content;
		color: $content-color;
		line-height: 2;
		margin: 0;

		a {
			color: $primary-blue;
		}
	}

	// Keywords carry the navbar's light-blue stripe behind the lower part of the line; `home.js` sweeps it in
	// from the left once the paragraph has risen into place. On the identity it sits on the wrapper, not the
	// cycling words, so `aboutIdentity.ts` can blur the words without blurring it. Marks never break across
	// lines, so the sweep reads as one stroke.
	.about-mark {
		background: linear-gradient($ex-light-blue, $ex-light-blue) left bottom / 100% 45% no-repeat;
		white-space: nowrap;
	}

	// The wrapper stays inline: as an inline-block its box would be the whole 2em line, and its stripe, 45% of
	// that, thicker and lower than the other marks'. While the identity changes, `aboutIdentity.ts` sets the
	// leaving copy inline just before the new word, taking no room, so both share one baseline.
	:global(.about-identity-ghost) {
		pointer-events: none;
	}

	// Every identity at once for screen readers; the cycling word alone would hide all but one.
	.about-identity-all {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.tags {
		display: flex;
		align-items: left;
		gap: 1rem;
		margin: 0;
		color: $primary-blue;
		font-family: $font-family-heading;
		line-height: 1;

		.tag-title {
			font-weight: bold;
			margin: 0;
			transition: color 300ms ease-out;
		}

		// Hovering a tag sweeps the navbar's light-blue stripe in from the left behind its lower part; leaving
		// sweeps it out to the right (pinned right at rest, left on hover: a jump only `background-size`
		// transitions over). The rest of the row recedes meanwhile.
		.tag {
			font-weight: normal;
			margin: 0;
			background: linear-gradient($ex-light-blue, $ex-light-blue) right bottom / 0% 45% no-repeat;
			transition:
				background-size 420ms cubic-bezier(0.22, 1, 0.36, 1),
				opacity 300ms ease-out;
		}

		@media (hover: hover) {
			.tag:hover {
				background-position: left bottom;
				background-size: 100% 45%;
			}

			&:has(.tag:hover) {
				.tag:not(:hover) {
					opacity: 0.45;
				}

				.tag-title {
					color: $light-blue;
				}
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.tag,
			.tag-title {
				transition: none;
			}
		}
	}

	.about-signature {
		align-self: flex-end;
		width: 9.5rem;
		aspect-ratio: 366 / 164;
		margin-top: 0.25rem;
		// The SVG is used as a mask so the ink takes the palette colour instead of its own fill.
		background: $light-blue;
		mask: url("/svg/signature.svg") center / contain no-repeat;
	}
}

.recent-content {
	display: flex;
	flex-direction: column;
	gap: 1rem;
	width: min(100%, $aboutme-content-max-width);
	min-height: 16rem;

	.recent-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.recent-all {
		color: $primary-blue;
		font-family: $font-family-heading;
		font-size: 0.82rem;
		letter-spacing: 0.1em;
	}

	// Entries hang off a filled index square level with the title's first line; the date, kind and
	// commit note run beneath in the heading face. No rules between entries.
	.recent-list {
		display: flex;
		flex-direction: column;
		gap: 1.35rem;
		margin: 0.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.recent-container {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 1.1rem;
		color: inherit;
		font-size: $font-size-larger-1;
		text-decoration: none;

		// A square as tall as the title's first line (1.75em of 0.8em is its 1.4 line box). Hover turns it
		// into a diamond, the shape of the site's pointer cursor: it rotates 45deg while shrinking to
		// 2.2em across its diagonal, and the number undoes both so it stays upright and at size. A ring
		// sounds out from it, as the dot grid's ripples do; it restarts on every hover.
		.recent-index {
			position: relative;
			flex: none;
			width: 1.75em;
			height: 1.75em;
			color: #FFFFFF;
			background-color: $primary-blue;
			font-family: $font-family-heading;
			font-size: 0.8em;
			line-height: 1.75em;
			text-align: center;
			transition: transform 560ms cubic-bezier(0.34, 1.4, 0.64, 1);

			&::after {
				position: absolute;
				inset: 0;
				border: 1px solid $light-blue;
				content: '';
				opacity: 0;
				pointer-events: none;
			}
		}

		.recent-index-text {
			display: block;
			transition: transform 560ms cubic-bezier(0.34, 1.4, 0.64, 1);
		}

		.recent-info {
			display: flex;
			flex: 1;
			flex-direction: column;
			gap: 0.1rem;
			min-width: 0;
		}

		.recent-title {
			color: $content-color;
			font-family: $font-family-default;
			line-height: 1.4;
		}

		// Hover sweeps the navbar's light-blue stripe in from the left behind the lower part of the title,
		// on every line it wraps to, and sweeps it out to the right: the stripe is pinned to the right edge
		// at rest and to the left on hover, a jump only `background-size` transitions over.
		.recent-title-text {
			background: linear-gradient($ex-light-blue, $ex-light-blue) right bottom / 0% 45% no-repeat;
			box-decoration-break: clone;
			-webkit-box-decoration-break: clone;
			transition: background-size 420ms cubic-bezier(0.22, 1, 0.36, 1);
		}

		// Where the entry leads: `↗` leaves for GitHub, `→` stays on the site. Shown only on hover.
		.recent-arrow {
			display: inline-block;
			margin-left: 0.4em;
			color: $primary-blue;
			font-size: 0.8em;
			opacity: 0;
			transform: translateX(-0.4em);
			transition:
				opacity 240ms ease-out,
				transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
		}

		.recent-detail {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0 1.2rem;
			color: $light-blue;
			font-family: $font-family-heading;
			font-size: 0.8em;
			letter-spacing: 0.04em;
			line-height: 1.6;
		}

		// The note is a commit message or release name, not a label: the body face, not small caps.
		// Long ones are already cut to `noteLimit`; the CSS ellipsis covers narrow columns.
		.recent-note {
			overflow: hidden;
			min-width: 0;
			max-width: 100%;
			font-family: $font-family-default;
			font-size: 0.8em;
			letter-spacing: 0;
			transition: color 300ms ease-out;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		&:hover,
		&:focus-visible {
			.recent-index {
				transform: rotate(45deg) scale(0.889);

				&::after {
					animation: recent-index-ring 1000ms cubic-bezier(0.22, 1, 0.36, 1);
				}
			}

			.recent-index-text {
				transform: scale(1.125) rotate(-45deg);
			}

			.recent-title-text {
				background-position: left bottom;
				background-size: 100% 45%;
			}

			.recent-arrow {
				opacity: 1;
				transform: none;
			}

			.recent-note {
				color: $primary-blue;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.recent-index,
			.recent-index-text,
			.recent-title-text,
			.recent-arrow,
			.recent-note {
				transition: none;
			}

			&:hover,
			&:focus-visible {
				.recent-index::after {
					animation: none;
				}
			}
		}

		&:focus-visible {
			outline: 1px solid $primary-blue;
			outline-offset: 0.3rem;
		}
	}

	.recent-empty {
		color: $light-blue;
		font-size: $font-size-content;
	}
}

.footpage-content {
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 15rem;
  color: $light-blue;
  text-align: center;

  // White keys stand apart with a small gap; black keys straddle the gaps from the top. A ring in the
  // page colour keeps a narrow gap between each black key and the white keys around it.
  .coda-keys {
    --white-width: 0.75rem;
    --white-gap: 2px;
    position: relative;
    display: flex;
    gap: var(--white-gap);
    height: 3rem;

    > a {
      box-sizing: border-box;
      transition:
        transform 220ms ease-out,
        border-color 220ms ease-out,
        background-color 220ms ease-out;

      &:hover,
      &:focus-visible {
        z-index: 1;
        transform: translateY(3px);
        outline: none;
      }
    }

    // Friend name floats up out of the hovered key.
    .key-friend {
      position: absolute;
      bottom: calc(100% + 0.4rem);
      left: 50%;
      color: $primary-blue;
      font-family: $font-family-heading;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      translate: -50% 0.6rem;
      transition: opacity 260ms ease-out, translate 420ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    > a:hover .key-friend,
    > a:focus-visible .key-friend {
      opacity: 1;
      translate: -50% 0;
    }

    .coda-white {
      position: relative;
      width: var(--white-width);
      height: 100%;
      border: 1px solid $ex-light-blue;
	  border-bottom-left-radius: 3px;
	  border-bottom-right-radius: 3px;
      border-top: none;
      // Wave: keys dip left to right in turn while `home.js` sets `is-waving`, one pass at a time.
      // Uses `translate` so it composes with the hover `transform`.
    }

    &.is-waving .coda-white {
      animation: coda-wave 640ms ease-in-out calc(var(--white-index) * 90ms);
    }

    .coda-black {
      position: absolute;
      // Above white keys even while a hovered white key is lifted to z-index 1.
      z-index: 2;
      top: 0;
      left: calc(var(--seam) * (var(--white-width) + var(--white-gap)) - var(--white-gap) / 2);
      width: calc(var(--white-width) * 0.7);
      height: 65%;
      background: $light-blue;
      box-shadow: 0 0 0 2px #fff;
	  border-bottom-left-radius: 1px;
	  border-bottom-right-radius: 1px;
      translate: -50% 0;
    }

    .coda-white:hover,
    .coda-white:focus-visible {
      border-color: $primary-blue;
    }

    .coda-black:hover,
    .coda-black:focus-visible {
      background: $primary-blue;
    }
  }

  @keyframes coda-wave {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 3px;
      border-color: $light-blue;
    }
  }

  .signature {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.65rem;
    width: fit-content;
    max-width: 100%;
    margin: 2rem 0 0.5rem;
    color: $primary-blue;
    font-family: $font-family-special;
    font-size: 4rem;
    line-height: 1;

    span {
      white-space: nowrap;

      &:first-child {
        margin-right: auto;
      }

      &:last-child {
        margin-left: auto;
      }
    }
  }

  .footnote-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1rem;
    margin-bottom: 0.7rem;

    a {
      color: $primary-blue;
      font-family: $font-family-heading;
      font-size: 0.82rem;
      letter-spacing: 0.06em;
      transition: color 180ms ease-out;
    }

    // The script pins `width` to the measured name width, so neighbours slide instead of jumping.
    .footnote-friend {
      display: none;
      white-space: nowrap;
      transition: color 180ms ease-out, width 420ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .footnote-friend-name {
      display: inline-block;
    }
  }

  .footnote-copyright {
    font-size: 0.82rem;
    letter-spacing: 0.04em;

    span {
      color: $ex-light-blue;
      padding: 0 0.45rem;
    }

    a {
      color: inherit;
    }
  }

  .coda-top {
    margin-top: 2.25rem;
    color: $primary-blue;
    font-family: $font-family-heading;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }
}

@media (max-width: 900px) {
  // On phones the keyboard is too small to play; friends rotate through the footer link instead.
  // On wider screens the keyboard is the only friend-link entry.
  .footpage-content {
    .coda-keys {
      display: none;
    }

    // Same specificity as the base `.footnote-links .footnote-friend { display: none }` so it wins.
    .footnote-links .footnote-friend {
      display: inline-block;
    }
  }

  .footpage-content {
    min-height: 12rem;

    .footnote-copyright {
      font-size: 0.7rem;
    }
  }
}

@media (min-width: 901px) and (max-width: 1200px) {
	.left-container {
		left: max(1rem, navbar.$navbar-margin-left);
		width: min(40rem, calc(100vw - 70.5vh + var(--hero-right-overflow, 0px) - 2rem));
		min-width: 0;
	}
}

// Shared by the narrow-viewport media query and the runtime `html.home-mobile-layout` class set by HeroSection.
@mixin home-mobile-layout {
	.left-content,
	.section-keys {
		width: 100%;
	}

	.left-content {
		margin-top: 0;
	}

	.chapter-numeral {
		display: none;
	}

	.chapter-rail {
		top: auto;
		bottom: 1.25rem;
		left: 50%;
		transform: translateX(-50%);

		.chapter-cue {
			display: none;
		}

		a {
			font-size: 0.72rem;
		}
	}

	.left-container {
		top: 0;
		left: 0;
		box-sizing: border-box;
		width: 100%;
		height: 100dvh;
		padding: (6.5rem - navbar.$navbar-margin-vertical) 1.25rem 3.5rem;
		align-items: center;

		section {
			max-height: calc(100dvh - #{10rem - navbar.$navbar-margin-vertical});
			overflow-y: auto;

			// Set by the transition script while rows are displaced; the margin keeps blur and travel unclipped.
			&.is-animating {
				overflow: clip;
				overflow-clip-margin: 3rem;
			}
		}
	}

	.title {
		font-size: clamp(2.25rem, 12vw, 3.25rem);
		line-height: 1.1;
	}

	.main-content {
		.subtitle {
			gap: 0.6rem;

			p {
				font-size: 1.1rem;
			}

			img {
				width: 1.1rem;
				height: 1.1rem;
			}
		}

		.signature {
			align-self: flex-end;
			align-items: flex-end;
			position: relative;
			top: calc(-1 * var(--title-wrap-offset, 0px));
			margin-top: 0.25rem;
			flex-direction: column;

			.circles-grid {
				order: 0;
				grid-template-columns: repeat(var(--signature-columns, 10), 0.35rem);
				grid-template-rows: repeat(var(--signature-rows, 4), 0.35rem);
				gap: clamp(0.85rem, 5vw, 1.25rem);

				.circle {
					width: 0.35rem;
					height: 0.35rem;
				}
			}

			p {
				align-self: flex-end;
				font-size: 2.75rem;
				margin: 0 0 0.75rem;
				text-align: right;
			}
		}
	}

	.aboutme-content {
		gap: 0.75rem;

		.text {
			font-size: 0.95rem;
			line-height: 1.7;
		}

		.tags {
			flex-wrap: wrap;
			gap: 0.5rem 0.75rem;
			line-height: 1.35;
		}

		.about-signature {
			width: 7.5rem;
		}
	}

	.recent-content .recent-container {
		font-size: 1.05rem;
	}

	.footpage-content {
		// The hover underline of "Back to prologue" hangs 0.2rem below the text; keep it inside the
		// scrolling section so revealing it does not create overflow.
		padding-bottom: 0.5rem;
		text-align: center;

		// Sections scroll (`overflow-y: auto`) in this layout, which clips the friend name floating above
		// the keys; reserve room for it inside the section.
		.coda-keys {
			margin-top: 1.75rem;
		}

		.signature {
			margin-top: 1.5rem;
			font-size: clamp(2.5rem, 14vw, 4rem);
			line-height: 1;
		}
	}
}

@media (max-width: 900px), (min-width: 901px) and (max-width: $home-mobile-boundary) {
	:global(html) {
		--home-mobile-layout: 1;
	}

	@include home-mobile-layout;
}

:global(html.home-mobile-layout) {
	@include home-mobile-layout;
}

@media (prefers-reduced-motion: reduce) {
	.section-keys {
		display: none;
	}

	.chapter-cue span::after {
		animation: none;
		transform: none;
	}

	.chapter-rail .chapter-label,
	.footpage-content .coda-keys > a {
		transition: none;
	}

	.footpage-content .coda-keys .coda-white {
		animation: none;
	}
}
