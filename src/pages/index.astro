---
import PageLayout from '../layouts/PageLayout.astro';
import { articles } from '../lib/articles';
import '../styles/global.scss';

const chapters = ['Prologue', 'About', 'Recent', 'Coda'];
const recentArticles = articles.slice(0, 3);
const formatIndex = (index: number) => String(index).padStart(2, '0');
// Two piano octaves; `true` marks a black key. Shared by the section sweep and the coda ornament.
const octave = [false, true, false, true, false, false, true, false, true, false, true, false];
const pianoKeys = [...octave, ...octave];
// Friend links played by the coda keys; keys cycle through the list in keyboard order.
const friendLinks = [
	{ name: '4rcadia', url: 'https://blog.arcadia.moe' },
	{ name: 'BFladderbean', url: 'https://bfladderbean.me' },
	{ name: 'Tianya', url:'https://tianya.martianya.cloud/'},
	{ name: 'InkBai', url:'https://inkbai.fun/'}
];
// Coda ornament: white keys stand apart; each black key straddles the gap after `whiteBefore` white keys.
let whiteCount = 0;
const codaKeys = pianoKeys.map((black, index) => {
	if (!black) whiteCount += 1;
	return { black, index, whiteBefore: whiteCount, friend: friendLinks[index % friendLinks.length] };
});
---

<PageLayout title="TANH.MOE | Personal Blog" showFootnote={false} showLeftText={false}>
	<nav class="chapter-rail" aria-label="Homepage chapters">
		<p class="chapter-cue"><span aria-hidden="true"></span>Scroll to explore</p>
		<ol>
			{chapters.map((chapter, index) => (
				<li>
					<a href={`#chapter-${index + 1}`} data-chapter-link={index} aria-current={index === 0 ? 'step' : undefined}>
						<span class="chapter-number">{formatIndex(index + 1)}</span>
						<span class="chapter-label">{chapter}</span>
					</a>
				</li>
			))}
		</ol>
	</nav>
	<div class="section-keys" aria-hidden="true">
		{pianoKeys.map((black) => <span class:list={['section-key', { 'is-black': black }]}></span>)}
	</div>
	<p class="chapter-numeral" aria-hidden="true" data-chapter-numeral>01</p>
	<div class="left-content">
		{chapters.map((chapter, index) => (
			<div class="scroll-snap-section" id={`chapter-${index + 1}`} aria-label={chapter}></div>
		))}
		<div class="left-container">
			<section class="main-content is-active">
				<div class="subtitle" data-reveal>
					<p>Welcome to</p>
					<img src="/svg/X.svg" alt="" />
					<img src="/svg/X.svg" alt="" />
					<img src="/svg/X.svg" alt="" />
				</div>
				<h1 class="title" data-reveal>tanh_Heng's Blog</h1>
				<div class="signature" data-reveal>
					<p>Life is Piano.</p>
					<div class="circles-grid">
						{Array.from({ length: 40 }).map(() => (
							<span class="circle"></span>
						))}
					</div>
				</div>
				<a class="prologue-link" href="/articles" data-reveal>
					<span class="prologue-link-rule" aria-hidden="true"></span>
					<span class="prologue-link-text">Enter the archive</span>
					<span class="prologue-link-count">{formatIndex(articles.length)} {articles.length === 1 ? 'article' : 'articles'}</span>
				</a>
			</section>
			<section class="aboutme-content" hidden>
				<h2 class="title" data-reveal>About Me</h2>
				<p class="text" data-reveal>这里是 tanh丶桁~一名深度学习爱好者，同时也是业余平面设计师，在代码、算法与视觉之间反复横跳的交叉领域探索者。<br>我热衷于用技术解决实际问题，也用设计表达技术背后的温度。GitHub 是我沉淀技术思考、与社区协作共创的地方——你看到的每个仓库都是我某一领域的实践痕迹。</p>
				<div class="tags" data-reveal>
					<p class="tag-title">language</p>
					{["python", "java"].map((lang) => (
						<p class="tag">{lang}</p>
					))}
				</div>
				<div class="tags" data-reveal>
					<p class="tag-title">interest</p>
					{["sleep", "eat", "graphic design", "deep learning"].map((interest) => (
						<p class="tag">{interest}</p>
					))}
				</div>
				<span class="about-signature" role="img" aria-label="tanh_Heng" data-reveal></span>
			</section>
			<section class="recent-content" hidden>
				<div class="recent-heading" data-reveal>
					<h2 class="title">Recent</h2>
					<a class="recent-all link-underline" href="/articles">All articles</a>
				</div>
				{recentArticles.length > 0 ? (
					<ol class="recent-list">
						{recentArticles.map((article, index) => (
							<li data-reveal>
								<a class="recent-container" href={article.url}>
									<span class="recent-index">{formatIndex(index + 1)}</span>
									<span class="recent-info">
										<span class="recent-title">{article.title}</span>
										<span class="recent-detail">
											<time datetime={article.date}>{article.date.replaceAll('-', '.')}</time>
											{article.readingTime && <span>{article.readingTime}</span>}
											{[...article.tags.values()].slice(0, 2).map((tag) => <span class="recent-tag">{tag}</span>)}
										</span>
										{article.description && <span class="recent-description">{article.description}</span>}
									</span>
									<span class="recent-arrow" aria-hidden="true">→</span>
								</a>
							</li>
						))}
					</ol>
				) : (
					<p class="recent-empty" data-reveal>这里还没有文章。</p>
				)}
			</section>
			<section class="footpage-content" hidden>
				<nav class="coda-keys" aria-label="Friend links" data-reveal>
					{codaKeys.filter((key) => !key.black).map((key) => <a class="coda-white" href={key.friend.url} target="_blank" rel="noreferrer" style={`--key-index: ${key.index}; --white-index: ${key.whiteBefore - 1}`}><span class="key-friend">{key.friend.name}</span></a>)}
					{codaKeys.filter((key) => key.black).map((key) => <a class="coda-black" href={key.friend.url} target="_blank" rel="noreferrer" style={`--key-index: ${key.index}; --seam: ${key.whiteBefore}`}><span class="key-friend">{key.friend.name}</span></a>)}
				</nav>
				<p class="signature" data-reveal><span>Life is Piano.</span><span>You are Pianist.</span></p>
				<nav class="footnote-links" aria-label="Footer links" data-reveal>
					<a class="link-underline" href="mailto:contact@tanh.moe">Contact</a>
					<a class="link-underline" href="https://github.com/tanhHeng/blog" target="_blank" rel="noreferrer">GitHub</a>
					<a class="link-underline footnote-friend-static" href="https://blog.arcadia.moe" target="_blank" rel="noreferrer">4rcadia</a>
					<a class="link-underline footnote-friend" href={friendLinks[0].url} target="_blank" rel="noreferrer" data-friend-rotator data-friends={JSON.stringify(friendLinks)}><span class="footnote-friend-name">{friendLinks[0].name}</span></a>
				</nav>
				<p class="footnote-copyright" data-reveal>Articles: <a class="link-underline" href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="noreferrer">CC BY-NC-SA 4.0</a> <span>/</span> Code: <a class="link-underline" href="https://gnu.net.cn/licenses/gpl-3.0.html" target="_blank" rel="noreferrer">GPL-3.0</a></p>
				<a class="coda-top link-underline" href="#chapter-1" data-chapter-link="0" data-reveal>Back to prologue ↑</a>
			</section>
		</div>
	</div>
	<svg class="circle-attraction-layer" aria-hidden="true" focusable="false">
		{Array.from({ length: 7 }).map(() => (
			<line class="circle-attraction-line" x1="0" y1="0" x2="0" y2="0"></line>
		))}
	</svg>
</PageLayout>

<script src="../scripts/home.js"></script>

<style scoped lang="scss">
@use '../styles/global.scss' as *;
@use '../styles/Navbar.scss' as navbar;

$signature-grid-width: calc(10 * 0.5rem + 10 * 2rem);
$signature-text-character-count: 14;
$signature-text-width: calc($signature-text-character-count * 0.265 * $font-size-title);
$signature-width: calc($signature-grid-width + 2rem + $signature-text-width);
$title-character-count: 16;
$aboutme-longest-line-character-count: 77;
$aboutme-line-width: calc($aboutme-longest-line-character-count * 0.6 * $font-size-content); // should be *0.8, do not change this line
$aboutme-content-max-width: calc(0.8 * $aboutme-line-width);
$home-mobile-boundary: calc(70.5vh + navbar.$navbar-margin-left + $signature-width - 100px);
$left-area-width: calc(100vw - 70.5vh + var(--hero-right-overflow, 0px));

html {
	overflow-x: hidden;
	overflow-y: scroll;
	scroll-snap-type: y mandatory;
}

body {
	overflow: visible;
}

p {
	margin: 0;
}

.left-container section[hidden] {
	display: none;
}

.left-content {
	position: relative;
	width: $left-area-width;
	margin-top: calc(-1 * navbar.$navbar-actual-height);
}

.scroll-snap-section {
	height: 100vh;
	scroll-snap-align: start;
	scroll-snap-stop: always;
}

.left-container {
	position: fixed;
	top: calc(navbar.$navbar-margin-vertical / 1.5);
	left: max(navbar.$navbar-margin-left, calc((100vw - 70.5vh + var(--hero-right-overflow, 0px) - 40rem) / 2));
	width: 40rem;
	height: 100vh;
	display: grid;
	align-items: center;
	justify-items: center;
	section {
		grid-area: 1 / 1;
		min-width: 0;
	}
	z-index: 2;
	pointer-events: none;

	section.is-active a {
		pointer-events: auto;
	}
}

.title {
	font-family: $font-family-default;
	font-size: $font-size-title;
	color: $home-title-color;
	margin: 0;
	font-weight: 500;
}

// Chapter rail: replaces the static "scroll to explore" ornament and doubles as section navigation.
.chapter-rail {
	position: fixed;
	top: navbar.$navbar-actual-height;
	left: navbar.$navbar-margin-left;
	z-index: 3;
	display: flex;
	flex-direction: column;
	gap: 0.85rem;
	color: $light-blue;
	font-family: $font-family-heading;
	letter-spacing: 0.12em;

	ol {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		display: flex;
		align-items: center;
		color: inherit;
		font-size: 0.82rem;
		text-decoration: none;
		transition: color 300ms ease-out;

		&:hover,
		&:focus-visible {
			color: $primary-blue;
		}

		&:focus-visible {
			outline: 1px solid currentColor;
			outline-offset: 0.3rem;
		}
	}

	.chapter-label {
		display: inline-flex;
		align-items: center;
		max-width: 0;
		overflow: hidden;
		opacity: 0;
		white-space: nowrap;
		transition:
			max-width 600ms cubic-bezier(0.16, 1, 0.3, 1),
			opacity 400ms ease-out;

		&::before {
			content: "";
			flex: none;
			width: 1.75rem;
			height: 1px;
			margin: 0 0.6rem;
			background: currentColor;
		}
	}

	a[aria-current="step"] {
		color: $primary-blue;

		.chapter-label {
			max-width: 9rem;
			opacity: 1;
		}
	}
}

.chapter-cue {
	display: flex;
	align-items: center;
	gap: 0.75rem;
	font-size: 0.72rem;
	text-transform: lowercase;

	span {
		position: relative;
		width: 2.5rem;
		height: 1px;
		overflow: hidden;
		background: $ex-light-blue;

		&::after {
			content: "";
			position: absolute;
			inset: 0;
			background: $primary-blue;
			transform: translateX(-100%);
			animation: chapter-cue 2.6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
		}
	}
}

@keyframes chapter-cue {
	60%,
	100% {
		transform: translateX(100%);
	}
}

// Outlined ghost numeral echoing the current chapter; sits behind the copy.
.chapter-numeral {
	position: fixed;
	top: 15vh;
	right: calc(70.5vh + navbar.$navbar-margin-left - var(--hero-right-overflow, 0px));
	z-index: 1;
	color: transparent;
	font-family: $font-family-default;
	font-size: clamp(9rem, 24vh, 16rem);
	line-height: 0.8;
	letter-spacing: -0.02em;
	-webkit-text-stroke: 1px rgba($light-blue, 0.55);
	pointer-events: none;
	user-select: none;
}

.section-keys {
	position: fixed;
	inset: 0 auto 0 0;
	z-index: 1;
	display: flex;
	gap: 1px;
	width: $left-area-width;
	pointer-events: none;
}

.section-key {
	flex: 3;
	opacity: 0;
	background: linear-gradient(
		to bottom,
		rgba($ex-light-blue, 0),
		rgba($ex-light-blue, 0.7) 35%,
		rgba($ex-light-blue, 0.7) 65%,
		rgba($ex-light-blue, 0)
	);
	clip-path: inset(100% 0 0 0);
	will-change: clip-path, opacity;

	&.is-black {
		flex: 2;
		align-self: flex-start;
		height: 62%;
		background: linear-gradient(to bottom, rgba($light-blue, 0), rgba($light-blue, 0.38));
	}

	// Keys stretch across the full width on narrow layouts, so fewer keys keep them from becoming
	// slivers: 17 (through the next E, ending on a white key) up to 900px, one octave up to 720px.
	// Breakpoints reuse the site's narrow-layout (900px) and article card (720px) widths.
	// Hidden keys still receive the sweep classes harmlessly.
	@media (max-width: 900px) {
		&:nth-child(n + 18) {
			display: none;
		}
	}

	@media (max-width: 720px) {
		&:nth-child(n + 13) {
			display: none;
		}
	}
}

.main-content {
	display: flex;
	flex-direction: column;
	max-width: var(--main-content-max-width);
	scrollbar-width: none;

	&::-webkit-scrollbar {
		display: none;
	}
	.title {
		width: fit-content;
	}
	.subtitle {
		display: flex;
		gap: 1rem;
		p {
			font-family: $font-family-default;
			font-size: $font-size-larger-2;
			color: $primary-blue;
			margin: 0;
			line-height: 1;
		}
		img {
			width: $font-size-larger-2;
			height: $font-size-larger-2;
		}
	}
	.signature {
		display: flex;
		margin-top: 2rem;

		.circles-grid {
			display: grid;
			order: -1;
			grid-template-columns: repeat(10, 0.5rem);
			grid-template-rows: repeat(4, 0.5rem);
			gap: 2rem;

			.circle {
				width: 0.5rem;
				height: 0.5rem;
				border-radius: 50%;
				background-color: $ex-light-blue;
			}
		}

		p {
			font-family: $font-family-special;
			font-size: $font-size-title;
			color: $light-blue;
			white-space: nowrap;
			margin-left: 2rem;
			margin-top: -0.5rem;
		}
	}
}

.prologue-link {
	display: inline-flex;
	align-self: flex-start;
	align-items: baseline;
	gap: 0.9rem;
	margin-top: 2.75rem;
	color: $primary-blue;
	font-family: $font-family-heading;
	font-size: 0.9rem;
	letter-spacing: 0.12em;
	text-decoration: none;

	.prologue-link-rule {
		align-self: center;
		width: 2.5rem;
		height: 1px;
		background: currentColor;
		transition: width 420ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.prologue-link-count {
		color: $light-blue;
		font-size: 0.72rem;
	}

	&:hover .prologue-link-rule,
	&:focus-visible .prologue-link-rule {
		width: 4.5rem;
	}

	&:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.4rem;
	}
}

.circle-attraction-layer {
	position: fixed;
	inset: 0;
	z-index: 1;
	width: 100vw;
	height: 100vh;
	overflow: visible;
	pointer-events: none;
}

.circle-attraction-line {
	stroke: rgba(137, 146, 189, 0.8);
	stroke-width: 1;
	stroke-linecap: round;
	vector-effect: non-scaling-stroke;
	opacity: 0;
}

.aboutme-content {
	display: flex;
	flex-direction: column;
	max-width: $aboutme-content-max-width;
	width: 100%;
	gap: 1rem;

	.text {
		font-family: $font-family-default;
		font-weight: 500;
		font-size: $font-size-content;
		color: $content-color;
		line-height: 2;
		margin: 0;
	}

	.tags {
		display: flex;
		align-items: left;
		gap: 1rem;
		margin: 0;
		color: $primary-blue;
		font-family: $font-family-heading;
		line-height: 1;

		.tag-title {
			font-weight: bold;
			margin: 0;
		}

		.tag {
			font-weight: normal;
			margin: 0;
		}
	}

	.about-signature {
		align-self: flex-end;
		width: 9.5rem;
		aspect-ratio: 366 / 164;
		margin-top: 0.25rem;
		// The SVG is used as a mask so the ink takes the palette colour instead of its own fill.
		background: $light-blue;
		mask: url("/svg/signature.svg") center / contain no-repeat;
	}
}

.recent-content {
	display: flex;
	flex-direction: column;
	gap: 1rem;
	width: min(100%, $aboutme-content-max-width);
	min-height: 16rem;

	.recent-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.recent-all {
		color: $primary-blue;
		font-family: $font-family-heading;
		font-size: 0.82rem;
		letter-spacing: 0.1em;
	}

	.recent-list {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		border-top: 1px solid $ex-light-blue;
		list-style: none;
	}

	.recent-container {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 1rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid $ex-light-blue;
		color: inherit;
		font-size: $font-size-larger-1;
		text-decoration: none;

		.recent-index {
			flex: none;
			font-family: $font-family-default;
			width: 2rem;
			height: 2rem;
			line-height: 2rem;
			text-align: center;
			color: #FFFFFF;
			background-color: $primary-blue;
			transition: background-color 300ms ease-out;
		}

		.recent-info {
			display: flex;
			flex: 1;
			flex-direction: column;
			gap: 0.35rem;
			min-width: 0;
		}

		.recent-title {
			font-family: $font-family-default;
			color: $content-color;
			font-weight: 500;
			line-height: 1.3;
		}

		.recent-detail {
			display: flex;
			flex-wrap: wrap;
			flex-direction: row;
			gap: 0 1rem;
			font-size: $font-size-content;
			color: $light-blue;
			line-height: 1.6;
		}

		.recent-tag {
			font-family: $font-family-heading;
			font-size: 0.85rem;
			letter-spacing: 0.06em;
		}

		.recent-description {
			overflow: hidden;
			color: $content-color;
			font-size: 0.9rem;
			line-height: 1.7;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.recent-arrow {
			align-self: center;
			color: $light-blue;
			transition:
				color 300ms ease-out,
				transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
		}

		&:hover,
		&:focus-visible {
			.recent-index {
				background-color: $content-color;
			}

			.recent-arrow {
				color: $primary-blue;
				transform: translateX(0.5rem);
			}
		}

		&:focus-visible {
			outline: 1px solid $primary-blue;
			outline-offset: 0.3rem;
		}
	}

	.recent-empty {
		color: $light-blue;
		font-size: $font-size-content;
	}
}

.footpage-content {
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 15rem;
  color: $light-blue;
  text-align: center;

  // White keys stand apart with a small gap; black keys straddle the gaps from the top. A ring in the
  // page colour keeps a narrow gap between each black key and the white keys around it.
  .coda-keys {
    --white-width: 0.75rem;
    --white-gap: 2px;
    position: relative;
    display: flex;
    gap: var(--white-gap);
    height: 3rem;

    > a {
      box-sizing: border-box;
      transition:
        transform 220ms ease-out,
        border-color 220ms ease-out,
        background-color 220ms ease-out;

      &:hover,
      &:focus-visible {
        z-index: 1;
        transform: translateY(3px);
        outline: none;
      }
    }

    // Friend name floats up out of the hovered key.
    .key-friend {
      position: absolute;
      bottom: calc(100% + 0.4rem);
      left: 50%;
      color: $primary-blue;
      font-family: $font-family-heading;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      translate: -50% 0.6rem;
      transition: opacity 260ms ease-out, translate 420ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    > a:hover .key-friend,
    > a:focus-visible .key-friend {
      opacity: 1;
      translate: -50% 0;
    }

    .coda-white {
      position: relative;
      width: var(--white-width);
      height: 100%;
      border: 1px solid $ex-light-blue;
	  border-bottom-left-radius: 3px;
	  border-bottom-right-radius: 3px;
      border-top: none;
      // Wave: keys dip left to right in turn while `home.js` sets `is-waving`, one pass at a time.
      // Uses `translate` so it composes with the hover `transform`.
