---
interface Props {
  minRadius?: number;
  maxRadius?: number;
  minOrbitOffset?: number;
  maxOrbitOffset?: number;
  useMask?: boolean;
}

const {
  minRadius = 7,
  maxRadius = 20,
  minOrbitOffset = 20,
  maxOrbitOffset = 50,
  useMask = true
} = Astro.props;
---

<div class={useMask ? "dynamic-circles-container with-mask" : "dynamic-circles-container"} id="circles-container" data-min-radius={minRadius} data-max-radius={maxRadius} data-min-orbit-offset={minOrbitOffset} data-max-orbit-offset={maxOrbitOffset} transition:persist="dynamic-circles">
  <div class="dynamic-circle" style={`
    width: 100vw;
    height: 140vh;
    background: radial-gradient(
      circle at center,
      rgba(137, 146, 189, 0.25) 0%,
      rgba(137, 146, 189, 0.15) 80%,
      rgba(137, 146, 189, 0) 100%
    );
    --x: 35vw;
    --y: 50vh;
    --radius: 0;
    --orbit-offset-x: 0;
    --orbit-offset-y: 0;
    --opacity: 0.2;
    --duration: 0s;
    --direction: normal;
  `}/>
  <div class="dynamic-circle mouse-circle" id="mask-mouse-circle" style={`
    background: radial-gradient(
      circle at center,
      rgba(137, 146, 189, var(--opacity)) 0%,
      rgba(137, 146, 189, 1) 50%,
      rgba(137, 146, 189, 0.5) 60%,
      rgba(137, 146, 189, 0) 100%
    );
    --x: 50vw;
    --y: 50vh;
    --radius: 1.6rem;
    --orbit-offset-x: 0;
    --orbit-offset-y: 0;
    --opacity: 1;
    --duration: 0s;
    --direction: normal;
  `}/>
</div>

<script>
  import { onPageLoad } from '../lib/pageLifecycle';

  onPageLoad((scope) => {
    const container = document.getElementById('circles-container');
    if (!container) return;
    if (!container.dataset.generated) {
    const minRadius = Number.parseFloat(container.dataset.minRadius ?? '7');
    const maxRadius = Number.parseFloat(container.dataset.maxRadius ?? '20');
    const minOrbitOffset = Number.parseFloat(container.dataset.minOrbitOffset ?? '20');
    const maxOrbitOffset = Number.parseFloat(container.dataset.maxOrbitOffset ?? '50');
    const circleCount = Math.floor(Math.random() * 7) + 12;
    const rightBoundary = 70.5;
    const circles: { id: number; x: number; y: number; radius: number; orbitOffset: number; orbitOffsetX: number; orbitOffsetY: number; opacity: number; duration: number; direction: string }[] = [];

    function isPointInCircle(px: number, py: number, cx: number, cy: number, r: number) {
      const dx = px - cx;
      const dy = py - cy;
      return dx * dx + dy * dy < r * r;
    }

    function distance(x1: number, y1: number, x2: number, y2: number) {
      return Math.hypot(x1 - x2, y1 - y2);
    }

    function canIntersectDuringRotation(x1: number, y1: number, r1: number, orbitOffset1: number, x2: number, y2: number, r2: number, orbitOffset2: number) {
      return distance(x1, y1, x2, y2) <= orbitOffset1 + r1 + orbitOffset2 + r2;
    }

    function countIntersections(x: number, y: number, r: number, orbitOffset: number, existingCircles: typeof circles) {
      return existingCircles.filter((circle) => canIntersectDuringRotation(x, y, r, orbitOffset, circle.x, circle.y, circle.radius, circle.orbitOffset)).length;
    }

    function wouldCauseExistingToExceedLimit(x: number, y: number, r: number, orbitOffset: number, existingCircles: typeof circles) {
      for (const circle of existingCircles) {
        if (!canIntersectDuringRotation(x, y, r, orbitOffset, circle.x, circle.y, circle.radius, circle.orbitOffset)) continue;
        const existingIntersections = existingCircles.filter((other) => other.id !== circle.id && canIntersectDuringRotation(circle.x, circle.y, circle.radius, circle.orbitOffset, other.x, other.y, other.radius, other.orbitOffset)).length;
        if (existingIntersections >= 3) return true;
      }
      return false;
    }

    function isOrbitCenterInsideSweptArea(x: number, y: number, existingCircles: typeof circles) {
      return existingCircles.some((circle) => isPointInCircle(x, y, circle.x, circle.y, circle.orbitOffset + circle.radius));
    }

    function wouldContainExistingOrbitCenter(x: number, y: number, r: number, orbitOffset: number, existingCircles: typeof circles) {
      return existingCircles.some((circle) => isPointInCircle(circle.x, circle.y, x, y, orbitOffset + r));
    }

    for (let id = 0; id < circleCount; id++) {
      let attempts = 0;
      let validPosition = false;
      let x = 0;
      let y = 0;
      let radius = 0;
      let orbitOffset = 0;
      while (!validPosition && attempts < 100) {
        attempts++;
        radius = Math.random() * (maxRadius - minRadius) + minRadius;
        orbitOffset = ((Math.random() * (maxOrbitOffset - minOrbitOffset) + minOrbitOffset) / 100) * radius;
        x = Math.random() * rightBoundary;
        y = Math.random() * 100;
        validPosition = !isOrbitCenterInsideSweptArea(x, y, circles) && !wouldContainExistingOrbitCenter(x, y, radius, orbitOffset, circles) && countIntersections(x, y, radius, orbitOffset, circles) <= 3 && !wouldCauseExistingToExceedLimit(x, y, radius, orbitOffset, circles);
      }
      if (!validPosition) continue;
      const orbitAngle = Math.random() * Math.PI * 2;
      circles.push({
        id,
        x,
        y,
        radius,
        orbitOffset,
        orbitOffsetX: Math.cos(orbitAngle) * orbitOffset,
        orbitOffsetY: Math.sin(orbitAngle) * orbitOffset,
        opacity: Math.random() * 0.35 + 0.25,
        duration: Math.random() * 7 + 3,
        direction: Math.random() < 0.5 ? 'normal' : 'reverse',
      });
    }

    const mouseCircle = container.querySelector('#mask-mouse-circle');
    circles.forEach((circle) => {
      const div = document.createElement('div');
      div.className = 'dynamic-circle';
      div.style.cssText = `--x:${circle.x}vw;--y:${circle.y}vh;--radius:min(${circle.radius}vh, ${circle.radius}vw);--orbit-offset-x:min(${circle.orbitOffsetX}vh, ${circle.orbitOffsetX}vw);--orbit-offset-y:min(${circle.orbitOffsetY}vh, ${circle.orbitOffsetY}vw);--opacity:${circle.opacity};--duration:${circle.duration}s;--direction:${circle.direction};`;
      container.insertBefore(div, mouseCircle);
    });
    container.dataset.generated = 'true';
    }

    const maskMouseCircle = document.getElementById('mask-mouse-circle');
    if (maskMouseCircle) {
      scope.listen(document, 'mousemove', ((event: MouseEvent) => {
        maskMouseCircle.style.setProperty('--x', `${(event.clientX / window.innerWidth) * 100}vw`);
        maskMouseCircle.style.setProperty('--y', `${(event.clientY / window.innerHeight) * 100}vh`);
      }) as EventListener);
    }
  });
</script>

<style is:global lang="scss">
  .dynamic-circles-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;

    &.with-mask {
      mask-image: url('/svg/grid-decoration.svg');
      mask-size: min(10vh, 10vw);
      mask-repeat: repeat;
      -webkit-mask-image: url('/svg/grid-decoration.svg');
      -webkit-mask-size: min(10vh, 10vw);
      -webkit-mask-repeat: repeat;
    }
  }

  .dynamic-circle {
    position: absolute;
    width: calc(var(--radius) * 2);
    height: calc(var(--radius) * 2);
    border-radius: 50%;
    background: radial-gradient(circle at center, rgba(137, 146, 189, var(--opacity)) 0%, rgba(137, 146, 189, 0) 100%);
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    animation: orbit var(--duration) linear infinite;
    animation-direction: var(--direction);
    transform-origin: calc(50% + var(--orbit-offset-x)) calc(50% + var(--orbit-offset-y));

    &.mouse-circle {
      animation: none;
    }
  }

  @keyframes orbit {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }
</style>
