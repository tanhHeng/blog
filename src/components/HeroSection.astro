---
import RotatingCircles from './RotatingCircles.astro';
interface Props {
  imageSrc?: string;
  imageAlt?: string;
}

const {
  imageSrc = '/img/hero.png',
  imageAlt = 'Hero Image',
} = Astro.props;
---

<img src={imageSrc} alt={imageAlt} class="hero-image" />
<RotatingCircles />

<script is:inline>
  (() => {
    const heroImage = document.querySelector('.hero-image');
    const navbar = document.querySelector('.navbar-content');
	const root = document.documentElement;
    if (!heroImage || !navbar) return;

    function syncHeroLayout() {
      const navbarRect = navbar.getBoundingClientRect();

      root.classList.remove('home-mobile-layout');
		heroImage.classList.remove('hero-image--mobile-layout', 'hero-image--centered');
      heroImage.style.removeProperty('left');
      heroImage.style.right = '0px';
      root.style.setProperty('--hero-right-overflow', '0px');

      const baseImageRect = heroImage.getBoundingClientRect();
      const overlap = Math.max(0, navbarRect.right - baseImageRect.left);
      const rightOffset = -Math.min(100, overlap);
      heroImage.style.right = `${rightOffset}px`;

      const cssMobileLayout = getComputedStyle(root)
        .getPropertyValue('--home-mobile-layout')
        .trim() === '1';
      root.classList.toggle('home-mobile-layout', cssMobileLayout);
      heroImage.classList.toggle('hero-image--mobile-layout', cssMobileLayout);

      if (cssMobileLayout) {
        const mobileImageRect = heroImage.getBoundingClientRect();
        const fitsViewport = mobileImageRect.width <= innerWidth;
		heroImage.classList.toggle('hero-image--centered', !fitsViewport);
        heroImage.style.removeProperty('right');
        root.style.setProperty('--hero-right-overflow', '0px');
        root.style.setProperty('--hero-left-edge', `${mobileImageRect.left}px`);
        return;
      }

      const desktopImageRect = heroImage.getBoundingClientRect();
      root.style.setProperty('--hero-right-overflow', `${-rightOffset}px`);
      root.style.setProperty('--hero-left-edge', `${desktopImageRect.left}px`);
    }

	window.addEventListener('load', syncHeroLayout, { once: true });

	window.addEventListener('resize', syncHeroLayout);
	navbar.addEventListener('transitionend', syncHeroLayout);
	heroImage.addEventListener('load', syncHeroLayout, { once: true });
	syncHeroLayout();
  })();
</script>

<style lang="scss">
@use '../styles/global.scss' as *;

.hero-image {
  position: fixed;
  right: 0;
  top: 0;
  height: 100vh;
}


.hero-image--mobile-layout {
  left: auto;
  right: 0;
  width: auto;
  height: 100dvh;
  object-fit: contain;
  object-position: right center;
  opacity: 0.18;
  transform: none;
}

.hero-image--mobile-layout.hero-image--centered {
  left: 50%;
  right: auto;
  width: 100vw;
  object-fit: cover;
  object-position: 72% center;
  transform: translateX(-50%);
}

@media (max-width: 900px) {
  .hero-image {
    left: auto;
    right: 0;
    width: auto;
    height: 100dvh;
    object-fit: contain;
    object-position: right center;
    opacity: 0.18;
    transform: none;
  }

}
</style>
