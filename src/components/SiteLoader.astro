---
import LoadingDots from './LoadingDots.astro';
---

<!-- Shown only on the first full page load of a browser session: this runs before anything paints and marks the
document; `siteLoader.ts` then drives the dots and removes the mark. ClientRouter re-runs it after each swap,
when the session flag makes it a no-op. The timeout unmarks the page should the bundled script never run. -->
<script is:inline>
  (() => {
    try {
      if (sessionStorage.getItem('site-loaded') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      sessionStorage.setItem('site-loaded', '1');
      document.documentElement.setAttribute('data-site-loading', '');
      setTimeout(() => document.documentElement.removeAttribute('data-site-loading'), 12000);
    } catch {}
  })();
</script>
<div class="site-loader" data-site-loader role="progressbar" aria-label="Loading">
  <LoadingDots />
</div>

<script>
  import '../lib/siteLoader';
</script>

<style lang="scss">
  @use '../styles/global.scss' as *;

  .site-loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    background: #fff;
  }

  // The root background also paints the scrollbar gutter, which the fixed loader cannot cover (the novel page
  // keeps a stable gutter over its night body).
  :global(html[data-site-loading]) {
    background: #fff;

    .site-loader {
      display: flex;
    }
  }
</style>
