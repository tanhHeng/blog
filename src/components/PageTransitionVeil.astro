---
import LoadingDots from './LoadingDots.astro';
import type { PageTransitionVariant } from '../lib/pageTransitions';

interface Props {
  /** The current route's variant: the one a full page load enters through. */
  variant: PageTransitionVariant | 'plain';
}

const { variant } = Astro.props;
---

<!-- Full page loads enter through the veil: this runs before anything paints and marks the document, which
shows the veil complete over everything; `transitionCoordinator.ts` plays the rest and removes the mark.
ClientRouter re-runs it after each swap, when the finished document makes it a no-op. The timeout unmarks
the page should the bundled script never run. -->
<script is:inline>
  (() => {
    if (document.readyState !== 'loading' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.documentElement.setAttribute('data-page-entering', '');
    setTimeout(() => document.documentElement.removeAttribute('data-page-entering'), 12000);
  })();
</script>
<div class="page-veil" data-transition-veil data-phase="idle" data-variant={variant} data-direction="forward" transition:persist="page-transition-veil" transition:name="page-veil" transition:animate="none" aria-hidden="true">
  <div class="veil-home">
    <span class="veil-ring"></span>
    <span class="veil-ring"></span>
    <span class="veil-ring"></span>
    <div class="veil-stack">
      <p class="veil-kicker" data-veil-kicker></p>
      <p class="veil-signature"><span data-veil-line></span><span data-veil-line></span></p>
      <LoadingDots class="veil-dots" />
    </div>
  </div>
  <div class="veil-article">
    <span class="veil-edge"></span>
    <div class="veil-stack veil-band">
      <p class="veil-kicker" data-veil-kicker></p>
      <p class="veil-numeral" data-veil-numeral></p>
      <p class="veil-caption" data-veil-caption></p>
      <LoadingDots class="veil-dots" />
    </div>
  </div>
  <div class="veil-novel">
    <div class="veil-stack veil-verse">
      <p class="veil-line" data-veil-line></p>
      <p class="veil-line" data-veil-line></p>
      <LoadingDots class="veil-dots" size="small" />
    </div>
  </div>
  <div class="veil-plain">
    <div class="veil-stack">
      <LoadingDots />
    </div>
  </div>
</div>

<style lang="scss">
  @use '../styles/global.scss' as *;

  // Every veil animation (cover, text entrances, dots, rings) runs in `transitionCoordinator.ts` through the
  // Web Animations API: the persisted veil is re-inserted at swap, which would restart CSS animations.

  .page-veil {
    position: fixed;
    inset: 0;
    z-index: 5;
    overflow: hidden;
    background: #fff;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .page-veil[data-phase='covering'],
  .page-veil[data-phase='revealing'] {
    visibility: visible;
  }

  // A full page load's entry: the veil complete, above every other layer (the navbar included), and taking
  // the pointer so nothing under it is reached. The root background also paints the scrollbar gutter, which
  // the fixed veil cannot cover (the novel page keeps a stable gutter over its night body).
  :global(html[data-page-entering]) {
    background: #fff;

    .page-veil {
      z-index: 100;
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }
  }

  .veil-home,
  .veil-article,
  .veil-novel,
  .veil-plain {
    position: absolute;
    inset: 0;
    display: none;
    overflow: hidden;
  }

  .page-veil[data-variant='home'] .veil-home,
  .page-veil[data-variant='article'] .veil-article,
  .page-veil[data-variant='novel'] .veil-novel,
  .page-veil[data-variant='plain'] .veil-plain {
    display: block;
  }

  // Each variant's text and its one group of dots, centred together.
  .veil-stack {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(40rem, 88vw);
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .veil-kicker {
    margin: 0;
    color: $light-blue;
    font-family: $font-family-heading;
    font-size: 0.9rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  // The loading dots (`LoadingDots.astro`) sit below the text; the coordinator grows them in and pulses them
  // only while the next page is still loading.
  .veil-dots {
    margin-top: 1.75rem;
  }

  // Home: a white circle grows from the centre; the brand and signature sit in it. The reveal opens a hole
  // from the centre (the coordinator grows `--veil-hole`) with the rings rippling just ahead of its edge.
  .veil-home {
    background: #fff;
  }

  .page-veil[data-phase='revealing'][data-variant='home'] {
    mask: radial-gradient(circle at 50% 50%, transparent var(--veil-hole), #000 calc(var(--veil-hole) + 1px));
  }

  .veil-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border: 1.5px solid $primary-blue;
    border-radius: 50%;
    transform: translate(-50%, -50%);

    &:nth-child(2) {
      border-color: $light-blue;
    }

    &:nth-child(3) {
      border-color: $ex-light-blue;
    }
  }

  // One colour, like the homepage coda signature, and always on one line: the slogan measures about 8.25em
  // (Italianno, gap included), so `10vw` keeps it inside the stack's `88vw` on narrow screens.
  .veil-signature {
    display: flex;
    justify-content: center;
    gap: 0.15em;
    margin: 0.6rem 0 0;
    color: $primary-blue;
    font-family: $font-family-special;
    font-size: min(4.5rem, 10vw);
    line-height: 1;
    white-space: nowrap;
  }

  // Article: a directional wipe carrying the archive/title text.
  .veil-article {
    background: #fff;
  }

  .veil-edge {
    position: absolute;
    right: 0;
    left: 0;
    top: 0;
    height: 1px;
    background: $primary-blue;
    box-shadow: 0 0 1.2rem rgba($primary-blue, 0.24);
  }

  .veil-numeral {
    margin: 0.4rem 0 0;
    color: $content-color;
    font-family: $font-family-heading;
    font-size: clamp(3rem, 8vw, 6rem);
    letter-spacing: 0.06em;
    line-height: 1.1;
    white-space: nowrap;

    :global(span) {
      display: inline-block;
    }
  }

  .veil-caption {
    margin: 0.75rem 0 0;
    color: $primary-blue;
    font-family: $font-family-default;
    font-size: 1rem;
    letter-spacing: 0.12em;
  }

  // Novel: white mist and the tagline, with the dots as its small closing rule.
  .veil-novel {
    background: radial-gradient(ellipse 60% 55% at 50% 48%, #fff 0%, $mist 70%);
  }

  .veil-verse {
    gap: 0.5rem;

    .veil-dots {
      margin-top: 1.25rem;
    }
  }

  .veil-line {
    margin: 0;
    color: $content-color;
    font-family: $font-family-default;
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    letter-spacing: 0.18em;

    & + & {
      color: $primary-blue;
    }
  }
</style>

<style is:global>
  /* Registered so the coordinator can animate the home reveal's hole radius with the Web Animations API. */
  @property --veil-hole {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
</style>
