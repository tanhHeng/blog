<div class="page-veil" data-transition-veil data-phase="idle" data-variant="home" data-direction="forward" transition:persist="page-transition-veil" transition:name="page-veil" transition:animate="none" aria-hidden="true">
  <div class="veil-home" aria-hidden="true">
    <span class="veil-ring"></span>
    <span class="veil-ring"></span>
    <span class="veil-ring"></span>
    <span class="veil-dots"><span></span><span></span><span></span></span>
  </div>
  <div class="veil-article">
    <span class="veil-edge"></span>
    <div class="veil-band">
      <p class="veil-kicker" data-veil-kicker></p>
      <p class="veil-numeral" data-veil-numeral></p>
      <p class="veil-caption" data-veil-caption></p>
    </div>
  </div>
  <div class="veil-novel">
    <div class="veil-verse">
      <p class="veil-line" data-veil-line="0"></p>
      <p class="veil-line" data-veil-line="1"></p>
      <div class="veil-rule"><span></span><span></span><span></span></div>
    </div>
  </div>
</div>

<style lang="scss">
  @use '../styles/global.scss' as *;

  $ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  $ease-out: cubic-bezier(0.22, 1, 0.36, 1);

  .page-veil {
    position: fixed;
    inset: 0;
    z-index: 5;
    overflow: hidden;
    background: #fff;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .page-veil[data-phase='covering'],
  .page-veil[data-phase='revealing'] {
    visibility: visible;
  }

  .veil-home,
  .veil-article,
  .veil-novel {
    position: absolute;
    inset: 0;
    display: none;
    overflow: hidden;
  }

  .page-veil[data-variant='home'] .veil-home,
  .page-veil[data-variant='article'] .veil-article,
  .page-veil[data-variant='novel'] .veil-novel {
    display: block;
  }

  .veil-home {
    background: #fff;
  }

  .veil-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border: 1.5px solid $primary-blue;
    border-radius: 50%;
    transform: translate(-50%, -50%);

    &:nth-child(2) {
      border-color: $light-blue;
    }

    &:nth-child(3) {
      border-color: $ex-light-blue;
    }
  }

  .page-veil[data-phase='covering'][data-variant='home'] .veil-ring {
    animation: veil-ring-grow 900ms $ease-in-out both;
  }

  // Home arrival: the page itself opens through the root `vt-iris`; the veil is transparent and only
  // carries rings riding the iris edge (same 200ms delay, 1100ms, 75vmax radius) and the brand dots.
  .page-veil[data-phase='iris'] {
    visibility: visible;
    opacity: 1;
    background: transparent;

    .veil-home {
      background: transparent;
    }

    .veil-ring {
      animation:
        veil-ring-grow 1100ms $ease-in-out 200ms both,
        veil-fade-late 1100ms linear 200ms both;

      &:nth-child(2) {
        animation-delay: 290ms;
      }

      &:nth-child(3) {
        animation-delay: 380ms;
      }
    }

    .veil-dots span {
      animation: veil-dot 760ms $ease-out both;
    }
  }

  @keyframes veil-fade-late {
    0%,
    75% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .veil-dots {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    gap: 0.85rem;
    transform: translate(-50%, -50%);

    span {
      width: 0.85rem;
      height: 0.85rem;
      border-radius: 50%;
      background: $ex-light-blue;
      animation: none;

      &:nth-child(2) {
        background: $light-blue;
        animation-delay: 70ms;
      }

      &:nth-child(3) {
        background: $primary-blue;
        animation-delay: 140ms;
      }
    }
  }

  .veil-article {
    background: #fff;

  }

  .veil-edge {
    position: absolute;
    right: 0;
    left: 0;
    top: 0;
    height: 1px;
    background: $primary-blue;
    box-shadow: 0 0 1.2rem rgba($primary-blue, 0.24);

    &::before,
    &::after {
      position: absolute;
      top: 50%;
      width: 0.45rem;
      height: 0.45rem;
      box-sizing: border-box;
      border: 1px solid $primary-blue;
      background: #fff;
      content: '';
      transform: translateY(-50%) rotate(45deg);
    }

    &::before {
      left: 2rem;
    }

    &::after {
      right: 2rem;
    }
  }

  .veil-band {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(40rem, 84vw);
    text-align: center;
    transform: translate(-50%, -50%);
    animation: none;
  }

  .page-veil[data-phase='covering'] .veil-dots span {
    animation: veil-dot 760ms $ease-out both;
  }

  .page-veil[data-phase='covering'] .veil-band {
    animation: veil-band 1300ms ease both;
  }

  .veil-numeral :global(span) {
    display: inline-block;
  }

  .veil-kicker,
  .veil-caption {
    margin: 0;
    font-family: $font-family-heading;
  }

  .veil-kicker {
    color: $light-blue;
    font-size: 0.9rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .veil-numeral {
    margin: 0.4rem 0 0;
    color: $content-color;
    font-family: $font-family-heading;
    font-size: clamp(3rem, 8vw, 6rem);
    letter-spacing: 0.06em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .veil-caption {
    margin-top: 0.75rem;
    color: $primary-blue;
    font-family: $font-family-default;
    font-size: 1rem;
    letter-spacing: 0.12em;
  }

  .veil-novel {
    background: radial-gradient(ellipse 60% 55% at 50% 48%, #fff 0%, $mist 70%);
  }

  .veil-verse {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: min(40rem, 88vw);
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .veil-line {
    margin: 0;
    color: $content-color;
    font-family: $font-family-default;
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    letter-spacing: 0.18em;

    & + & {
      color: $primary-blue;
    }
  }

  .veil-rule {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.25rem;

    span {
      width: 0.6rem;
      height: 0.6rem;
      border-radius: 50%;
      background: $ex-light-blue;

      &:nth-child(2) {
        background: $light-blue;
      }

      &:nth-child(3) {
        background: $primary-blue;
      }
    }
  }

  .page-veil[data-phase='covering'][data-variant='novel'] .veil-line {
    animation: veil-line 900ms ease both;
  }

  .page-veil[data-phase='covering'][data-variant='novel'] .veil-line + .veil-line {
    animation-delay: 160ms;
  }

  .page-veil[data-phase='covering'][data-variant='novel'] .veil-rule span {
    animation: veil-dot 900ms $ease-out 180ms both;
  }

  .page-veil[data-phase='covering'][data-variant='novel'] .veil-rule span:nth-child(2) {
    animation-delay: 260ms;
  }

  .page-veil[data-phase='covering'][data-variant='novel'] .veil-rule span:nth-child(3) {
    animation-delay: 340ms;
  }

  @keyframes veil-ring-grow {
    to {
      width: 150vmax;
      height: 150vmax;
    }
  }

  @keyframes veil-dot {
    0% {
      opacity: 0;
      transform: scale(0);
    }
    35%,
    60% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  @keyframes veil-band {
    0% {
      opacity: 0;
      filter: blur(6px);
    }
    22%,
    52% {
      opacity: 1;
      filter: blur(0);
      transform: translate(-50%, -50%);
    }
    74%,
    100% {
      opacity: 0;
      filter: blur(6px);
      transform: translate(-50%, calc(-50% - 1.5rem));
    }
  }

  @keyframes veil-line {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-veil * {
      animation-duration: 1ms !important;
    }
  }
</style>

<style is:global>
  /* Root keyframes referenced by `homeRootTransition` in `lib/pageTransitions.ts`. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    mix-blend-mode: normal;
  }

  @keyframes vt-recede {
    to {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @keyframes vt-iris {
    from {
      clip-path: circle(0 at 50% 50%);
    }
    to {
      clip-path: circle(75vmax at 50% 50%);
    }
  }
</style>