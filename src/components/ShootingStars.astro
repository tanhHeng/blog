---
// Shooting stars over the site background, drawn on the `DynamicCircles` mask grid: every few seconds a star
// enters from beyond the top or left edge and falls down one of the grid's `\` diagonals from intersection to
// intersection, gathering speed as it goes and its tail lengthening with it; each intersection it crosses
// flashes a faint tick, and where it burns out, inside the viewport, a small ring opens with that
// intersection's grid coordinate, as `GridMarks` labels it. Now and then a second star follows on a
// neighbouring diagonal.
---

<div class="shooting-stars" id="shooting-stars" transition:persist="shooting-stars" aria-hidden="true"></div>

<script>
  import { onPageLoad } from '../lib/pageLifecycle';

  // Seconds between stars: the first comes `FIRST` after a page loads, later ones `NEXT` apart.
  const FIRST = [1.5, 3.5];
  const NEXT = [2.5, 6];
  // Grid steps one star runs from its entry, and its average milliseconds per step. The entry is one step
  // outside the viewport and the burn-out at least one intersection inside it, so on the shorter axis, which is
  // always 10 tiles, a run fits at most 9 steps.
  const STEPS = [5, 9];
  const STEP_TIME = 160;
  // The star covers `progress ** ACCEL` of its run after `progress` of its time, so it starts slow and ends at
  // `ACCEL` times its average speed.
  const ACCEL = 2;
  const FALL_EASING = `linear(${Array.from({ length: 25 }, (_, index) => ((index / 24) ** ACCEL).toFixed(4)).join(', ')})`;
  // Fraction of the fall's time at which the star reaches `distance` (0–1) of its run.
  const timeAt = (distance: number) => distance ** (1 / ACCEL);
  // Chance that a second star follows on the next diagonal over, `PAIR_DELAY` ms later.
  const PAIR_CHANCE = 0.18;
  const PAIR_DELAY = 260;

  const between = ([min, max]: number[]) => min + Math.random() * (max - min);
  const span = (className: string) => {
    const element = document.createElement('span');
    element.className = className;
    return element;
  };

  onPageLoad((scope) => {
    const layer = document.getElementById('shooting-stars');
    if (!layer) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Same tile as the `DynamicCircles` mask (`min(10vh, 10vw)` from the viewport corner): the tile's cross
    // meets at its centre, and its diagonal runs corner to corner through that centre, so a diagonal links
    // the intersections `(column + 0.5, row + 0.5)` tile by tile.
    const launch = (column: number, row: number, steps: number, labelled: boolean) => {
      const size = Math.min(window.innerWidth, window.innerHeight) * 0.1;
      const at = (step: number) => ({ x: (column + step + 0.5) * size, y: (row + step + 0.5) * size });
      const start = at(0);
      const duration = steps * STEP_TIME;
      const finished: Promise<unknown>[] = [];
      const parts: Element[] = [];

      const star = span('star');
      star.style.left = `${start.x}px`;
      star.style.top = `${start.y}px`;
      star.style.setProperty('--tail', `${size * 2.8 * Math.SQRT2}px`);
      const tail = star.appendChild(span('star-tail'));
      const head = star.appendChild(span('star-head'));
      layer.append(star);
      parts.push(star);
      // The star itself goes as soon as it has burnt out: without a fill, it would show again at its start
      // while the ring and label still play.
      const falling = Promise.allSettled([
        star.animate(
          [{ transform: 'translateX(0)' }, { transform: `translateX(${steps * size * Math.SQRT2}px)` }],
          { duration, easing: FALL_EASING },
        ).finished,
        // The tail grows with the speed, which rises linearly in time, then shrinks as the star burns out.
        tail.animate(
          [
            { scale: '0.05 1', opacity: 0 },
            { scale: '0.3 1', opacity: 1, offset: 0.3 },
            { scale: '1 1', opacity: 1, offset: 0.85 },
            { scale: '0.2 1', opacity: 0 },
          ],
          { duration },
        ).finished,
        head.animate(
          [
            { opacity: 0, scale: '0.4' },
            { opacity: 0.85, scale: '1', offset: 0.2 },
            { opacity: 0.85, scale: '1', offset: 0.9 },
            { opacity: 0, scale: '0.3' },
          ],
          { duration },
        ).finished,
      ]).then(() => star.remove());
      finished.push(falling);

      // Ticks light up as the head crosses each intersection and fade behind it.
      for (let step = 1; step < steps; step++) {
        const point = at(step);
        const spark = span('star-spark');
        spark.style.left = `${point.x}px`;
        spark.style.top = `${point.y}px`;
        layer.append(spark);
        parts.push(spark);
        finished.push(spark.animate(
          [{ opacity: 0, scale: '0.3' }, { opacity: 0.45, scale: '1', offset: 0.12 }, { opacity: 0, scale: '1' }],
          { duration: 1100, delay: duration * timeAt(step / steps), easing: 'ease-out', fill: 'backwards' },
        ).finished);
      }

      if (labelled) {
        const end = at(steps);
        const ring = span('star-ring');
        const label = span('star-label');
        for (const element of [ring, label]) {
          element.style.left = `${end.x}px`;
          element.style.top = `${end.y}px`;
          layer.append(element);
          parts.push(element);
        }
        ring.style.setProperty('--tile', `${size}px`);
        label.textContent = `${String(column + steps + 1).padStart(2, '0')} · ${String(row + steps + 1).padStart(2, '0')}`;
        const delay = duration * 0.95;
        finished.push(
          ring.animate(
            [{ opacity: 0.6, scale: '0.1' }, { opacity: 0, scale: '1' }],
            { duration: 1100, delay, easing: 'cubic-bezier(0.2, 0.7, 0.3, 1)', fill: 'backwards' },
          ).finished,
          label.animate(
            [{ opacity: 0, translate: '0 3px' }, { opacity: 0.7, translate: '0 0', offset: 0.2 }, { opacity: 0.7, offset: 0.6 }, { opacity: 0 }],
            { duration: 2000, delay, easing: 'ease-out', fill: 'backwards' },
          ).finished,
        );
      }

      // A star still running when the page changes finishes on the persisted layer, then goes.
      Promise.allSettled(finished).then(() => {
        for (const part of parts) part.remove();
      });
    };

    // Every star starts at an entry intersection just outside the viewport, one step above the top edge or left
    // of the left edge, so it flies in rather than appearing mid-screen, and its run of `steps` ends at least one
    // intersection in from the bottom and right edges, so its ring and label always show. Entries are drawn
    // uniformly from all that fit, so a long edge sends more stars than a short one.
    const spawn = () => {
      const size = Math.min(window.innerWidth, window.innerHeight) * 0.1;
      // Intersections inside the viewport along each axis are indices 0 .. count - 1. The shorter axis always
      // has 10 (the tile is a tenth of it); the epsilon keeps float error from dropping one.
      const columns = Math.floor(window.innerWidth / size + 1e-6);
      const rows = Math.floor(window.innerHeight / size + 1e-6);
      const steps = Math.min(Math.round(between(STEPS)), columns - 1, rows - 1);
      // Above the top edge (row -1) or left of the left edge (column -1); the last index keeps the end at
      // `count - 2` or less.
      const entries: [number, number][] = [];
      for (let column = -1; column + steps <= columns - 2; column++) entries.push([column, -1]);
      for (let row = 0; row + steps <= rows - 2; row++) entries.push([-1, row]);
      if (entries.length === 0) return;
      const [column, row] = entries[Math.floor(Math.random() * entries.length)];
      launch(column, row, steps, true);
      // The follower enters two intersections further along the same edge, on the diagonal two over, and runs
      // two steps less, so it too starts outside and ends inside.
      if (Math.random() < PAIR_CHANCE) {
        const [followColumn, followRow] = row === -1 ? [column + 2, row] : [column, row + 2];
        scope.timeout(() => launch(followColumn, followRow, steps - 2, false), PAIR_DELAY);
      }
    };

    const schedule = (range: number[]) => {
      scope.timeout(() => {
        const showing =
          document.visibilityState === 'visible' &&
          !reducedMotion.matches &&
          !document.documentElement.hasAttribute('data-page-entering') &&
          getComputedStyle(layer).display !== 'none';
        if (showing) spawn();
        schedule(NEXT);
      }, between(range) * 1000);
    };
    schedule(FIRST);
  });
</script>

<style lang="scss">
  @use '../styles/global.scss' as *;

  .shooting-stars {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
  }

  .shooting-stars > :global(*) {
    position: absolute;
  }

  // A zero-size anchor at the head, turned onto the grid's diagonal; the head moves along its x axis.
  .shooting-stars :global(.star) {
    width: 0;
    height: 0;
    rotate: 45deg;
  }

  .shooting-stars :global(.star-tail) {
    position: absolute;
    top: -0.5px;
    right: 0;
    width: var(--tail);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba($primary-blue, 0.08) 45%, rgba($primary-blue, 0.55));
    transform-origin: right;
  }

  // Square on the turned anchor, so it shows as the diamond `GridMarks` marks its intersection with.
  .shooting-stars :global(.star-head) {
    position: absolute;
    width: 4px;
    height: 4px;
    background: $primary-blue;
    box-shadow: 0 0 0 1.5px rgba($ex-light-blue, 0.8), 0 0 6px 2px rgba($light-blue, 0.45);
    translate: -50% -50%;
  }

  .shooting-stars :global(.star-spark) {
    width: 9px;
    height: 9px;
    opacity: 0;
    translate: -50% -50%;

    &::before,
    &::after {
      position: absolute;
      background: $light-blue;
      content: '';
    }

    &::before {
      top: 4px;
      left: 0;
      width: 9px;
      height: 1px;
    }

    &::after {
      top: 0;
      left: 4px;
      width: 1px;
      height: 9px;
    }
  }

  .shooting-stars :global(.star-ring) {
    width: calc(var(--tile) * 1.2);
    height: calc(var(--tile) * 1.2);
    border: 1px solid rgba($primary-blue, 0.3);
    border-radius: 50%;
    opacity: 0;
    translate: -50% -50%;
  }

  .shooting-stars :global(.star-label) {
    margin: 0.45rem 0 0 0.6rem;
    color: $light-blue;
    font-family: $font-family-heading;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    white-space: nowrap;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .shooting-stars {
      display: none;
    }
  }
</style>
