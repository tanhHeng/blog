---
// Shooting stars over the site background, drawn on the `DynamicCircles` mask grid: every few seconds a star
// enters from beyond the top or left edge and falls down one of the grid's `\` diagonals from intersection to
// intersection, gathering speed as it goes and its tail lengthening with it. It carries a ring that
// swells with the distance covered; each intersection it crosses flashes a faint tick. Where it burns out,
// inside the viewport, the ring bursts: it blows out and fades, four shards fly out along the grid's row and
// column and tick on the neighbouring intersections, a ring follows, and the intersection's grid coordinate
// shows, as `GridMarks` labels it. Now and then a second star follows on a neighbouring diagonal.
---

<div class="shooting-stars" id="shooting-stars" transition:persist="shooting-stars" aria-hidden="true"></div>

<script>
  import { onPageLoad } from '../lib/pageLifecycle';
  import { pointsAtContent } from '../scripts/pointerContent';

  // Seconds between stars: the first comes `FIRST` after a page loads, later ones `NEXT` apart.
  const FIRST = [1.5, 3.5];
  const NEXT = [2.5, 6];
  // Grid steps one star runs from its entry, and its average milliseconds per step. The entry is one step
  // outside the viewport and the burn-out at least one intersection inside it, so on the shorter axis, which is
  // always 10 tiles, a run fits at most 9 steps.
  const STEPS = [5, 9];
  const STEP_TIME = 160;
  // The star covers `progress ** ACCEL` of its run after `progress` of its time, so it starts slow and ends at
  // `ACCEL` times its average speed.
  const ACCEL = 2;
  const FALL_EASING = `linear(${Array.from({ length: 25 }, (_, index) => ((index / 24) ** ACCEL).toFixed(4)).join(', ')})`;
  // Diameter of the circle a star carries when it bursts, and the burst's final diameter, in tiles.
  const CARRY = 0.55;
  const BURST = 1.6;
  // Fraction of the fall's time at which the star reaches `distance` (0–1) of its run.
  const timeAt = (distance: number) => distance ** (1 / ACCEL);
  // Chance that a second star follows on the next diagonal over, `PAIR_DELAY` seconds later.
  const PAIR_CHANCE = 0.18;
  const PAIR_DELAY = [0.75, 1.5];
  // Chance that a star passes through instead of burning out: it crosses the viewport and leaves it past the
  // bottom or right edge, without a burst. It runs at least `PASS_MIN` steps.
  const PASS_CHANCE = 0.25;
  const PASS_MIN = 5;
  // A click on the blank page (one that triggers nothing) summons a star with chance `SUMMON_BASE`, rising by
  // `SUMMON_STEP` with every blank click that summoned none, so a few in a row always bring one; a summon
  // starts the count over. Kept across page navigations.
  const SUMMON_BASE = 0.1;
  const SUMMON_STEP = 0.15;
  let missedSummons = 0;
  // Pieces of debris scattered around the pointer by a summoning click, a whole number in this range.
  const DEBRIS = [4, 7];

  // How a star's run ends: it bursts, with or without its grid coordinate, or it passes out of view.
  type Ending = 'labelled' | 'burst' | 'pass';

  const between = ([min, max]: number[]) => min + Math.random() * (max - min);
  const span = (className: string) => {
    const element = document.createElement('span');
    element.className = className;
    return element;
  };

  onPageLoad((scope) => {
    const layer = document.getElementById('shooting-stars');
    if (!layer) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Same tile as the `DynamicCircles` mask (`min(10vh, 10vw)` from the viewport corner): the tile's cross
    // meets at its centre, and its diagonal runs corner to corner through that centre, so a diagonal links
    // the intersections `(column + 0.5, row + 0.5)` tile by tile.
    const launch = (column: number, row: number, steps: number, ending: Ending) => {
      const size = Math.min(window.innerWidth, window.innerHeight) * 0.1;
      const at = (step: number) => ({ x: (column + step + 0.5) * size, y: (row + step + 0.5) * size });
      const start = at(0);
      const duration = steps * STEP_TIME;
      const finished: Promise<unknown>[] = [];
      const parts: Element[] = [];

      const star = span('star');
      star.style.left = `${start.x}px`;
      star.style.top = `${start.y}px`;
      star.style.setProperty('--tail', `${size * 2.8 * Math.SQRT2}px`);
      star.style.setProperty('--carry', `${size * CARRY}px`);
      const tail = star.appendChild(span('star-tail'));
      const carry = star.appendChild(span('star-carry'));
      const head = star.appendChild(span('star-head'));
      layer.append(star);
      parts.push(star);
      // The star itself goes the moment it bursts: without a fill, it would show again at its start while the
      // burst plays.
      const falling = Promise.allSettled([
        star.animate(
          [{ transform: 'translateX(0)' }, { transform: `translateX(${steps * size * Math.SQRT2}px)` }],
          { duration, easing: FALL_EASING },
        ).finished,
        // The tail grows with the speed, which rises linearly in time, and draws into the head at the burst.
        tail.animate(
          [
            { scale: '0.05 1', opacity: 0 },
            { scale: '0.3 1', opacity: 1, offset: 0.3 },
            { scale: '1 1', opacity: 1, offset: 0.85 },
            { scale: '0.2 1', opacity: 0 },
          ],
          { duration },
        ).finished,
        // The carried circle swells with the distance covered, so it grows fastest just before the burst.
        carry.animate(
          [{ scale: '0.12', opacity: 0 }, { scale: '0.3', opacity: 1, offset: 0.25 }, { scale: '1', opacity: 1 }],
          { duration, easing: FALL_EASING },
        ).finished,
        head.animate(
          [{ opacity: 0, scale: '0.4' }, { opacity: 0.6, scale: '1', offset: 0.2 }, { opacity: 0.7, scale: '1.1' }],
          { duration },
        ).finished,
      ]).then(() => star.remove());
      finished.push(falling);

      // Ticks light up as the head crosses each intersection and fade behind it.
      const tick = (x: number, y: number, delay: number, peak: number) => {
        const spark = place(span('star-spark'), x, y);
        finished.push(spark.animate(
          [{ opacity: 0, scale: '0.3' }, { opacity: peak, scale: '1', offset: 0.12 }, { opacity: 0, scale: '1' }],
          { duration: 1100, delay, easing: 'ease-out', fill: 'backwards' },
        ).finished);
      };
      const place = <T extends HTMLElement>(element: T, x: number, y: number) => {
        element.style.left = `${x}px`;
        element.style.top = `${y}px`;
        layer.append(element);
        parts.push(element);
        return element;
      };
      for (let step = 1; step < steps; step++) {
        const point = at(step);
        tick(point.x, point.y, duration * timeAt(step / steps), 0.35);
      }

      // A star that passes out of view goes with nothing more; the rest burst.
      if (ending === 'pass') {
        Promise.allSettled(finished).then(() => {
          for (const part of parts) part.remove();
        });
        return;
      }

      // The burst, where the star burns out: the carried ring blows out and fades, four shards fly out along the
      // grid's row and column onto the neighbouring intersections, which tick as they arrive, and a thin ring
      // follows it out.
      const end = at(steps);
      const burst = place(span('star-burst'), end.x, end.y);
      burst.style.setProperty('--carry', `${size * CARRY}px`);
      const ring = place(span('star-ring'), end.x, end.y);
      ring.style.setProperty('--tile', `${size}px`);
      // The burst circle and ring start visible, so they take no backwards fill: their CSS keeps them hidden
      // until the star arrives.
      const outward = 'cubic-bezier(0.15, 0.7, 0.3, 1)';
      finished.push(
        burst.animate(
          [{ scale: '1', opacity: 1 }, { scale: `${BURST / CARRY}`, opacity: 0 }],
          { duration: 900, delay: duration, easing: outward },
        ).finished,
        ring.animate(
          [{ opacity: 0.35, scale: '0.3' }, { opacity: 0, scale: '1' }],
          { duration: 1200, delay: duration + 80, easing: outward },
        ).finished,
      );
      for (let index = 0; index < 4; index++) {
        const angle = (index * Math.PI) / 2;
        const dx = Math.round(Math.cos(angle)) * size;
        const dy = Math.round(Math.sin(angle)) * size;
        const shard = place(span('star-shard'), end.x, end.y);
        finished.push(shard.animate(
          [
            { transform: 'translate(0, 0) rotate(45deg) scale(1.1)', opacity: 0 },
            { opacity: 0.55, offset: 0.08 },
            { transform: `translate(${dx}px, ${dy}px) rotate(45deg) scale(0.4)`, opacity: 0 },
          ],
          { duration: 760, delay: duration, easing: outward, fill: 'backwards' },
        ).finished);
        tick(end.x + dx, end.y + dy, duration + 260, 0.35);
      }

      if (ending === 'labelled') {
        const label = place(span('star-label'), end.x, end.y);
        label.textContent = `${String(column + steps + 1).padStart(2, '0')} · ${String(row + steps + 1).padStart(2, '0')}`;
        finished.push(label.animate(
          [{ opacity: 0, translate: '0 3px' }, { opacity: 0.55, translate: '0 0', offset: 0.2 }, { opacity: 0.55, offset: 0.6 }, { opacity: 0 }],
          { duration: 2000, delay: duration + 120, easing: 'ease-out', fill: 'backwards' },
        ).finished);
      }

      // A star still running when the page changes finishes on the persisted layer, then goes.
      Promise.allSettled(finished).then(() => {
        for (const part of parts) part.remove();
      });
    };

    // Every star starts at an entry intersection just outside the viewport, one step above the top edge or left
    // of the left edge, so it flies in rather than appearing mid-screen. A bursting star's run of `steps` ends at
    // least one intersection in from the bottom and right edges, so its burst and label always show; a passing
    // star runs on until it, its tail's head end, and its carried ring are past the bottom or right edge.
    // Entries are drawn uniformly from all that fit, so a long edge sends more stars than a short one.
    const spawn = () => {
      const size = Math.min(window.innerWidth, window.innerHeight) * 0.1;
      // Intersections inside the viewport along each axis are indices 0 .. count - 1. The shorter axis always
      // has 10 (the tile is a tenth of it); the epsilon keeps float error from dropping one.
      const columns = Math.floor(window.innerWidth / size + 1e-6);
      const rows = Math.floor(window.innerHeight / size + 1e-6);

      if (Math.random() < PASS_CHANCE) {
        // The first step whose intersection lies a full tile past an edge, so the ring is out of view too.
        const exit = (index: number, extent: number) => Math.ceil((extent + size) / size - 0.5 - index);
        const passes: [number, number, number][] = [];
        const add = (column: number, row: number) => {
          const steps = Math.min(exit(column, window.innerWidth), exit(row, window.innerHeight));
          if (steps >= PASS_MIN) passes.push([column, row, steps]);
        };
        for (let column = -1; column < columns; column++) add(column, -1);
        for (let row = 0; row < rows; row++) add(-1, row);
        if (passes.length > 0) {
          const [column, row, steps] = passes[Math.floor(Math.random() * passes.length)];
          launch(column, row, steps, 'pass');
          return;
        }
      }

      const steps = Math.min(Math.round(between(STEPS)), columns - 1, rows - 1);
      // Above the top edge (row -1) or left of the left edge (column -1); the last index keeps the end at
      // `count - 2` or less.
      const entries: [number, number][] = [];
      for (let column = -1; column + steps <= columns - 2; column++) entries.push([column, -1]);
      for (let row = 0; row + steps <= rows - 2; row++) entries.push([-1, row]);
      if (entries.length === 0) return;
      const [column, row] = entries[Math.floor(Math.random() * entries.length)];
      launch(column, row, steps, 'labelled');
      // The follower enters two intersections further along the same edge, on the diagonal two over, and runs
      // two steps less, so it too starts outside and ends inside.
      if (Math.random() < PAIR_CHANCE) {
        const [followColumn, followRow] = row === -1 ? [column + 2, row] : [column, row + 2];
        scope.timeout(() => launch(followColumn, followRow, steps - 2, 'burst'), between(PAIR_DELAY) * 1000);
      }
    };

    const showing = () =>
      document.visibilityState === 'visible' &&
      !reducedMotion.matches &&
      !document.documentElement.hasAttribute('data-page-entering') &&
      getComputedStyle(layer).display !== 'none';

    const schedule = (range: number[]) => {
      scope.timeout(() => {
        if (showing()) spawn();
        schedule(NEXT);
      }, between(range) * 1000);
    };
    schedule(FIRST);

    // Debris bursting out around the pointer when a click summons a star: 4–7 thin diamonds of mixed lengths and
    // blues fly out in all directions to 0.3–0.9 tiles, each pointing along its flight and turning a little as it
    // slows, and fade.
    const scatter = (x: number, y: number) => {
      const size = Math.min(window.innerWidth, window.innerHeight) * 0.1;
      const count = Math.floor(between([DEBRIS[0], DEBRIS[1] + 1]));
      for (let index = 0; index < count; index++) {
        const angle = ((index + Math.random() * 0.8) / count) * Math.PI * 2;
        const heading = (angle * 180) / Math.PI;
        const reach = size * between([0.3, 0.9]);
        const turn = between([15, 60]) * (Math.random() < 0.5 ? -1 : 1);
        const piece = span('star-debris');
        piece.style.left = `${x}px`;
        piece.style.top = `${y}px`;
        piece.style.setProperty('--length', `${between([9, 15]).toFixed(1)}px`);
        if (Math.random() < 0.4) piece.classList.add('is-light');
        layer.append(piece);
        // The flight starts at about three times its average speed and eases out; the fade runs on its own linear
        // clock, so the pieces stay visible while they slow down instead of fading with the flight's quick start.
        const duration = between([600, 1000]);
        piece.animate(
          [
            { transform: `translate(0, 0) rotate(${heading}deg) scale(1)` },
            { transform: `translate(${Math.cos(angle) * reach}px, ${Math.sin(angle) * reach}px) rotate(${heading + turn}deg) scale(0.55)` },
          ],
          { duration, easing: 'cubic-bezier(0.2, 0.6, 0.35, 1)' },
        );
        piece.animate(
          [{ opacity: 0 }, { opacity: 0.75, offset: 0.05 }, { opacity: 0.6, offset: 0.55 }, { opacity: 0 }],
          { duration },
        ).finished.finally(() => piece.remove());
      }
    };

    // A summoned star flies in along the diagonal through the grid intersection nearest the click, entering just
    // beyond the top or left edge, and bursts there, where `GridMarks` rings the same intersection; debris
    // bursts out around the pointer as it is summoned.
    scope.listen(document, 'click', (event: MouseEvent) => {
      if (event.defaultPrevented || event.button !== 0 || !showing()) return;
      if (pointsAtContent(event.target, event.clientX, event.clientY)) return;
      if (Math.random() >= SUMMON_BASE + SUMMON_STEP * missedSummons) {
        missedSummons += 1;
        return;
      }
      missedSummons = 0;
      scatter(event.clientX, event.clientY);
      const size = Math.min(window.innerWidth, window.innerHeight) * 0.1;
      const column = Math.round(event.clientX / size - 0.5);
      const row = Math.round(event.clientY / size - 0.5);
      const steps = Math.min(column, row) + 1;
      launch(column - steps, row - steps, steps, 'labelled');
    });
  });
</script>

<style lang="scss">
  @use '../styles/global.scss' as *;

  .shooting-stars {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
  }

  .shooting-stars > :global(*) {
    position: absolute;
  }

  // A zero-size anchor at the head, turned onto the grid's diagonal; the head moves along its x axis.
  .shooting-stars :global(.star) {
    width: 0;
    height: 0;
    rotate: 45deg;
  }

  .shooting-stars :global(.star-tail) {
    position: absolute;
    top: -0.5px;
    right: 0;
    width: var(--tail);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba($primary-blue, 0.06) 45%, rgba($primary-blue, 0.4));
    transform-origin: right;
  }

  // Debris from a summoning click: thin diamonds, `--length` long and a quarter as wide, laid along their flight
  // (their x axis), some in the lighter blue.
  .shooting-stars :global(.star-debris) {
    width: var(--length);
    height: calc(var(--length) * 0.28);
    clip-path: polygon(0 50%, 50% 0, 100% 50%, 50% 100%);
    background: $primary-blue;
    opacity: 0;
    translate: -50% -50%;

    &:global(.is-light) {
      background: $light-blue;
    }
  }

  // Square on the turned anchor, so it shows as the diamond `GridMarks` marks its intersection with.
  .shooting-stars :global(.star-head) {
    position: absolute;
    width: 4px;
    height: 4px;
    background: $primary-blue;
    box-shadow: 0 0 0 1.5px rgba($ex-light-blue, 0.6), 0 0 5px 1px rgba($light-blue, 0.3);
    translate: -50% -50%;
  }

  // The carried circle and its burst are bare rings, without fill.
  .shooting-stars :global(:is(.star-carry, .star-burst)) {
    position: absolute;
    width: var(--carry);
    height: var(--carry);
    box-sizing: border-box;
    border: 1px solid rgba($primary-blue, 0.35);
    border-radius: 50%;
    translate: -50% -50%;
  }

  .shooting-stars :global(.star-burst) {
    opacity: 0;
  }

  // A diamond like the head; it turns through its animated `transform`, after the move, so it flies straight.
  .shooting-stars :global(.star-shard) {
    width: 2.5px;
    height: 2.5px;
    background: $primary-blue;
    opacity: 0;
    translate: -50% -50%;
  }

  .shooting-stars :global(.star-spark) {
    width: 9px;
    height: 9px;
    opacity: 0;
    translate: -50% -50%;

    &::before,
    &::after {
      position: absolute;
      background: $light-blue;
      content: '';
    }

    &::before {
      top: 4px;
      left: 0;
      width: 9px;
      height: 1px;
    }

    &::after {
      top: 0;
      left: 4px;
      width: 1px;
      height: 9px;
    }
  }

  .shooting-stars :global(.star-ring) {
    width: calc(var(--tile) * 2.2);
    height: calc(var(--tile) * 2.2);
    border: 1px solid rgba($primary-blue, 0.25);
    border-radius: 50%;
    opacity: 0;
    translate: -50% -50%;
  }

  .shooting-stars :global(.star-label) {
    margin: 0.45rem 0 0 0.6rem;
    color: $light-blue;
    font-family: $font-family-heading;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    white-space: nowrap;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .shooting-stars {
      display: none;
    }
  }
</style>
