---
// Mouse-following circle component
---

<div class="mouse-circle" id="mouse-circle" transition:persist="mouse-circle" hidden aria-hidden="true" style="--x: 50vw; --y: 50vh"></div>

<script>
  import { onPageLoad } from '../lib/pageLifecycle';

  onPageLoad((scope) => {
    const mouseCircle = document.getElementById('mouse-circle');
    if (!mouseCircle) return;
    const coarsePointer = window.matchMedia('(pointer: coarse)');
    const narrowViewport = window.matchMedia('(max-width: 900px)');
    const isMobileDevice = () => coarsePointer.matches || narrowViewport.matches || navigator.maxTouchPoints > 0;
    const hideMouseCircle = () => {
      mouseCircle.hidden = true;
      mouseCircle.setAttribute('aria-hidden', 'true');
    };
    const showMouseCircle = () => {
      if (!isMobileDevice() && document.hasFocus()) {
        mouseCircle.hidden = false;
        mouseCircle.setAttribute('aria-hidden', 'false');
      }
    };
    const updateMouseCircle = (event: MouseEvent) => {
      if (isMobileDevice() || !document.hasFocus()) {
        hideMouseCircle();
        return;
      }
      mouseCircle.style.setProperty('--x', `${(event.clientX / window.innerWidth) * 100}vw`);
      mouseCircle.style.setProperty('--y', `${(event.clientY / window.innerHeight) * 100}vh`);
      showMouseCircle();
    };
    scope.listen(document, 'mousemove', updateMouseCircle as EventListener);
    scope.listen(document, 'mouseleave', hideMouseCircle);
    scope.listen(window, 'blur', hideMouseCircle);
    scope.listen(document, 'visibilitychange', () => {
      if (document.visibilityState !== 'visible') hideMouseCircle();
    });
    scope.listen(coarsePointer, 'change', hideMouseCircle);
    scope.listen(narrowViewport, 'change', hideMouseCircle);
    scope.listen(window, 'resize', () => {
      if (isMobileDevice()) hideMouseCircle();
    });
    scope.cleanup(hideMouseCircle);
  });
</script>

<style lang="scss">
  @use '../styles/global.scss' as *;

  .mouse-circle {
    position: fixed;
    left: var(--x);
    top: var(--y);
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background-color: rgba($light-blue, 0.25);
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 9999;
    transition: left top 0.1s ease-out, top 0.1s ease-out;
  }
</style>

