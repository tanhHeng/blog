---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;
const visibleHeadings = headings.filter(({ depth }) => depth >= 2 && depth <= 4);
---

<details class="article-contents" data-article-contents open>
  <summary class="contents-heading">
    <span class="contents-marker" aria-hidden="true"></span>
    <span class="contents-label">目录</span>
    <span class="contents-kicker" aria-hidden="true">Contents</span>
  </summary>
  <div class="contents-scrim" data-contents-close aria-hidden="true"></div>
  <div class="contents-body">
    <div class="contents-body-inner">
      <header class="contents-sheet-header">
        <div>
          <p class="sheet-kicker" aria-hidden="true">Contents</p>
          <p class="sheet-title">目录</p>
        </div>
        <button class="contents-close" type="button" data-contents-close aria-label="关闭目录"></button>
      </header>
      <nav aria-label="文章目录">
        <ol>
          {visibleHeadings.map((heading) => (
            <li class:list={['toc-item', `level-${heading.depth}`]}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
      <p class="contents-progress">
        <span>Read</span>
        <span data-contents-percent>0%</span>
      </p>
    </div>
  </div>
</details>

<script>
  import { onPageLoad } from '../lib/pageLifecycle';

  onPageLoad((scope) => {
    const contents = document.querySelector<HTMLDetailsElement>('[data-article-contents]');
    const article = document.querySelector<HTMLElement>('.article-body');
    const list = contents?.querySelector('ol');
    if (!contents || !article || !list) return;

    if (list.children.length === 0) {
      article.querySelectorAll('h2, h3, h4').forEach((heading) => {
        if (!heading.id) return;
        const item = document.createElement('li');
        item.className = `toc-item level-${heading.tagName.slice(1)}`;
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent;
        item.append(link);
        list.append(item);
      });
    }

    if (list.children.length === 0) {
      contents.hidden = true;
      return;
    }

    const summary = contents.querySelector('summary');
    const percent = contents.querySelector('[data-contents-percent]');
    const entries = Array.from(list.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')).flatMap((link) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      const item = link.parentElement;
      return heading && item ? [{ heading, item, link }] : [];
    });
    let current: (typeof entries)[number] | undefined;
    let frame = 0;
    let closeTimer = 0;

    // The fill is measured in pixels from the current item's box, so it is re-measured whenever that box
    // can move: on a new current item, on resize, once web fonts arrive (they rewrap the items), and when
    // the mobile sheet opens (while the sheet is closed its items are not laid out, and a measure taken
    // then is stale once it opens).
    const syncFill = () => {
      const fill = current ? current.item.offsetTop + current.item.offsetHeight / 2 : 0;
      list.style.setProperty('--contents-fill', `${fill}px`);
    };
    const setCurrent = (next: typeof current) => {
      if (next === current) return;
      current?.item.classList.remove('is-current');
      current?.link.removeAttribute('aria-current');
      current = next;
      current?.item.classList.add('is-current');
      current?.link.setAttribute('aria-current', 'location');
      syncFill();
    };

    const update = () => {
      frame = 0;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(Math.max(window.scrollY / scrollable, 0), 1) : 1;
      if (percent) percent.textContent = `${Math.round(progress * 100)}%`;
      const readingLine = window.innerHeight * 0.3;
      let next: typeof current;
      for (const entry of entries) {
        if (entry.heading.getBoundingClientRect().top > readingLine) break;
        next = entry;
      }
      if (progress >= 0.995 && entries.length > 0) next = entries[entries.length - 1];
      setCurrent(next);
    };

    const requestUpdate = () => {
      if (!frame) frame = scope.frame(update);
    };
    const expand = () => {
      scope.clearTimeout(closeTimer);
      contents.open = true;
      syncFill();
      scope.frame(() => contents.setAttribute('data-expanded', ''));
    };
    const collapse = () => {
      if (!contents.hasAttribute('data-expanded')) return;
      scope.clearTimeout(closeTimer);
      contents.removeAttribute('data-expanded');
      closeTimer = scope.timeout(() => { contents.open = false; }, 320);
    };
    const mobileQuery = window.matchMedia('(max-width: 850px)');
    const syncMode = () => {
      scope.clearTimeout(closeTimer);
      if (mobileQuery.matches) {
        contents.removeAttribute('data-expanded');
        contents.open = false;
      } else {
        contents.open = true;
        contents.setAttribute('data-expanded', '');
        syncFill();
      }
    };

    scope.listen(window, 'scroll', requestUpdate, { passive: true });
    scope.listen(window, 'resize', () => {
      syncFill();
      requestUpdate();
    });
    scope.listen(document.fonts, 'loadingdone', syncFill);
    scope.listen(contents, 'click', ((event: MouseEvent) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('summary')) {
        event.preventDefault();
        if (contents.hasAttribute('data-expanded')) collapse();
        else expand();
      } else if (event.target.closest('[data-contents-close]')) {
        collapse();
        summary?.focus();
      } else if (mobileQuery.matches && event.target.closest('a')) collapse();
    }) as EventListener);
    scope.listen(document, 'pointerdown', ((event: PointerEvent) => {
      if (mobileQuery.matches && event.target instanceof Node && !contents.contains(event.target)) collapse();
    }) as EventListener);
    scope.listen(document, 'focusin', ((event: FocusEvent) => {
      if (mobileQuery.matches && event.target instanceof Node && !contents.contains(event.target)) collapse();
    }) as EventListener);
    scope.listen(document, 'keydown', ((event: KeyboardEvent) => {
      if (event.key === 'Escape' && mobileQuery.matches && contents.hasAttribute('data-expanded')) {
        collapse();
        summary?.focus();
      }
    }) as EventListener);
    scope.listen(mobileQuery, 'change', syncMode);
    scope.cleanup(() => list.style.removeProperty('--contents-fill'));
    update();
    syncMode();
  });
</script>

<style scoped lang="scss">
@use '../styles/global.scss' as *;

$contents-top: 10.4rem;
$ease-out: cubic-bezier(0.22, 1, 0.36, 1);
// Rail geometry: list items sit `$list-inset` from the list edge; the rail runs at `$rail-x`.
$list-inset: 1.15rem;
$rail-x: 0.35rem;
$rail-offset: $rail-x - $list-inset;

.article-contents {
  position: fixed;
  top: $contents-top;
  z-index: 2;
  width: 11rem;
  box-sizing: border-box;
  color: $light-blue;
  font-family: $font-family-default;
  font-size: 0.8rem;
  overflow-wrap: anywhere;
}

.contents-heading {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  cursor: pointer;
  list-style: none;
  white-space: nowrap;
  color: $primary-blue;
  font-size: 0.95rem;
  letter-spacing: 0.12em;

  &::marker {
    content: '';
  }

  &::-webkit-details-marker {
    display: none;
  }

  &:focus-visible {
    outline: 1px solid rgba($primary-blue, 0.6);
    outline-offset: 0.3rem;
  }
}

.contents-kicker {
  margin-left: auto;
  color: $light-blue;
  font-family: $font-family-heading;
  font-size: 0.66rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.contents-marker {
  flex: 0 0 auto;
  display: inline-block;
  width: 0.45rem;
  height: 0.45rem;
  border: 1px solid $primary-blue;
  background: #fff;
  transform: rotate(45deg);
  transition: transform 240ms $ease-out, background-color 180ms ease-out;
}

.contents-heading:hover .contents-marker {
  background-color: $ex-light-blue;
}

.article-contents[data-expanded] .contents-marker {
  transform: rotate(135deg);
  background-color: $ex-light-blue;
}

.contents-scrim,
.contents-sheet-header {
  display: none;
}

.contents-body {
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transition: grid-template-rows 240ms ease, opacity 180ms ease;
}

.contents-body-inner {
  min-height: 0;
  overflow: hidden;
}

.article-contents[data-expanded] .contents-body {
  grid-template-rows: 1fr;
  opacity: 1;
}

nav {
  max-height: calc(100dvh - #{$contents-top} - 6rem);
  margin-top: 0.85rem;
  overflow: hidden auto;
  overscroll-behavior: contain;
  scrollbar-width: none;

  &::-webkit-scrollbar {
    display: none;
  }
}

ol {
  --contents-fill: 0px;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin: 0;
  padding: 0.1rem 0.45rem 0.1rem $list-inset;
  list-style: none;
  counter-reset: toc-section;

  &::before,
  &::after {
    position: absolute;
    top: 0;
    left: $rail-x;
    width: 1px;
    content: '';
  }

  &::before {
    bottom: 0;
    background: rgba($primary-blue, 0.32);
  }

  &::after {
    height: var(--contents-fill);
    // Never past the end of the rail, whatever the measure.
    max-height: 100%;
    background: $primary-blue;
    transition: height 280ms $ease-out;
  }
}

// Items are also created by the client fallback, so item rules must reach unscoped markup.
.article-contents :global(.toc-item) {
  position: relative;
  line-height: 1.45;
}

.article-contents :global(.toc-item.level-2) {
  color: $primary-blue;
  font-size: 0.82rem;
  letter-spacing: 0.04em;
  counter-increment: toc-section;

  &:not(:first-child) {
    margin-top: 0.4rem;
  }

  &::before {
    position: absolute;
    top: 0.725em;
    left: $rail-offset;
    width: 0.55rem;
    height: 1px;
    background: rgba($primary-blue, 0.6);
    content: '';
  }
}

.article-contents :global(.toc-item.level-3) {
  padding-left: 1.55rem;
  font-size: 0.74rem;
}

.article-contents :global(.toc-item.level-4) {
  padding-left: 2.2rem;
  color: rgba($light-blue, 0.85);
  font-size: 0.68rem;
}

.article-contents :global(.toc-item.is-current)::after {
  position: absolute;
  top: 0.725em;
  left: calc(#{$rail-offset} + 0.5px);
  z-index: 1;
  width: 0.42rem;
  height: 0.42rem;
  box-sizing: border-box;
  border: 1px solid $primary-blue;
  background: #fff;
  content: '';
  transform: translate(-50%, -50%) rotate(45deg);
}

.article-contents :global(.toc-item a),
.article-contents :global(.toc-item a:link),
.article-contents :global(.toc-item a:visited) {
  display: grid;
  align-items: baseline;
  color: inherit;
  font: inherit;
  text-decoration: none;
  overflow-wrap: anywhere;
  transition: color 180ms ease-out, transform 180ms ease-out;
}

.article-contents :global(.toc-item.level-2 a) {
  grid-template-columns: 1.55rem minmax(0, 1fr);
}

.article-contents :global(.toc-item.level-2 a)::before {
  color: $light-blue;
  font-family: $font-family-heading;
  font-size: 0.66rem;
  letter-spacing: 0.06em;
  content: counter(toc-section, decimal-leading-zero);
}

.article-contents :global(.toc-item a:hover),
.article-contents :global(.toc-item a:focus-visible) {
  color: $primary-blue;
  outline: none;
  transform: translateX(0.2rem);
}

.article-contents :global(.toc-item.is-current a) {
  color: $content-color;
  transform: translateX(0.2rem);
}

.article-contents :global(.toc-item.is-current a)::before {
  color: $primary-blue;
}

.contents-progress {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0.95rem 0 0;
  padding-top: 0.55rem;
  border-top: 1px solid rgba($primary-blue, 0.25);
  color: $light-blue;
  font-family: $font-family-heading;
  font-size: 0.66rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;

  [data-contents-percent] {
    color: $primary-blue;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }
}

@media (max-width: 850px) {
  .article-contents {
    top: 10rem;
    right: calc(var(--reading-shell-gutter, 1rem) - 1rem);
    width: 2rem;
    font-size: 0.85rem;
  }

  // Collapsed tab sits on the article card's right border, matching `.design/clipping-edge-contents.png`.
  .contents-heading {
    position: relative;
    z-index: 2;
    justify-content: center;
    width: 2rem;
    min-height: 4.75rem;
    gap: 0.4rem;
    padding: 0.55rem 0;
    box-sizing: border-box;
    background: #fff;
    color: $light-blue;
    letter-spacing: 0.18em;
    writing-mode: vertical-rl;
  }

  .contents-kicker {
    display: none;
  }

  .contents-marker {
    width: 0.38rem;
    height: 0.38rem;
  }

  .contents-scrim {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: block;
    background: rgba(#fff, 0.55);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 240ms ease;
  }

  .article-contents[data-expanded] .contents-scrim {
    opacity: 1;
  }

  .contents-body {
    position: fixed;
    right: var(--reading-shell-gutter, 1rem);
    bottom: calc(1rem + env(safe-area-inset-bottom));
    left: var(--reading-shell-gutter, 1rem);
    z-index: 1;
    display: flex;
    max-height: min(72dvh, 36rem);
    padding: 1.15rem 1.25rem 1rem;
    box-sizing: border-box;
    border: 1px solid rgba($primary-blue, 0.78);
    background: rgba(#fff, 0.98);
    box-shadow: 0 1rem 2.5rem rgba($primary-blue, 0.14);
    opacity: 1;
    transform: translateY(calc(100% + 2rem));
    transition: transform 320ms $ease-out;
  }

  .article-contents[data-expanded] .contents-body {
    transform: translateY(0);
  }

  .contents-body-inner {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
  }

  .contents-sheet-header {
    display: flex;
    flex: 0 0 auto;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba($primary-blue, 0.35);
  }

  .sheet-kicker {
    margin: 0;
    color: $light-blue;
    font-family: $font-family-heading;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .sheet-title {
    position: relative;
    margin: 0.35rem 0 0;
    padding-left: 0.85rem;
    color: $content-color;
    font-size: 1.35rem;
    letter-spacing: 0.12em;
    line-height: 1.2;

    &::before {
      position: absolute;
      top: 0.08em;
      left: 0;
      width: 0.4rem;
      height: 1.1em;
      background: $ex-light-blue;
      content: '';
    }
  }

  .contents-close {
    position: relative;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid rgba($primary-blue, 0.55);
    background: #fff;
    cursor: pointer;
    transition: background-color 180ms ease-out;

    &::before,
    &::after {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0.85rem;
      height: 1px;
      background: $primary-blue;
      content: '';
    }

    &::before {
      transform: translate(-50%, -50%) rotate(45deg);
    }

    &::after {
      transform: translate(-50%, -50%) rotate(-45deg);
    }

    &:hover,
    &:focus-visible {
      background: $ex-light-blue;
      outline: none;
    }
  }

  nav {
    flex: 1 1 auto;
    min-height: 0;
    max-height: none;
    margin-top: 0.9rem;
  }

  ol {
    gap: 0.7rem;
  }

  .article-contents :global(.toc-item.level-2) {
    font-size: 0.95rem;
  }

  .article-contents :global(.toc-item.level-3) {
    padding-left: 1.85rem;
    font-size: 0.85rem;
  }

  .article-contents :global(.toc-item.level-4) {
    padding-left: 2.6rem;
    font-size: 0.78rem;
  }

  .article-contents :global(.toc-item.level-2 a) {
    grid-template-columns: 1.85rem minmax(0, 1fr);
  }

  .article-contents :global(.toc-item.level-2 a)::before {
    font-size: 0.72rem;
  }

  .contents-progress {
    flex: 0 0 auto;
    margin-top: 0.85rem;
    font-size: 0.72rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .contents-marker,
  .contents-scrim,
  .contents-body,
  ol::after,
  .article-contents :global(.toc-item a) {
    transition: none;
  }
}
</style>
